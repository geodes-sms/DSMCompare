	 //***********************************************   
	 def void init(EClass Root){
 			allPathNodes    = 	new ArrayList<EClass>();	
		  	allPathEdges 	= 	new Stack<SrcRefTrgtMM>();
	 		root			=	Root;
	  		allPathNodes	=	DsmcHelpers.getAllNodesMM(root, true, false);
	 }
	 
	 def void getRuleNodes(){
	 	var sizeNodes = allPathNodes.size();
	 	var i=0;//i=0 is the root node, we will ignore it
	 	var j=0;
	 	var rmv = new ArrayList<EObject>();
	 	for(i=2;i<sizeNodes-1;i++){
	 		var parent 	=	allPathNodes.get(i-1); 
	 		if(!allPathNodes.get(i).eContainer().equals(parent) && !rmv.contains(parent)){
	 				rmv.add(parent);
	 		} 		
	 	}	 	
 		for(r:rmv){
 			allPathNodes.remove(r);
 		}
	 }
	 	 
	 def String defineWileLoopForRule(String ruleName){
	 		var wileLoopForRule = "while{\n\t\t\t";
		    wileLoopForRule +=ruleName+"()"
		    wileLoopForRule +="\n\t\t}";
	 }
	 
	 def void defineStarUnitForRule(String ruleName){
	 		var starUnitDefinitionForRule = "\n\t"+"unit unit"+ruleName+"Star(){\n\t\t";
		    starUnitDefinitionForRule +=defineWileLoopForRule(ruleName);
		    starUnitDefinitionForRule +="\n\t}";
		    DefinitionsStarUnits += starUnitDefinitionForRule;
	 }
	 
	 def void callStarUnitForRule(String ruleName){
	 		 callsStarUnits+= "\n\t\t"+"unit"+ruleName+"Star()";
	 }
	 
	 //***********************************************   
	 def String defineNodePost(EObject n, String actionText)
	 {	 
	 	var nodeDef="\t\t\t\t "+actionText;
	 	if(actionText == "preserve" || actionText == "forbid")
	 		nodeDef+= "\t\t\t";
	 		
	 	nodeDef += createNode(n)+":"+DsmcHelpers.getSuperClassName(n);	 	
		
		if(actionText == "preserve")
		{
			nodeDef += "{";	
	 		nodeDef += "\n\t\t\t\t\t" + "preserve	changeStatus 	= 	nPostchangeStatus";
	 		nodeDef += "\n\t\t\t\t\t" + "preserve	diff_kind_Left 	= 	nPostdiff_kind_Left";
	 		nodeDef += "\n\t\t\t\t\t" + "preserve	diff_kind_Right	= 	nPostdiff_kind_Right";
	 		nodeDef +="\n" + "\t\t\t\t}";	
	 	}	
	 		
	 	return nodeDef;	 	
	 }
	 
	 //***********************************************   
	 def String defineNode(EObject n, String actionText, String henshinFileType)
	 {
	 	var nodeDef="\t\t\t\t "+actionText;
	 	if(actionText == "preserve" || actionText == "forbid")
	 		nodeDef+= "\t\t\t"
	 	else
	 		nodeDef+= "\t\t\t\t"
	 	
	 	nodeDef += createNode(n)+":"+DsmcHelpers.getSuperClassName(n);
	 	
	 	var diffKindVal = "";
	 	var diffKindLeftDef= "";
	 	var diffKindRightDef= "";
	 	if(henshinFileType=="DSDiff"){
	 		diffKindVal = getStringAttrDef(n,"diff_kind");
	 		if(!diffKindVal.contains("NON")){
	 			diffKindLeftDef  = diffKindVal.replace("diff_kind","diff_kind_Left");	 
	 			diffKindRightDef  = diffKindVal.replace("diff_kind","diff_kind_Right");	
	 		}		
	 	}
	 		 	
	 	if(diffKindLeftDef != "" || diffKindRightDef !="" )
	 		{
	 		nodeDef += "{";	 		
	 		
	 		if(diffKindLeftDef!=""){
	 			nodeDef += "\n\t\t\t\t\t" + actionText + " " + diffKindLeftDef;
	 		}
	 		if(diffKindRightDef!=""){
	 			nodeDef += "\n\t\t\t\t\t" + actionText + " " + diffKindRightDef;
	 		}	 		
		 	nodeDef +="\n" + "\t\t\t\t}";	 	
	 	}
	 	
	 	return nodeDef;
	 } 
	 
	 def String getStringAttrDef(EObject n, String attrName)
	 {
	 	var attr= DsmcHelpers.getEAttributeByName(n,attrName);
	 	if(attr==null){
	 		return "";
	 	}	 		
	 	else{
	 		if(attr.getEAttributeType().eClass().getName().toLowerCase()=="eenum"){	
	 			var id_PatternLhs=DsmcHelpers.getAttrValueByAttrName(n,"ID_Pattern").toString();			
				return  attrName +" = " + "n" + id_PatternLhs + attrName;	 		}
	 		else{
	 			return attrName + " = " + "\"\\\"" + n.eGet(attr).toString()+ "\\\"\"";
	 		}
	 	}
	 }
	 
	 def void defineEdges(){
	  	edges= new ArrayList<String>();
	  	for(SrcRefTrgtMM ERefC: getAllAssocCollection_MM()){
	  		if(allPathNodes.contains(ERefC.source) && allPathNodes.contains(ERefC.target))
	  		{ 		 
		  		if((DsmcHelpers.getAttrValueByAttrName(ERefC.source,"ID_Pattern").toString().contains("-") == true)
		  			||  (DsmcHelpers.getAttrValueByAttrName(ERefC.target,"ID_Pattern").toString().contains("-") == true))
		  		{
		  			var AssocDef= 	
		  						"("+
		  						"create\t\t" + 
		  						createNodeNumber(ERefC.source)+
		  						"->" + 
		  						createNodeNumber(ERefC.target)+
		  						":"+
		  						ERefC.eReference.getName()+
		  						"),";
					edges.add(AssocDef);
		  		}
		  		else if(!ERefC.source.eClass().getName().toLowerCase().contains("domainspecificdiff"))
		  		{
		  			var AssocDef= 	
		  						"("+
		  						"preserve\t" + 
		  						createNodeNumber(ERefC.source)+
		  						"->" + 
		  						createNodeNumber(ERefC.target)+
		  						":"+
		  						ERefC.eReference.getName()+
		  						"),";
					edges.add(AssocDef);
		  		}
	  		}   		
		}
		if(edges.size()>0)	 
		{
	  		var s =edges.get(edges.size()-1);
	  		s= s.substring(0, s.length() - 1);
	  		edges.set(edges.size()-1,s);
		}
	  }

	 def Boolean addParamToRuleSignature(String param){
	  	if(param!=null && param!="" && !ruleSignature.contains(param)){
			if(ruleSignature!="" && ruleSignature!=null)
			 	{ ruleSignature += "," + param; }
			else 
			 	{ ruleSignature += param; }	
			return true;	
		}
		return false;	 	
	 }
	  
	 //***********************************************   
	 def String createNode(EObject n)
	 {
	 	return "node " + createNodeNumber(n);
	 }	 
	 
	 def String createNodeNumber(EObject n)
	 {
	 	return "n" + DsmcHelpers.getAttrValueByAttrName(n,"ID_Pattern").toString().replace("-","").trim();
	 }

	 //***********************************************   
	 def Stack<SrcRefTrgtMM> getAllAssocCollection_MM()
	 {	
	  	for(EClass node: allPathNodes){
	  		var nodeAssocCollection = getAllNodeAssocCollection_MM(node);
	  		if(nodeAssocCollection.size()>0){
	  			allPathEdges.addAll(nodeAssocCollection);
	  		}	  		
	  	}
	  	
	  	return allPathEdges;
	 }
	  
	 def HashSet<SrcRefTrgtMM> getAllNodeAssocCollection_MM(EClass src)
	 {
	  	var allNodeAssociations = new HashSet<SrcRefTrgtMM>();		  	
		var features = new ArrayList<EStructuralFeature>(src.getEStructuralFeatures());
		for (EStructuralFeature r : features) {
			if(r instanceof  EReference){			
				  try{
		  			var AllTargets= DsmcHelpers.getAllTargetsMM(src,r);
		  			
			  		if(AllTargets !== null && AllTargets.size()>0){
				  		for (EClass target:AllTargets){
				  			var newERef= new SrcRefTrgtMM(src,r,target);
				  			allNodeAssociations.add(newERef);
				  			var subClasses = DsmcHelpers.getAllSubClassesMM(target);
				  			for (EClass sc:subClasses){				  				
				  			var newERef2= new SrcRefTrgtMM(src,r,sc);
				  			allNodeAssociations.add(newERef2);
				  			}				  			
				  		}
			  		}
		  		}catch(Exception ex){	  			
		  		}	  		
	  		}
	  	}
	  	
	  	
	  	
	  	
	  	
	  	return allNodeAssociations;
	 }	 
}








