	def generateAllFineGrainedRules(){	  	 	
	    if(henshinFilePath!=""){
	    	//doEMFSetup	
		    var PrintWriter out = new PrintWriter(henshinFilePath); 
		    try{
			   // val resourceSet = new ResourceSetImpl
				//resourceSet.getPackageRegistry().put(MM_eNSURI, MM_eIN);
				//val resource = resourceSet.getResource(URI.createURI(mmFilePath), true)
				
				var ecoreModelFile = new File(mmFilePath);
				var resourceSet = new ResourceSetImpl();
				resourceSet.getPackageRegistry().put(EcorePackage.eNS_URI, EcorePackage.eINSTANCE);
				resourceSet.getResourceFactoryRegistry().getExtensionToFactoryMap().put("ecore", new EcoreResourceFactoryImpl());
				var resource = resourceSet.getResource(URI.createFileURI(ecoreModelFile.getAbsolutePath()), true);
				resource.load(null);
				    //var ecoreModel = (EPackage) resource.getContents().get(0);
				
				
				out.print(generatePackageImport(resource.contents.get(0) as EObject));				
				rulesDefinitionsAndCallsInSequntialStarUnit = "\n\t"+"unit unitSequntialStar(){";				
			    //val resourceSet = new ResourceSetImpl
			    //val resource = resourceSet.getResource(URI.createURI(mmFilePath), true)
				//1. Get the current Node
				//2. Calculate Path to current Node from root
				//	2.1 AllPathNodes
				//	2.2 AllPathEdges (Associations)
				//3. Create ADD/Delete rule for the Node
				//4. Create change rule for each attribute of the Node
				//5. Create ADD/DELTE for edge
			    
			    var ePackage = resource.contents.get(0) as EPackage;
			    var eClassifiers = ePackage.getEClassifiers()
			    var rootFound = false
			    for(c:eClassifiers){
			    	if(rootFound == false && c instanceof EClass){
				    	var cClass =c as EClass
				    	if(cClass.name.equals(rootClassName)){	//@@@It should be corrected
				    	//if(cClass.eClass().name=="EClass"){
				    		root = cClass
				    		rootFound = true
				    	}
			    	}
			    }
			    
			    var node = root;
			    var visitedRefs = new ArrayList<SrcRefTrgtMM>();
			    var visitedNodes = new HashSet<EClass>();
			    var Result="";
			    
			   do{
				    allPathNodes.add(node);	
				    //if not visitedNodes already contains (node)	
				    //1. out.print(generateRule(node ADD DELETE MODIFY));			    
				    //2. out.print(for each (node.getEAllAttributes() MODIFY))
				    out.print("\n"+node.getName())
					visitedNodes.add(node);	
				    var refTypes = getAllNodeAssocCollection_MM(node);
				    if(refTypes.size()>0){				    	
					    for(r:refTypes){		    				    	
					    	if(!isIn(r,visitedRefs)){
					    		stackRefTypes.push(r);					    		
					    		visitedRefs.add(r);					    		
					    	}					    	
					    }
				    }	
				    var top = stackRefTypes.peek();	
				    do{						    
				    	//3. out.print(eReference ADD DELETE))
				    	out.print("\n"+top.source.getName() + "-"+top.eReference.getName()+ "->"+top.target.getName())	
					    stackRefTypes.pop();
					    if(top!=null){
						    node = top.target;		
						    if(allPathEdges.size()>0 && allPathEdges.peek().source.equals(top.source)){
						    	allPathEdges.pop();
						    	allPathEdges.add(top);
						    }
						    else
						    	allPathEdges.add(top);	    
					    }else{//refTypes.size()==0
					    	node=null;
					    }
				    }while (visitedNodes.contains(node) && stackRefTypes.size()>0);// || (node==null && stackRefTypes.size()>0) );							    	    
			    } while(stackRefTypes.size()>0);
			    
			    //allPathNodes.clear();
			    //allPathEdges.clear();
			    rulesDefinitionsAndCallsInSequntialStarUnit += callsStarUnits;
			    rulesDefinitionsAndCallsInSequntialStarUnit += "\n\t}";
			    rulesDefinitionsAndCallsInSequntialStarUnit += DefinitionsStarUnits;
			    out.print(rulesDefinitionsAndCallsInSequntialStarUnit);
			    out.close; 		    
	    	}catch(Exception ex){
	    		System.out.print(ex.message); 
	    		out.close; 
	    	}		    
	    } 
	  }
	  
	 def doEMFSetup() {
		EPackage.Registry.INSTANCE.put(MM_eNSURI, MM_eIN)
