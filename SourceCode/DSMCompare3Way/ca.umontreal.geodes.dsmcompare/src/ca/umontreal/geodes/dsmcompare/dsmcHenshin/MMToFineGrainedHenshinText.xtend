		//extensionToFactoryMap.put("ecore", new EcoreResourceFactoryImpl());
	  }
	  
	  def boolean isIn(SrcRefTrgtMM r,ArrayList<SrcRefTrgtMM> visitedRefs){
	    	var i=0;
	    	while(i<visitedRefs.size()){
	    		var v=visitedRefs.get(i);
	    		i++;
	    		if(v.source.equals(r.source) && v.target.equals(r.target) && v.eReference.equals(r.eReference)){
    				return true;
	    		}					    			
	    	}
	    	return false;
	  }
	 
