            <codeElement xsi:type="code:Signature" name="getMinWidthThreshold">
              <parameterUnit type="/0/@model.1/@codeElement.0/@codeElement.1/@codeElement.6" kind="return">
                <source language="java">
                  <region language="java"/>
                </source>
              </parameterUnit>
              <parameterUnit name="column" type="/0/@model.1/@codeElement.134" kind="unknown">
