                <comment text="// Find any identity assignments and just remove them"/>
                <comment text="// exports = module.exports;"/>
                <comment text="// Find compound identity assignments and remove the exports = portion"/>
                <comment text="// exports = module.exports = foo;"/>
                <comment text="// The default declaration for the goog.provide is a constant so"/>
                <comment text="// we need to declare the variable if we have more than one"/>
                <comment text="// assignment to module.exports or those assignments are not"/>
                <comment text="// at the top level."/>
                <comment text="//"/>
                <comment text="// If we assign to the variable more than once or all the assignments"/>
                <comment text="// are properties, initialize the variable as well."/>
                <comment text="// If all the assignments are property exports, initialize the"/>
