              <codeElement xsi:type="action:BlockUnit">
                <source language="java">
                  <region file="/0/@model.2/@inventoryElement.2" language="java"/>
                </source>
                <comment text="// For object literal assignments to module.exports, convert them to"/>
                <comment text="// individual property assignments."/>
                <comment text="//"/>
                <comment text="//     module.exports = { foo: bar};"/>
                <comment text="//"/>
                <comment text="// becomes"/>
                <comment text="//"/>
                <comment text="//     module.exports = {};"/>
                <comment text="//     module.exports.foo = bar;"/>
                <comment text="// If this is an assignment to module.exports or exports, renaming"/>
                <comment text="// has already handled this case. Remove the export."/>
                <comment text="// If the exported name is not found and this is a direct assignment"/>
                <comment text="// to modules.exports, look to see if the module name has a var definition"/>
                <comment text="// Rewrite &quot;module.exports = foo;&quot; to &quot;var moduleName = foo;&quot;"/>
                <comment text="// This is a where a module export assignment is used in a complex expression."/>
                <comment text="// Before: `SOME_VALUE !== undefined &amp;&amp; module.exports = SOME_VALUE`"/>
                <comment text="// After: `SOME_VALUE !== undefined &amp;&amp; module$name`"/>
                <comment text="// Other references to &quot;module.exports&quot; are just replaced with the module name."/>
                <comment text="// Other references to &quot;module.exports&quot; are just replaced with the module name."/>
              </codeElement>
