                <comment text="// only rewrite &quot;module.exports&quot; if &quot;module&quot; is a free variable,"/>
                <comment text="// meaning it is not defined in the current scope as a local"/>
                <comment text="// variable or function parameter"/>
                <comment text="// If the module.exports statement is nested in the then branch of an if statement,"/>
                <comment text="// assume the if statement is an UMD pattern with a common js export in the then branch"/>
                <comment text="// This seems fragile but has worked well for a long time."/>
                <comment text="// TODO(ChadKillingsworth): Discover if there is a better way to detect these."/>
                <comment text="// If a define.amd statement is nested in the then branch of an if statement,"/>
                <comment text="// assume the if statement is an UMD pattern with a common js export"/>
