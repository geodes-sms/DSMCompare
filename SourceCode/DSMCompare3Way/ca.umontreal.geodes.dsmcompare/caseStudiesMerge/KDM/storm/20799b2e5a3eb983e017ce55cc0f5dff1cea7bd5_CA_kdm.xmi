                <source language="java">
                  <region file="/0/@model.2/@inventoryElement.0" language="java"/>
                </source>
                <comment text="// Because we are using TCP (which is a connection-oriented transport unlike UDP), a connection is only fully"/>
                <comment text="// established iff the channel is connected.  That is, a TCP-based channel must be in the CONNECTED state before"/>
                <comment text="// anything can be read or written to the channel."/>
