          <codeElement xsi:type="code:StorableUnit" name="MAX_CONNECTIONS_PER_HOST" type="/0/@model.1/@codeElement.3" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="/**&#xD;&#xA;     * Maximum pooled connections per host.&#xD;&#xA;     * &lt;p/>&#xD;&#xA;     */"/>
