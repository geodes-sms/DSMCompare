          <codeElement xsi:type="code:MethodUnit" name="AstyanaxStoreManager" type="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.24/@codeElement.0" kind="constructor">
            <attribute tag="export" value="public"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <codeElement xsi:type="code:Signature" name="AstyanaxStoreManager">
              <parameterUnit name="config" type="/0/@model.1/@codeElement.272" kind="unknown">
                <source language="java">
                  <region file="/0/@model.2/@inventoryElement.0" language="java"/>
                </source>
              </parameterUnit>
              <parameterUnit type="/0/@model.1/@codeElement.266" kind="throws">
                <source language="java">
                  <region language="java"/>
                </source>
              </parameterUnit>
            </codeElement>
            <codeElement xsi:type="action:BlockUnit">
              <source language="java">
                <region file="/0/@model.2/@inventoryElement.0" language="java"/>
              </source>
              <codeElement xsi:type="action:ActionElement" name="super constructor invocation" kind="super constructor invocation">
                <source language="java">
                  <region file="/0/@model.2/@inventoryElement.0" language="java"/>
                </source>
                <actionRelation xsi:type="action:Calls" to="/0/@model.1/@codeElement.0/@codeElement.0/@codeElement.6/@codeElement.0" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.24/@codeElement.1/@codeElement.0"/>
              </codeElement>
              <codeElement xsi:type="action:ActionElement" name="if" kind="if">
                <source language="java">
                  <region file="/0/@model.2/@inventoryElement.0" language="java"/>
                </source>
                <comment text="// Check if we have non-default thrift frame size or max message size set and warn users"/>
                <comment text="// because there is nothing we can do in Astyanax to apply those, warning is good enough here"/>
                <comment text="// otherwise it would make bad user experience if we don't warn at all or crash on this."/>
                <codeElement xsi:type="action:ActionElement" name="method invocation" kind="method invocation">
                  <source language="java">
                    <region file="/0/@model.2/@inventoryElement.0" language="java"/>
                  </source>
                  <actionRelation xsi:type="action:Calls" to="/0/@model.1/@codeElement.117" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.24/@codeElement.1/@codeElement.1/@codeElement.0"/>
                </codeElement>
