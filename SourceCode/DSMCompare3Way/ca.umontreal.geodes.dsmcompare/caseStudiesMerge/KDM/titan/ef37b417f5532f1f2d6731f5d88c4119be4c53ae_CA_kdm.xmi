            </source>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="retryPolicy" type="/0/@model.1/@codeElement.1189">
            <attribute tag="export" value="private final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.2" language="java"/>
