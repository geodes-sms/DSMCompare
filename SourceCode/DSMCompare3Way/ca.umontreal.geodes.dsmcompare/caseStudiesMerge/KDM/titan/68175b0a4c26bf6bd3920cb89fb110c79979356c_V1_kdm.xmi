        <codeElement xsi:type="code:ClassUnit" name="GraphDatabaseConfiguration" isAbstract="false">
          <attribute tag="export" value="public"/>
          <source language="java">
            <region file="/0/@model.2/@inventoryElement.0" language="java"/>
          </source>
          <comment text="/**&#xA; * Provides functionality to configure a {@link com.thinkaurelius.titan.core.TitanGraph} INSTANCE.&#xA; * &lt;p/>&#xA; * &lt;p/>&#xA; * A graph database configuration is uniquely associated with a graph database and must not be used for multiple&#xA; * databases.&#xA; * &lt;p/>&#xA; * After a graph database has been initialized with respect to a configuration, some parameters of graph database&#xA; * configuration may no longer be modifiable.&#xA; *&#xA; * @author Matthias Br&amp;ouml;cheler (me@matthiasb.com);&#xA; */"/>
          <comment text="//    static PropertiesConfiguration getPropertiesConfig(String file) {"/>
          <comment text="//        PropertiesConfiguration config = new PropertiesConfiguration();"/>
          <comment text="//        if (existsFile(file)) {"/>
          <comment text="//            try {"/>
          <comment text="//                config.load(file);"/>
          <comment text="//            } catch (ConfigurationException e) {"/>
          <comment text="//                throw new IllegalArgumentException(&quot;Cannot load existing configuration file&quot;, e);"/>
          <comment text="//            }"/>
          <comment text="//        }"/>
          <comment text="//        config.setFileName(file);"/>
          <comment text="//        config.setAutoSave(true);"/>
          <comment text="//        return config;"/>
          <comment text="//    }"/>
