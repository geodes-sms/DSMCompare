            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="//    public static final String GANGLIA_INTERVAL_KEY = &quot;interval&quot;;"/>
            <comment text="/**&#xA;     * The port to which Ganglia data are sent.&#xA;     * &lt;p/>&#xA;     */"/>
            <comment text="//    public static final String GANGLIA_PORT = &quot;port&quot;;"/>
            <comment text="//    public static final int GANGLIA_PORT_DEFAULT = 8649;"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.357" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.124"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="GANGLIA_ADDRESSING_MODE" type="/0/@model.1/@codeElement.186" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="/**&#xA;     * Whether to interpret {@link #GANGLIA_HOST_OR_GROUP} as a unicast or&#xA;     * multicast address. If present, it must be either the string &quot;multicast&quot;&#xA;     * or the string &quot;unicast&quot;.&#xA;     * &lt;p/>&#xA;     */"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.358" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.125"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="GANGLIA_TTL" type="/0/@model.1/@codeElement.189" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="//    public static final String GANGLIA_ADDRESSING_MODE_KEY = &quot;addressing-mode&quot;;"/>
            <comment text="//    public static final String GANGLIA_ADDRESSING_MODE_DEFAULT = &quot;unicast&quot;;"/>
            <comment text="/**&#xA;     * The multicast TTL to set on outgoing Ganglia datagrams. This has no&#xA;     * effect when {@link #GANGLIA_ADDRESSING_MODE} is set to &quot;multicast&quot;.&#xA;     * &lt;p/>&#xA;     * This is a TTL in the multicast protocol sense (number of routed hops),&#xA;     * not a timestamp sense.&#xA;     */"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.359" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.126"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="GANGLIA_USE_PROTOCOL_31" type="/0/@model.1/@codeElement.191" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="//    public static final String GANGLIA_TTL_KEY = &quot;ttl&quot;;"/>
            <comment text="//    public static final int GANGLIA_TTL_DEFAULT = 1;"/>
            <comment text="/**&#xA;     * Whether to send data to Ganglia in the 3.1 protocol format (true) or the&#xA;     * 3.0 protocol format (false).&#xA;     * &lt;p/>&#xA;     */"/>
            <comment text="//    public static final String GANGLIA_USE_PROTOCOL_31_KEY = &quot;protocol-31&quot;;"/>
            <comment text="//    public static final boolean GANGLIA_USE_PROTOCOL_31_DEFAULT = true;"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.360" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.127"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="GANGLIA_UUID" type="/0/@model.1/@codeElement.193" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="/**&#xA;     * The host UUID to set on outgoing Ganglia datagrams. If null, no UUID is&#xA;     * set on outgoing data.&#xA;     * &lt;p/>&#xA;     * See https://github.com/ganglia/monitor-core/wiki/UUIDSources&#xA;     * &lt;p/>&#xA;     */"/>
            <comment text="//    public static final String GANGLIA_UUID_KEY = &quot;uuid&quot;;"/>
            <comment text="//    public static final UUID GANGLIA_UUID_DEFAULT = null;"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.361" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.128"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="GANGLIA_SPOOF" type="/0/@model.1/@codeElement.195" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="/**&#xA;     * If non-null, it must be a valid Gmetric spoof string formatted as an&#xA;     * IP:hostname pair. If null, Ganglia will automatically determine the IP&#xA;     * and hostname to set on outgoing datagrams.&#xA;     * &lt;p/>&#xA;     * See http://sourceforge.net/apps/trac/ganglia/wiki/gmetric_spoofing&#xA;     * &lt;p/>&#xA;     */"/>
            <comment text="//    public static final String GANGLIA_SPOOF_KEY = &quot;spoof&quot;;"/>
            <comment text="//    public static final String GANGLIA_SPOOF_DEFAULT = null;"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.362" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.129"/>
          </codeElement>
