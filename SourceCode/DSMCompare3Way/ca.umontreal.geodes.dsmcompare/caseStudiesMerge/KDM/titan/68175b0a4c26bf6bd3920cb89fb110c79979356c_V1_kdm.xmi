            <comment text="//    public static final String METRICS_SLF4J_LOGGER_DEFAULT = null;"/>
            <comment text="/**&#xA;     * The configuration namespace within {@link #METRICS_NS} for Ganglia.&#xA;     */"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.354" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.121"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="GANGLIA_HOST_OR_GROUP" type="/0/@model.1/@codeElement.180" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="/**&#xA;     * The unicast host or multicast group name to which Metrics will send&#xA;     * Ganglia data. Setting this config key has no effect unless&#xA;     * {@link #GANGLIA_INTERVAL} is also set.&#xA;     */"/>
            <comment text="//"/>
            <comment text="//    public static final String GANGLIA_HOST_OR_GROUP_KEY = &quot;hostname&quot;;"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.355" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.122"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="GANGLIA_INTERVAL" type="/0/@model.1/@codeElement.182" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="/**&#xA;     * The number of milliseconds to wait between sending Metrics data to the&#xA;     * host or group specified by {@link #GANGLIA_HOST_OR_GROUP}. This has no&#xA;     * effect unless {@link #GANGLIA_HOST_OR_GROUP} is also set.&#xA;     */"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.356" from="/0/@model.0/@codeElement.0/@codeElement.0/@codeElement.123"/>
          </codeElement>
