            <codeElement xsi:type="action:BlockUnit">
              <source language="java">
                <region file="/0/@model.2/@inventoryElement.2" language="java"/>
              </source>
              <comment text="// Object Store compute the change set between the SharedGroup versions when the query created and the latest."/>
              <comment text="// So it is possible it deliver a non-empty change set for the first async query returns."/>
              <comment text="// Happens e.g. if a synchronous query is created, a change listener is added and then"/>
              <comment text="// a transaction is started on the same thread. This will trigger all notifications"/>
              <comment text="// and deliver an empty changeset."/>
              <comment text="// Object Store compute the change set between the SharedGroup versions when the query created and the latest."/>
              <comment text="// So it is possible it deliver a non-empty change set for the first async query returns."/>
              <comment text="// Happens e.g. if a synchronous query is created, a change listener is added and then"/>
              <comment text="// a transaction is started on the same thread. This will trigger all notifications"/>
              <comment text="// and deliver an empty changeset."/>
            </codeElement>
          </codeElement>
