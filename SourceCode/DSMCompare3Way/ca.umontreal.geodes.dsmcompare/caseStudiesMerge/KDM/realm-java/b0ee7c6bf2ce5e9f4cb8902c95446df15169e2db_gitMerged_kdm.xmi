              <comment text="// Retrieve Sync settings first. We need syncRealmUrl to identify if this is a SyncConfig"/>
              <comment text="// Convert the headers into a String array to make it easier to send through JNI"/>
              <comment text="// [key1, value1, key2, value2, ...]"/>
              <comment text="//noinspection unchecked"/>
              <comment text="// Set encryption key"/>
              <comment text="// Set durability"/>
              <comment text="// Set auto update notification"/>
              <comment text="// Set schema related params."/>
              <comment text="// Compact on launch"/>
              <comment text="// Initial data transaction"/>
              <comment text="// Set sync config"/>
              <comment text="// TODO: maybe expose the option for a custom Proxy or ProxySelector in the config?"/>
              <comment text="// replace scheme in URI so that a proxy selector won't be confused by 'realm://'"/>
              <comment text="// we shouldn't ever get here if parsing the resolved url above worked"/>
              <comment text="// this should never happen"/>
              <comment text="// FIXME: enable once realm-sync adds support for SOCKS proxies"/>
            </codeElement>
