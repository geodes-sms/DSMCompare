          <codeElement xsi:type="code:MethodUnit" name="isLoaded" type="/0/@model.0/@codeElement.0/@codeElement.1/@codeElement.79/@codeElement.0">
            <attribute tag="export" value="public"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.2" language="java"/>
            </source>
            <comment text="// The Results with mode QUERY will be evaluated asynchronously in Object Store. But we do have to support &quot;sync&quot;"/>
            <comment text="// query by Java like RealmQuery.findAll()."/>
            <comment text="// The flag is used for following cases:"/>
            <comment text="// 1. When Results is created, loaded will be set to false if the mode is QUERY. For other modes, loaded will be set"/>
            <comment text="//    to true."/>
            <comment text="// 2. For sync query (RealmQuery.findAll()), load() should be called after the Results creation. Then query will be"/>
            <comment text="//    evaluated immediately and then loaded will be set to true (And the mode will be changed to TABLEVIEW in OS)."/>
            <comment text="// 3. For async query, when load() gets called with loaded not set, the listener should be triggered with empty"/>
            <comment text="//    change set since it is considered as query first returned."/>
            <comment text="// 4. If the listener triggered with empty change set after load() called for async queries, it is treated as the"/>
            <comment text="//    same case as 2)."/>
            <codeElement xsi:type="code:Signature" name="isLoaded">
              <parameterUnit type="/0/@model.0/@codeElement.2/@codeElement.4" kind="return">
                <source language="java">
                  <region language="java"/>
                </source>
              </parameterUnit>
            </codeElement>
