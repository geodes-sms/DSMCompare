              <region file="/0/@model.2/@inventoryElement.3" language="java"/>
            </source>
            <comment text="// Every OsSharedRealm instance has to be created from an OsRealmConfig instance. And the OsSharedRealm's NativeContext"/>
            <comment text="// object will be the same as the context here. This is because of we may create different OsSharedRealm instances"/>
            <comment text="// with different shared_ptrs which are point to the same SharedGroup object. It could happen when we create"/>
            <comment text="// OsSharedRealm for migration/initialization callback. The context has to be the same object for those cases for"/>
            <comment text="// core destructor's thread safety."/>
