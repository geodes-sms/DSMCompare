              <codeElement xsi:type="action:BlockUnit">
                <source language="java">
                  <region file="/0/@model.2/@inventoryElement.6" language="java"/>
                </source>
                <comment text="// If waitForInitialRemoteData() was enabled, we need to make sure that all data is downloaded"/>
                <comment text="// before proceeding. We need to open the Realm instance first to start any potential underlying"/>
                <comment text="// SyncSession so this will work."/>
                <comment text="// Manually create the Java session wrapper session as this might otherwise"/>
                <comment text="// not be created"/>
                <comment text="// Partial Realms are not supported by async open yet, so continue to"/>
                <comment text="// use the old way of opening those Realms."/>
                <comment text="// If an error happened while downloading initial data, we need to reset the file so we can"/>
                <comment text="// download it again on the next attempt."/>
                <comment text="// Fully synchronized Realms are supported by AsyncOpen"/>
                <comment text="// Primary key problem only exists before we release sync."/>
                <comment text="// Primary key problem only exists before we release sync."/>
                <comment text="// We are holding the lock, and we can set the valid configuration since there is no global ref to it."/>
                <comment text="// Throws exception if validation failed."/>
                <comment text="// Creates a new local Realm instance"/>
                <comment text="// RealmMigrationNeededException might be thrown here."/>
                <comment text="// If `waitForInitialRemoteData` data is set, we also want to ensure that all subscriptions"/>
                <comment text="// are fully ACTIVE before proceeding. Most of the Realm is initialized during a write"/>
                <comment text="// transaction. So we cannot download subscription data until all other initializers have run."/>
                <comment text="// At this point we also have access to all normal APIs as the schema is fully initialized."/>
                <comment text="// The Realm instance has been created without exceptions. Cache and reference count can be updated now."/>
                <comment text="// This is the first instance in current thread, increase the global count."/>
                <comment text="//noinspection unchecked"/>
              </codeElement>
            </codeElement>
          </codeElement>
