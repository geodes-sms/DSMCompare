          <codeElement xsi:type="code:StorableUnit" name="configuration" type="/0/@model.1/@codeElement.755">
            <attribute tag="export" value="private"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.6" language="java"/>
            </source>
            <comment text="// This will be only valid if getTotalGlobalRefCount() > 0."/>
            <comment text="// NOTE: We do reset this when globalCount reaches 0, but if exception thrown in doCreateRealmOrGetFromCache at the"/>
            <comment text="// first time when globalCount == 0, this could have a non-null value but it will be reset when the next"/>
            <comment text="// doCreateRealmOrGetFromCache is called with globalCount == 0."/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="cachesList" type="/0/@model.1/@codeElement.105" kind="static">
            <attribute tag="export" value="private final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.6" language="java"/>
            </source>
            <comment text="// Realm path will be used to identify different RealmCaches. Different Realm configurations with same path"/>
            <comment text="// are not allowed and an exception will be thrown when trying to add it to the cache list."/>
            <comment text="// A weak ref is used to hold the RealmCache instance. The weak ref entry will be cleared if and only if there"/>
            <comment text="// is no Realm instance holding a strong ref to it and there is no Realm instance associated it is BEING created."/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.359" from="/0/@model.0/@codeElement.0/@codeElement.5/@codeElement.6"/>
