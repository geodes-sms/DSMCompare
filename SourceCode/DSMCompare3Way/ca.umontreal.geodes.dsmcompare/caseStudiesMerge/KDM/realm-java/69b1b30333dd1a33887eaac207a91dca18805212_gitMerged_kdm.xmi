            <comment text="// keep a WeakReference list to RealmResults obtained asynchronously in order to update them"/>
            <comment text="// RealmQuery is not WeakReference to prevent it from being GC'd. RealmQuery should be"/>
            <comment text="// cleaned if RealmResults is cleaned. we need to keep RealmQuery because it contains the query"/>
            <comment text="// pointer (to handover for each update) + all the arguments necessary to rerun the query:"/>
            <comment text="// sorting orders, soring columns, type (findAll, findFirst, findAllSorted etc.)"/>
