<?xml version="1.0" encoding="UTF-8"?>
<pacmanCRRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pacmanCRRuleMM="http://www.zadahmad.org/dsmcompare/pacmanCRRuleMM"
    xsi:schemaLocation="http://www.zadahmad.org/dsmcompare/pacmanCRRuleMM ../metaModels/pacmanCRRuleMM.ecore"
    name="PacmanMoveConflictResolution1"
    priority="1">
  <constraints>Item(2,&quot;name&quot;) matchAnyOfValues &quot;Pacman Move Left, Pacman Move Right, Pacman Move Up, Pacman Move Down&quot;</constraints>
  <rulePattern_Pattern_SemanticObject
      xsi:type="pacmanCRRuleMM:Pattern_SemanticDiff"
      ID_Pattern="1"
      name="Pacman Move"
      author="LEFT"/>
  <rulePattern_Pattern_SemanticObject
      xsi:type="pacmanCRRuleMM:Pattern_SemanticDiff"
      ID_Pattern="2"
      name=""
      author="RIGHT"/>
  <rulePattern_Pattern_SemanticObject
      xsi:type="pacmanCRRuleMM:Pattern_SemanticConflict"
      ID_Pattern="3"
      conflict_kind="CONTRADICTING"
      conflict_Granularity="Semantic_Semantic"
      semanticdiffs="1 2"/>
  <rulePattern_Pattern_SemanticObject
      xsi:type="pacmanCRRuleMM:Pattern_ConflictResolution"
      ID_Pattern="4"
      name="Pacman Move Conflict Resolution"
      ResolutionStrategy="Keep_Right"
      semanticconflicts="3"/>
  <rulePattern_Pattern_SemanticObject
      xsi:type="pacmanCRRuleMM:Pattern_ConflictResolution"
      ID_Pattern="5"
      isForbidden="true"
      name="Pacman Move Conflict Resolution"
      ResolutionStrategy="Keep_Right"
      semanticconflicts="3"/>
</pacmanCRRuleMM:Rule>
