<?xml version="1.0" encoding="UTF-8"?>
<pacmanCRRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pacmanCRRuleMM="http://www.zadahmad.org/dsmcompare/pacmanCRRuleMM"
    xsi:schemaLocation="http://www.zadahmad.org/dsmcompare/pacmanCRRuleMM ../metaModels/pacmanCRRuleMM.ecore"
    name="KeepSemanticDifference"
    priority="2">
  <rulePattern_Pattern_SemanticObject
      xsi:type="pacmanCRRuleMM:Pattern_SemanticConflict"
      ID_Pattern="1"
      conflict_kind="CONTRADICTING"
      conflict_Granularity="Semantic_Fine"/>
  <rulePattern_Pattern_SemanticObject
      xsi:type="pacmanCRRuleMM:Pattern_ConflictResolution"
      ID_Pattern="2"
      name="Keep semantic difference"
      ResolutionStrategy="Keep_Semantic_Difference"
      semanticconflicts="1"/>
  <rulePattern_Pattern_SemanticObject
      xsi:type="pacmanCRRuleMM:Pattern_ConflictResolution"
      ID_Pattern="3"
      isForbidden="true"
      name="Keep semantic difference"
      ResolutionStrategy="Keep_Semantic_Difference"
      semanticconflicts="1"/>
</pacmanCRRuleMM:Rule>
