<?xml version="1.0" encoding="UTF-8"?>
<pacman2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pacman2WayRuleMM="http://www.zadahmad.org/dsmcompare/pacman2WayRuleMM"
    xsi:schemaLocation="http://www.zadahmad.org/dsmcompare/pacman2WayRuleMM ../metaModels/pacman2WayRuleMM.ecore#/1"
    name="PacmanMoveRight">
  <rulePattern_GridNode
      xsi:type="pacman2WayRuleMM:Pattern_GridNode"
      right="R"
      id="O"
      ID_Pattern="1"/>
  <rulePattern_GridNode
      xsi:type="pacman2WayRuleMM:Pattern_GridNode"
      id="R"
      ID_Pattern="2"/>
  <rulePattern_PositionableEntity
      xsi:type="pacman2WayRuleMM:Pattern_Pacman"
      id="P"
      ID_Pattern="3">
    <diffon
        xsi:type="pacman2WayRuleMM:Pattern_DiffPositionableEntity_on"
        diff_kind="DELETE"
        eType="O"
        ID_Pattern="4"/>
    <diffon
        xsi:type="pacman2WayRuleMM:Pattern_DiffPositionableEntity_on"
        diff_kind="MODIFY"
        eType="R"
        ID_Pattern="5"/>
  </rulePattern_PositionableEntity>
  <rulePattern_SemanticObject
      xsi:type="pacman2WayRuleMM:Pattern_SemanticDiff"
      name="Pacman Move Right"
      SemanticObject_GridNode="R O"
      SemanticObject_PositionableEntity="P"
      ID_Pattern="6"/>
  <rulePattern_SemanticObject
      xsi:type="pacman2WayRuleMM:Pattern_SemanticDiff"
      name="Pacman Move Right"
      SemanticObject_GridNode="R O"
      SemanticObject_PositionableEntity="P"
      ID_Pattern="7"
      isForbidden="true"/>
</pacman2WayRuleMM:Rule>
