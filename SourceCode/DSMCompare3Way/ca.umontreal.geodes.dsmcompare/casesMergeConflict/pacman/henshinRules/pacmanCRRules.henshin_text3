ePackageImport  pacmanDiffMM

		rule PacmanMoveConflictResolution1(VAR n2name:EString)
		{
			graph
			{
				 preserve			node n1:SemanticDiff{
					preserve name =  "\"Pacman Move\""
					preserve author =  "\"LEFT\""
				}			      		
				 preserve			node n2:SemanticDiff{
					preserve author =  "\"RIGHT\""
					preserve name =  n2name
				}			      		
				 preserve			node n3:SemanticConflict{
					preserve conflict_kind =  "\"CONTRADICTING\""
					preserve conflict_Granularity =  "\"Semantic_Semantic\""
				}			      		
				 create				node n4:ConflictResolution{
					create name =  "\"Pacman Move Conflict Resolution\""
					create ResolutionType =  "\"Pending\""
					create ResolutionStrategy =  "\"Keep_Right\""
				}
				 forbid			node n5:ConflictResolution{
					forbid name =  "\"Pacman Move Conflict Resolution\""
					forbid ResolutionType =  "\"Pending\""
					forbid ResolutionStrategy =  "\"Keep_Right\""
				}					
			edges[
			  		(preserve	n3->n1:semanticdiffs),
			  		(preserve	n3->n2:semanticdiffs),
			  		(create		n4->n3:semanticconflicts),
			  		(forbid		n5->n3:semanticconflicts)
	      		 ]
			}
			conditions [("n2name.matches(\"Pacman Move Left|Pacman Move Right|Pacman Move Up|Pacman Move Down\")" == 'true')] 
		}
