		rule PacmanEatFood(VAR n0diff_kind_Left:EString,VAR n0diff_kind_Right:EString,VAR n3diff_kind_Left:EString,VAR n3diff_kind_Right:EString,VAR n31diff_kind_Left:EString,VAR n31diff_kind_Right:EString,VAR n0score:EInt,VAR n0new_score_Left:EInt,VAR n0new_score_Right:EInt)
		{
			graph
			{
				 preserve			node n0:DiffGame{
					preserve diff_kind_Left = n0diff_kind_Left
					preserve diff_kind_Right = n0diff_kind_Right
					preserve score =  n0score
					preserve new_score_Left =  n0new_score_Left
					preserve new_score_Right =  n0new_score_Right
				}			      		
				 preserve			node n1:GridNode			      		
				 preserve			node n2:Pacman			      		
				 preserve			node n3:DiffFood{
					preserve diff_kind_Left = n3diff_kind_Left
					preserve diff_kind_Right = n3diff_kind_Right
				}			      		
				 delete				node n31:DiffPositionableEntity_on{
					delete diff_kind_Left = n31diff_kind_Left
					delete diff_kind_Right = n31diff_kind_Right
				}
				 create				node n4:DomainSpecificDiff{
					create name = "\"Pacman Eat Food\""
				}
			edges[
			  		(preserve	n0->n1:gridnodes),
			  		(preserve	n0->n2:entities),
			  		(preserve	n0->n3:entities),
			  		(create		n0->n4:domainspecificdiffs),
			  		(preserve	n2->n1:on),
			  		(delete		n3->n31:diffon),
			  		(delete		n31->n1:eType),
			  		(create		n4->n0:DomainSpecificDiff_Game),
			  		(create		n4->n2:DomainSpecificDiff_PositionableEntity),
			  		(create		n4->n3:DomainSpecificDiff_PositionableEntity)
	      		 ]
			}
			conditions [((n0score < n0new_score_Left) AND (n0diff_kind_Left == "\"MODIFY\"") AND (n3diff_kind_Left == "\"DELETE\"") AND (n31diff_kind_Left == "\"DELETE\"")) OR ((n0score < n0new_score_Right) AND (n0diff_kind_Right == "\"MODIFY\"") AND (n3diff_kind_Right == "\"DELETE\"") AND (n31diff_kind_Right == "\"DELETE\""))] 
		}
