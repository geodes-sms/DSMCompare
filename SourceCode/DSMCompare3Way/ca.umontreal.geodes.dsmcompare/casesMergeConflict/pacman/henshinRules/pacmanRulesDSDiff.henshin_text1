		rule PacmanEatFood_equal(VAR n0score:EInt,VAR n0new_score_Left:EInt,VAR n0new_score_Right:EInt)
		{
			graph
			{
				 preserve			node n0:DiffGame{
					preserve diff_kind_Left = "\"MODIFY\""
					preserve diff_kind_Right = "\"MODIFY\""
					preserve score =  n0score
					preserve new_score_Left =  n0new_score_Left
					preserve new_score_Right =  n0new_score_Right
				}			      		
				 preserve			node n1:GridNode			      		
				 preserve			node n2:Pacman			      		
				 preserve			node n3:DiffFood{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
				}			      		
				 preserve			node n4:DiffPositionableEntity_on{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
				}			      		
				 create				node n5:SemanticDiff{
					create name = "\"Pacman Eat Food\""
					create author		=  "\"EQUAL\""
				}
				 forbid			node n6:SemanticDiff{
					forbid name = "\"Pacman Eat Food\""
				}					
			edges[
			  		(preserve	n0->n1:gridnodes),
			  		(preserve	n0->n2:entities),
			  		(preserve	n0->n3:entities),
			  		(preserve	n2->n1:on),
			  		(preserve	n3->n4:diffon),
			  		(preserve	n4->n1:eType),
			  		(create		n5->n0:SemanticObject_Game),
			  		(create		n5->n1:SemanticObject_GridNode),
			  		(create		n5->n2:SemanticObject_PositionableEntity),
			  		(create		n5->n3:SemanticObject_PositionableEntity),
			  		(forbid		n6->n0:SemanticObject_Game),
			  		(forbid		n6->n1:SemanticObject_GridNode),
			  		(forbid		n6->n2:SemanticObject_PositionableEntity),
			  		(forbid		n6->n3:SemanticObject_PositionableEntity)
	      		 ]
			}
			conditions [((n0score < n0new_score_Left)) AND ((n0score < n0new_score_Right))] 
		}
