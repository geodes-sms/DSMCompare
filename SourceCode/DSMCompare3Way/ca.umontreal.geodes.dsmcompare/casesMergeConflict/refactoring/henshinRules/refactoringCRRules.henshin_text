		unitpullUpMethod_moveMethodStar()
		unitpushDownMethod_moveMethodStar()
		unitmoveMethod_pushDownMethodStar()
		unitmoveAttribute_pullUpAttributeStar()
		unitpullUpAttribute_moveAttributeStar()
		unitmoveAttribute_pushDownAttributeStar()
		unitpushDownAttribute_moveAttributeStar()
		unitpullUpMethod_AddInheritanceStar()
		unitKeepSemanticDifferenceStar()
		unitKeepSemanticDifferenceTextBasedRulesStar()
	}
