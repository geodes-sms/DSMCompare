			  		(create		n24->n23:semanticdiffs),
			  		(create		n25->n24:semanticconflicts)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"DELETE\"") AND (n4diff_kind_Left == "\"ADD\"") AND (n5diff_kind_Left == "\"DELETE\"") AND (n8diff_kind_Left == "\"ADD\"")) OR ((n2diff_kind_Right == "\"DELETE\"") AND (n4diff_kind_Right == "\"ADD\"") AND (n5diff_kind_Right == "\"DELETE\"") AND (n8diff_kind_Right == "\"ADD\""))] 
