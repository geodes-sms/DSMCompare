		rule moveMethod_moveMethod_Combination(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n2changeStatus:EString,VAR n3diff_kind_Left:EString,VAR n3diff_kind_Right:EString,VAR n3changeStatus:EString,VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString,VAR n5changeStatus:EString,VAR n2eparameters:EString,VAR n7eparameters:EString,VAR n2methodBody:EString,VAR n7methodBody:EString)
		{
			graph
			{
				 preserve			node n1:EClass			      		
				 preserve			node n2:DiffEOperation{
					preserve changeStatus = n2changeStatus
					set		changeStatus =  "\"MERGE_DELETE\""
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
					preserve eparameters =  n2eparameters
					preserve methodBody =  n2methodBody
				}			      		
				 preserve			node n3:DiffEClass_eoperations{
					preserve changeStatus = n3changeStatus
					set		changeStatus =  "\"MERGE_DELETE\""
					preserve diff_kind_Left = n3diff_kind_Left
					preserve diff_kind_Right = n3diff_kind_Right
				}			      		
				 preserve			node n4:EClass			      		
				 preserve			node n5:DiffEClass_eoperations{
					preserve changeStatus = n5changeStatus
					set		changeStatus =  "\"MERGE_DELETE\""
					preserve diff_kind_Left = n5diff_kind_Left
					preserve diff_kind_Right = n5diff_kind_Right
				}			      		
				 preserve			node n6:EClass			      		
				 preserve			node n7:DiffEOperation{
					preserve eparameters =  n7eparameters
					preserve methodBody =  n7methodBody
				}			      		
				 preserve			node n8:SemanticDiff{
					preserve name =  "\"Move Method\""
					preserve author =  "\"LEFT\""
				}			      		
				 preserve			node n9:SemanticConflict{
					preserve conflict_kind =  "\"CONTRADICTING\""
					preserve conflict_Granularity =  "\"Semantic_Fine\""
				}			      		
				 create				node n10:ConflictResolution{
					create name =  "\"Move Method - Move Method - Combination\""
					create ResolutionType =  "\"Resolved\""
					create ResolutionStrategy =  "\"Apply_A_User_Defined_Resolution_Pattern\""
				}
				 forbid			node n11:ConflictResolution{
					forbid name =  "\"Move Method - Move Method - Combination\""
					forbid ResolutionType =  "\"Resolved\""
					forbid ResolutionStrategy =  "\"Apply_A_User_Defined_Resolution_Pattern\""
				}					
			edges[
			  		(preserve	n1->n2:eoperations),
			  		(preserve	n1->n3:diffeoperations),
			  		(preserve	n3->n2:eType),
			  		(preserve	n4->n5:diffeoperations),
			  		(preserve	n5->n2:eType),
			  		(preserve	n6->n7:eoperations),
			  		(preserve	n8->n3:SemanticObject_DiffEClass_eoperations),
			  		(preserve	n8->n5:SemanticObject_DiffEClass_eoperations),
			  		(preserve	n8->n1:SemanticObject_EClass),
			  		(preserve	n8->n4:SemanticObject_EClass),
			  		(preserve	n8->n2:SemanticObject_EOperation),
			  		(preserve	n9->n2:SemanticObject_DiffEOperation),
			  		(preserve	n9->n8:semanticdiffs),
			  		(create		n10->n9:semanticconflicts),
			  		(forbid		n11->n9:semanticconflicts)
	      		 ]
			}
			conditions [((n2eparameters  != "null" ) AND (n2eparameters  != "\"\"" ) AND (n7eparameters  != "null" ) AND (n7eparameters  != "\"\"" ) AND (n2methodBody  != "null" ) AND (n2methodBody  != "\"\"" ) AND (n7methodBody  != "null" ) AND (n7methodBody  != "\"\"" ) AND (n2eparameters == n7eparameters) AND (n2methodBody == n7methodBody) AND (n2diff_kind_Left == "\"DELETE\"") AND (n3diff_kind_Left == "\"DELETE\"") AND (n5diff_kind_Left == "\"ADD\"")) OR ((n2diff_kind_Right == "\"DELETE\"") AND (n3diff_kind_Right == "\"DELETE\"") AND (n5diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule moveMethod_pullUpMethod()
		{
			graph
			{
				 preserve			node n1:SemanticDiff{
					preserve name =  "\"Pull-up Method\""
					preserve author =  "\"RIGHT\""
				}			      		
				 preserve			node n2:SemanticDiff{
					preserve name =  "\"Move Method\""
					preserve author =  "\"LEFT\""
				}			      		
				 preserve			node n4:SemanticConflict{
					preserve name =  "\"Pull-up Method - Move Method\""
					preserve conflict_kind =  "\"CONTRADICTING\""
					preserve conflict_Granularity =  "\"Semantic_Semantic\""
				}			      		
				 create				node n5:ConflictResolution{
					create name =  "\"Prefer Pull-up Method over Move Method\""
					create ResolutionType =  "\"Pending\""
					create ResolutionStrategy =  "\"Keep_Right\""
				}
				 forbid			node n6:ConflictResolution{
					forbid name =  "\"Prefer Pull-up Method over Move Method\""
					forbid ResolutionType =  "\"Pending\""
					forbid ResolutionStrategy =  "\"Keep_Right\""
				}					
			edges[
			  		(preserve	n4->n1:semanticdiffs),
			  		(preserve	n4->n2:semanticdiffs),
			  		(create		n5->n4:semanticconflicts),
			  		(forbid		n6->n4:semanticconflicts)
	      		 ]
			}
		}
