				}			      		
				 preserve			node n9:EClass			      		
				 preserve			node n10:DiffEClass_eoperations			      		
				 preserve			node n21:SemanticDiff{
					preserve name =  "\"Move Class\""
					preserve author =  "\"LEFT\""
				}			      		
				 preserve			node n22:SemanticDiff{
					preserve name =  "\"Rename Method 2\""
					preserve author =  "\"LEFT\""
				}			      		
				 preserve			node n23:SemanticDiff{
					preserve name =  "\"Move Method\""
					preserve author =  "\"RIGHT\""
				}			      		
				 create				node n24:SemanticConflict{
					create name =  "\"Move Class / Rename Method 2 - Move Method\""
					create conflict_kind =  "\"CONTRADICTING\""
					create conflict_Granularity =  "\"Semantic_Semantic\""
				}			      		
				 create				node n25:ConflictResolution{
					create name =  "\"Move Class / Rename Method 2 - Move Method - Combination\""
					create ResolutionType =  "\"Resolved\""
					create ResolutionStrategy =  "\"Apply_A_User_Defined_Resolution_Pattern\""
				}
				 forbid			node n26:ConflictResolution{
					forbid name =  "\"Move Class / Rename Method 2 - Move Method - Combination\""
					forbid ResolutionType =  "\"Resolved\""
