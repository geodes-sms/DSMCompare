		rule moveClassRenameMethod2_moveMethod_Combination(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString,VAR n5changeStatus:EString,VAR n8diff_kind_Left:EString,VAR n8diff_kind_Right:EString)
		{
