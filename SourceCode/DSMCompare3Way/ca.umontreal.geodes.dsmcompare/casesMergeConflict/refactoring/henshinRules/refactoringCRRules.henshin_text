		rule pullUpMethod_AddInheritance(VAR n3changeStatus:EString)
		{
			graph
			{
				 preserve			node n1:EPackage			      		
				 preserve			node n2:EClass			      		
				 preserve			node n3:DiffEClass_eoperations{
					preserve changeStatus = n3changeStatus
					set		changeStatus =  "\"MERGE_DELETE\""
				}			      		
				 preserve			node n4:EClass			      		
				 preserve			node n5:EOperation			      		
				 create				node n7:DiffEClass_esupertypes{
					create changeStatus =  "\"MERGE_ADD\""
				}
				 create				node n8:DiffEClass_esupertypes{
					create changeStatus = "\"MERGE_DELETE\""
				}
				 preserve			node n9:EClass			      		
				 preserve			node n10:DiffEClass_esupertypes			      		
				 create				node n11:DiffEClass{
					create name =  "\"generated\""
					create changeStatus =  "\"MERGE_ADD\""
				}
				 create				node n12:DiffEClass_eoperations{
					create changeStatus =  "\"MERGE_ADD\""
				}
				 create				node n13:DiffEClass_esupertypes{
					create changeStatus =  "\"MERGE_ADD\""
				}
				 preserve			node n14:SemanticDiff{
					preserve name =  "\"Pull-up Method\""
				}			      		
				 create				node n15:SemanticConflict{
					create name =  "\"Pull-up Method - Add Inheritance\""
					create conflict_kind =  "\"CONTRADICTING\""
					create conflict_Granularity =  "\"Semantic_Fine\""
				}			      		
				 create				node n16:ConflictResolution{
					create name =  "\"Pull-up Method - Add Inheritance\""
					create ResolutionType =  "\"Resolved\""
					create ResolutionStrategy =  "\"Apply_A_User_Defined_Resolution_Pattern\""
				}
				 forbid			node n17:ConflictResolution{
					forbid name =  "\"Pull-up Method - Add Inheritance\""
					forbid ResolutionType =  "\"Resolved\""
					forbid ResolutionStrategy =  "\"Apply_A_User_Defined_Resolution_Pattern\""
				}					
			edges[
			  		(preserve	n1->n2:eclassifiers),
			  		(preserve	n1->n4:eclassifiers),
			  		(preserve	n1->n9:eclassifiers),
			  		(create		n1->n11:eclassifiers),
			  		(preserve	n2->n3:diffeoperations),
			  		(preserve	n3->n5:eType),
			  		(preserve	n4->n5:eoperations),
			  		(preserve	n4->n2:esupertypes),
			  		(create		n4->n7:diffesupertypes),
			  		(create		n4->n8:diffesupertypes),
			  		(create		n7->n11:eType),
			  		(create		n8->n2:eType),
			  		(preserve	n9->n10:diffesupertypes),
			  		(preserve	n10->n2:eType),
			  		(create		n11->n12:diffeoperations),
			  		(create		n11->n13:diffesupertypes),
			  		(create		n12->n5:eType),
			  		(create		n13->n2:eType),
			  		(preserve	n14->n2:SemanticObject_EClass),
			  		(preserve	n14->n4:SemanticObject_EClass),
			  		(preserve	n14->n5:SemanticObject_EOperation),
			  		(preserve	n14->n1:SemanticObject_EPackage),
			  		(create		n15->n11:SemanticObject_DiffEClass),
			  		(create		n15->n9:SemanticObject_EClass),
			  		(create		n15->n2:SemanticObject_EClass),
			  		(create		n15->n4:SemanticObject_EClass),
			  		(create		n15->n14:semanticdiffs),
			  		(create		n16->n15:semanticconflicts)
	      		 ]
			}
		}
//----------------------------------------------------------------------

		rule KeepSemanticDifference(VAR n1name:EString)
		{
			graph
			{
				 preserve			node n1:SemanticConflict{
					preserve conflict_kind =  "\"CONTRADICTING\""
					preserve conflict_Granularity =  "\"Semantic_Fine\""
					preserve name =  n1name
				}			      		
				 create				node n2:ConflictResolution{
					create name =  "\"Keep semantic difference\""
					create ResolutionType =  "\"Resolved\""
					create ResolutionStrategy =  "\"Keep_Semantic_Difference\""
				}
				 forbid			node n3:ConflictResolution{
					forbid name =  "\"Keep semantic difference\""
					forbid ResolutionType =  "\"Resolved\""
					forbid ResolutionStrategy =  "\"Keep_Semantic_Difference\""
				}					
			edges[
			  		(create		n2->n1:semanticconflicts),
			  		(forbid		n3->n1:semanticconflicts)
	      		 ]
			}
			conditions [(n1name  != "null" ) AND (n1name  != "\"\"" ) AND (("n1name.contains('Inline Method')" !=  'true' ) AND ("n1name.contains('Change Parameters')" !=  'true' ))] 
		}
//----------------------------------------------------------------------

		rule KeepSemanticDifferenceTextBasedRules(VAR n1name:EString)
		{
			graph
			{
				 preserve			node n1:SemanticConflict{
					preserve conflict_kind =  "\"CONTRADICTING\""
					preserve conflict_Granularity =  "\"Semantic_Fine\""
					preserve name =  n1name
				}			      		
				 create				node n2:ConflictResolution{
					create name =  "\"Keep semantic difference\""
					create ResolutionType =  "\"Pending\""
					create ResolutionStrategy =  "\"Keep_Semantic_Difference\""
				}
				 forbid			node n3:ConflictResolution{
					forbid name =  "\"Keep semantic difference\""
					forbid ResolutionType =  "\"Pending\""
					forbid ResolutionStrategy =  "\"Keep_Semantic_Difference\""
				}					
			edges[
			  		(create		n2->n1:semanticconflicts),
			  		(forbid		n3->n1:semanticconflicts)
	      		 ]
			}
			conditions [(n1name  != "null" ) AND (n1name  != "\"\"" ) AND (("n1name.contains('Inline Method')" ==  'true' ) OR ("n1name.contains('Change Parameters')" ==  'true' ))] 
		}
//----------------------------------------------------------------------

	unit unitSequntialStar(){
		unitmoveClassRenameMethod2_moveMethod_CombinationStar()
		unitmoveMethod_moveClassRenameMethod2_CombinationStar()
		unitmoveAndRenameMethod_pullUpMethod_TransitivityStar()
		unitpullUpMethod_moveAndRenameMethod_TransitivityStar()
		unitmoveAndRenameMethod_pushDownMethod_TransitivityStar()
		unitpushDownMethod_moveAndRenameMethod_TransitivityStar()
		unitmoveMethod_moveMethod_CombinationStar()
