			  		(preserve	n10->n5:eType),
			  		(preserve	n21->n8:SemanticObject_DiffEClass_nested_classes),
			  		(preserve	n21->n2:SemanticObject_DiffEPackage_eclassifiers),
			  		(preserve	n21->n1:SemanticObject_EPackage),
			  		(preserve	n22->n4:SemanticObject_EOperation),
			  		(preserve	n22->n5:SemanticObject_EOperation),
			  		(preserve	n23->n6:SemanticObject_DiffEClass_eoperations),
			  		(preserve	n23->n10:SemanticObject_DiffEClass_eoperations),
			  		(preserve	n23->n5:SemanticObject_EOperation),
			  		(create		n24->n21:semanticdiffs),
