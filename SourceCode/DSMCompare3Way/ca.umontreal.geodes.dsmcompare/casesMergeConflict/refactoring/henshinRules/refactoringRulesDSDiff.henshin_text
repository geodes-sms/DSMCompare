//--------------- Rule #31
//===== EQUAL
rule changePackage_equal(VAR n2new_packageName_Left:EString,VAR n2packageName:EString,VAR n2new_packageName_Right:EString)
{
	graph
	{
				 preserve			node n1:EPackage			      		
				 preserve						node n2:DiffEClass{
					preserve diff_kind_Left = "\"MODIFY\""
					preserve diff_kind_Right = "\"MODIFY\""
					preserve new_packageName_Left =  n2new_packageName_Left
					preserve packageName =  n2packageName
					preserve new_packageName_Right =  n2new_packageName_Right
					preserve filter = false 
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"change Package\""
					create author		=  "\"EQUAL\""
				}
				 forbid			node n4:SemanticDiff{
					forbid name = "\"change Package\""
				}					
	edges[
	  		(preserve	n1->n2:eclassifiers),
	  		(create		n3->n2:SemanticObject_DiffEClass),
	  		(create		n3->n1:SemanticObject_EPackage),
	  		(forbid		n4->n2:SemanticObject_DiffEClass),
	  		(forbid		n4->n1:SemanticObject_EPackage)
	      		 ]
	}
	conditions [((n2new_packageName_Left  != "null" ) AND (n2new_packageName_Left  != "\"\"" ) AND (n2packageName  != "null" ) AND (n2packageName  != "\"\"" ) AND (n2packageName != n2new_packageName_Left)) AND ((n2new_packageName_Right  != "null" ) AND (n2new_packageName_Right  != "\"\"" ) AND (n2packageName  != "null" ) AND (n2packageName  != "\"\"" ) AND (n2packageName != n2new_packageName_Right))] 
}

