//--------------- Rule #42
//===== EQUAL
rule flattenHierarchyAttr_equal()
{
	graph
	{
				 preserve			node n1:EClass			      		
				 preserve						node n2:DiffEClass_eattributes{
					preserve diff_kind_Left = "\"ADD\""
					preserve diff_kind_Right = "\"ADD\""
					preserve filter = false 
				}			      		
				 preserve						node n3:DiffEClass_esupertypes{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve filter = false 
					set filter = true 
				}			      		
				 preserve						node n4:DiffEClass{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve filter = false 
				}			      		
				 preserve						node n5:DiffEAttribute{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve filter = false 
				}			      		
				 preserve						node n6:DiffEClass_eattributes{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve filter = false 
					set filter = true 
				}			      		
				 create				node n7:SemanticDiff{
					create name = "\"Flatten Hierarchy Attribute\""
					create author		=  "\"EQUAL\""
				}
				 forbid			node n8:SemanticDiff{
					forbid name = "\"Flatten Hierarchy Attribute\""
				}					
	edges[
	  		(preserve	n1->n2:diffeattributes),
	  		(preserve	n1->n3:diffesupertypes),
	  		(preserve	n2->n5:eType),
	  		(preserve	n3->n4:eType),
	  		(preserve	n4->n5:eattributes),
	  		(preserve	n4->n6:diffeattributes),
	  		(preserve	n6->n5:eType),
	  		(create		n7->n2:SemanticObject_DiffEClass_eattributes),
	  		(create		n7->n6:SemanticObject_DiffEClass_eattributes),
	  		(create		n7->n3:SemanticObject_DiffEClass_esupertypes),
	  		(create		n7->n5:SemanticObject_EAttribute),
	  		(create		n7->n1:SemanticObject_EClass),
	  		(create		n7->n4:SemanticObject_EClass),
	  		(forbid		n8->n2:SemanticObject_DiffEClass_eattributes),
	  		(forbid		n8->n6:SemanticObject_DiffEClass_eattributes),
	  		(forbid		n8->n3:SemanticObject_DiffEClass_esupertypes),
	  		(forbid		n8->n5:SemanticObject_EAttribute),
	  		(forbid		n8->n1:SemanticObject_EClass),
	  		(forbid		n8->n4:SemanticObject_EClass)
	      		 ]
	}
}

