//--------------- Rule #40
//===== EQUAL
rule mergeRefrences_equal(VAR n8etype:EString,VAR n15etype:EString,VAR n9etype:EString,VAR n16etype:EString,VAR n1name:EString,VAR n2name:EString,VAR n3name:EString,VAR n14etype:EString)
{
	graph
	{
				 preserve			node n1:EClass{
					preserve name =  n1name
				}			      		
				 preserve			node n2:EClass{
					preserve name =  n2name
				}			      		
				 preserve			node n3:EClass{
					preserve name =  n3name
				}			      		
				 preserve			node n4:EClass			      		
				 create				node n5:SemanticDiff{
					create name = "\"Merge Refrences\""
					create author		=  "\"EQUAL\""
				}
				 preserve			node n8:EReference{
					preserve etype =  n8etype
				}			      		
				 preserve			node n9:EReference{
					preserve etype =  n9etype
				}			      		
				 preserve						node n14:DiffEReference{
					preserve diff_kind_Left = "\"ADD\""
					preserve diff_kind_Right = "\"ADD\""
					preserve etype =  n14etype
					preserve filter = false 
				}			      		
				 preserve						node n15:DiffEReference{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve etype =  n15etype
					preserve filter = false 
					set filter = true 
				}			      		
				 preserve						node n16:DiffEReference{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve etype =  n16etype
					preserve filter = false 
					set filter = true 
				}			      		
				 forbid			node n55:SemanticDiff{
					forbid name = "\"Merge Refrences\""
				}					
	edges[
	  		(preserve	n1->n3:esupertypes),
	  		(preserve	n2->n3:esupertypes),
	  		(preserve	n3->n8:ereferences),
	  		(preserve	n3->n9:ereferences),
	  		(preserve	n4->n14:ereferences),
	  		(preserve	n4->n15:ereferences),
	  		(preserve	n4->n16:ereferences),
	  		(create		n5->n14:SemanticObject_DiffEReference),
	  		(create		n5->n15:SemanticObject_DiffEReference),
	  		(create		n5->n16:SemanticObject_DiffEReference),
	  		(create		n5->n1:SemanticObject_EClass),
	  		(create		n5->n2:SemanticObject_EClass),
	  		(create		n5->n4:SemanticObject_EClass),
	  		(create		n5->n3:SemanticObject_EClass),
	  		(create		n5->n8:SemanticObject_EReference),
	  		(create		n5->n9:SemanticObject_EReference),
	  		(create		n5->n14:SemanticObject_EReference),
	  		(create		n5->n15:SemanticObject_EReference),
	  		(create		n5->n16:SemanticObject_EReference),
	  		(forbid		n55->n14:SemanticObject_DiffEReference),
	  		(forbid		n55->n15:SemanticObject_DiffEReference),
	  		(forbid		n55->n16:SemanticObject_DiffEReference),
	  		(forbid		n55->n1:SemanticObject_EClass),
	  		(forbid		n55->n2:SemanticObject_EClass),
	  		(forbid		n55->n4:SemanticObject_EClass),
	  		(forbid		n55->n3:SemanticObject_EClass),
	  		(forbid		n55->n8:SemanticObject_EReference),
	  		(forbid		n55->n9:SemanticObject_EReference),
	  		(forbid		n55->n14:SemanticObject_EReference),
	  		(forbid		n55->n15:SemanticObject_EReference),
	  		(forbid		n55->n16:SemanticObject_EReference)
	      		 ]
	}
	conditions [((n8etype == n15etype) AND (n9etype == n16etype) AND (n1name == n8etype) AND (n2name == n9etype) AND (n3name == n14etype)) AND ((n8etype == n15etype) AND (n9etype == n16etype) AND (n1name == n8etype) AND (n2name == n9etype) AND (n3name == n14etype))] 
}

