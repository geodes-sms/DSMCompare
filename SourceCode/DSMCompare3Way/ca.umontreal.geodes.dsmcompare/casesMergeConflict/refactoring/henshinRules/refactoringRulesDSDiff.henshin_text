ePackageImport  refactoringDiffMM

//>>>>>>>>>>>>>>>>>>>> Rules
//--------------- Rule #1
//===== EQUAL
rule pullUpMethod_equal()
{
	graph
	{
				 preserve			node n1:EClass			      		
				 preserve						node n2:DiffEClass_eoperations{
					preserve diff_kind_Left = "\"ADD\""
					preserve diff_kind_Right = "\"ADD\""
					preserve filter = false 
					set filter = true 
				}			      		
				 preserve			node n3:EClass			      		
				 preserve			node n4:EOperation			      		
				 preserve						node n5:DiffEClass_eoperations{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve filter = false 
				}			      		
				 create				node n6:SemanticDiff{
					create name = "\"Pull-up Method\""
					create author		=  "\"EQUAL\""
				}
				 forbid			node n66:SemanticDiff{
					forbid name = "\"Pull-up Method\""
				}					
	edges[
	  		(preserve	n1->n2:diffeoperations),
	  		(preserve	n2->n4:eType),
	  		(preserve	n3->n4:eoperations),
	  		(preserve	n3->n1:esupertypes),
	  		(preserve	n3->n5:diffeoperations),
	  		(preserve	n5->n4:eType),
	  		(create		n6->n2:SemanticObject_DiffEClass_eoperations),
	  		(create		n6->n5:SemanticObject_DiffEClass_eoperations),
	  		(create		n6->n1:SemanticObject_EClass),
	  		(create		n6->n3:SemanticObject_EClass),
	  		(create		n6->n4:SemanticObject_EOperation),
	  		(forbid		n66->n2:SemanticObject_DiffEClass_eoperations),
	  		(forbid		n66->n5:SemanticObject_DiffEClass_eoperations),
	  		(forbid		n66->n1:SemanticObject_EClass),
	  		(forbid		n66->n3:SemanticObject_EClass),
	  		(forbid		n66->n4:SemanticObject_EOperation)
	      		 ]
	}
}

