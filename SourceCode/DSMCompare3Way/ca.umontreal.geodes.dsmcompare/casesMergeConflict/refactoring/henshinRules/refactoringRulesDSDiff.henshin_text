//--------------- Rule #18
//===== EQUAL
rule moveClass_equal(VAR n1name:EString,VAR n2name:EString)
{
	graph
	{
				 preserve			node n0:EPackage			      		
				 preserve						node n1:DiffEClass{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve name =  n1name
					preserve filter = false 
					set filter = true 
				}			      		
				 preserve						node n2:DiffEClass{
					preserve diff_kind_Left = "\"ADD\""
					preserve diff_kind_Right = "\"ADD\""
					preserve name =  n2name
					preserve filter = false 
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"Move Class\""
					create author		=  "\"EQUAL\""
				}
				 forbid			node n4:SemanticDiff{
					forbid name = "\"Move Class\""
				}					
	edges[
	  		(preserve	n0->n1:eclassifiers),
	  		(preserve	n0->n2:eclassifiers),
	  		(create		n3->n2:SemanticObject_EClass),
	  		(create		n3->n1:SemanticObject_EClass),
	  		(create		n3->n0:SemanticObject_EPackage),
	  		(forbid		n4->n2:SemanticObject_EClass),
	  		(forbid		n4->n1:SemanticObject_EClass),
	  		(forbid		n4->n0:SemanticObject_EPackage)
	      		 ]
	}
	conditions [((n1name  != "null" ) AND (n1name  != "\"\"" ) AND (n2name  != "null" ) AND (n2name  != "\"\"" ) AND (n1name == n2name)) AND ((n1name  != "null" ) AND (n1name  != "\"\"" ) AND (n2name  != "null" ) AND (n2name  != "\"\"" ) AND (n1name == n2name))] 
}

