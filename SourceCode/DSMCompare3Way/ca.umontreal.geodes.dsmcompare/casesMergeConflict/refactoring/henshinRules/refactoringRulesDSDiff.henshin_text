//===== RIGHT
rule mergeRefrences_right(VAR n8etype:EString,VAR n15etype:EString,VAR n9etype:EString,VAR n16etype:EString,VAR n1name:EString,VAR n2name:EString,VAR n3name:EString,VAR n14etype:EString)
