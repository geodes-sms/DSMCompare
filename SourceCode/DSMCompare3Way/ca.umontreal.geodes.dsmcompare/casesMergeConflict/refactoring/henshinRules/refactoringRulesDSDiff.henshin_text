//--------------- Rule #39
//===== EQUAL
rule inlineMethod_equal(VAR n1new_methodBody_Left:EString,VAR n2name:EString,VAR n1new_methodBody_Right:EString)
{
	graph
	{
				 preserve						node n1:DiffEOperation{
					preserve diff_kind_Left = "\"MODIFY\""
					preserve diff_kind_Right = "\"MODIFY\""
					preserve new_methodBody_Left =  n1new_methodBody_Left
					preserve new_methodBody_Right =  n1new_methodBody_Right
					preserve filter = false 
				}			      		
				 preserve						node n2:DiffEOperation{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve name =  n2name
					preserve filter = false 
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"Inline Method\""
					create author		=  "\"EQUAL\""
				}
				 forbid			node n4:SemanticDiff{
					forbid name = "\"Inline Method\""
				}					
	edges[
	  		(create		n3->n2:SemanticObject_EOperation),
	  		(create		n3->n1:SemanticObject_EOperation),
	  		(forbid		n4->n2:SemanticObject_EOperation),
	  		(forbid		n4->n1:SemanticObject_EOperation)
	      		 ]
	}
	conditions [((n1new_methodBody_Left  != "null" ) AND (n1new_methodBody_Left  != "\"\"" ) AND (n2name  != "null" ) AND (n2name  != "\"\"" ) AND ("n1new_methodBody_Left.contains('method invocation; ' + n2name.replace('()',';'))" == 'true')) AND ((n1new_methodBody_Right  != "null" ) AND (n1new_methodBody_Right  != "\"\"" ) AND (n2name  != "null" ) AND (n2name  != "\"\"" ) AND ("n1new_methodBody_Right.contains('method invocation; ' + n2name.replace('()',';'))" == 'true'))] 
}

