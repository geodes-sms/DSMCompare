	  		(create		n5->n1:SemanticObject_EClass),
	  		(create		n5->n2:SemanticObject_EClass),
	  		(create		n5->n4:SemanticObject_EClass),
	  		(create		n5->n3:SemanticObject_EClass),
	  		(create		n5->n8:SemanticObject_EReference),
	  		(create		n5->n9:SemanticObject_EReference),
	  		(create		n5->n14:SemanticObject_EReference),
	  		(create		n5->n15:SemanticObject_EReference),
	  		(create		n5->n16:SemanticObject_EReference),
	  		(forbid		n55->n14:SemanticObject_DiffEReference),
	  		(forbid		n55->n15:SemanticObject_DiffEReference),
	  		(forbid		n55->n16:SemanticObject_DiffEReference),
	  		(forbid		n55->n1:SemanticObject_EClass),
	  		(forbid		n55->n2:SemanticObject_EClass),
