	  		(forbid		n4->n1:SemanticObject_DiffEOperation),
	  		(forbid		n4->n2:SemanticObject_DiffEOperation)
	      		 ]
	}
	conditions [(n1new_methodBody_Left  != "null" ) AND (n1new_methodBody_Left  != "\"\"" ) AND (n2name  != "null" ) AND (n2name  != "\"\"" ) AND ("n1new_methodBody_Left.contains('method invocation; ' + n2name.replace('()',';'))" == 'true')] 
