//--------------- Rule #22
//===== EQUAL
rule moveAndRenameMethod_equal(VAR n2name:EString,VAR n4name:EString,VAR n2eparameters:EString,VAR n4eparameters:EString,VAR n2methodBody:EString,VAR n4methodBody:EString)
{
	graph
	{
				 preserve			node n1:EClass			      		
				 preserve						node n2:DiffEOperation{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve name =  n2name
					preserve eparameters =  n2eparameters
					preserve methodBody =  n2methodBody
					preserve filter = false 
				}			      		
				 preserve			node n3:EClass			      		
				 preserve						node n4:DiffEOperation{
					preserve diff_kind_Left = "\"ADD\""
					preserve diff_kind_Right = "\"ADD\""
					preserve name =  n4name
					preserve eparameters =  n4eparameters
					preserve methodBody =  n4methodBody
					preserve filter = false 
				}			      		
				 create				node n5:SemanticDiff{
					create name = "\"Move And Rename Method\""
					create author		=  "\"EQUAL\""
				}
				 forbid			node n6:SemanticDiff{
					forbid name = "\"Move And Rename Method\""
				}					
	edges[
	  		(preserve	n1->n2:eoperations),
	  		(preserve	n3->n4:eoperations),
	  		(create		n5->n2:SemanticObject_EOperation),
	  		(create		n5->n4:SemanticObject_EOperation),
	  		(forbid		n6->n2:SemanticObject_EOperation),
	  		(forbid		n6->n4:SemanticObject_EOperation)
	      		 ]
	}
	conditions [((n2name  != "null" ) AND (n2name  != "\"\"" ) AND (n4name  != "null" ) AND (n4name  != "\"\"" ) AND (n2eparameters  != "null" ) AND (n2eparameters  != "\"\"" ) AND (n4eparameters  != "null" ) AND (n4eparameters  != "\"\"" ) AND (n2methodBody  != "null" ) AND (n2methodBody  != "\"\"" ) AND (n4methodBody  != "null" ) AND (n4methodBody  != "\"\"" ) AND (n2name != n4name) AND (n2eparameters == n4eparameters) AND (n2methodBody == n4methodBody)) AND ((n2name  != "null" ) AND (n2name  != "\"\"" ) AND (n4name  != "null" ) AND (n4name  != "\"\"" ) AND (n2eparameters  != "null" ) AND (n2eparameters  != "\"\"" ) AND (n4eparameters  != "null" ) AND (n4eparameters  != "\"\"" ) AND (n2methodBody  != "null" ) AND (n2methodBody  != "\"\"" ) AND (n4methodBody  != "null" ) AND (n4methodBody  != "\"\"" ) AND (n2name != n4name) AND (n2eparameters == n4eparameters) AND (n2methodBody == n4methodBody))] 
}

