					preserve filter = false 
					set filter = true 
				}			      		
				 preserve						node n16:DiffEReference{
					preserve diff_kind_Right = "\"DELETE\""
					preserve etype =  n16etype
					preserve filter = false 
					set filter = true 
				}			      		
				 forbid			node n55:SemanticDiff{
					forbid name = "\"Merge Refrences\""
				}					
	edges[
	  		(preserve	n1->n3:esupertypes),
	  		(preserve	n2->n3:esupertypes),
	  		(preserve	n3->n8:ereferences),
	  		(preserve	n3->n9:ereferences),
	  		(preserve	n4->n14:ereferences),
	  		(preserve	n4->n15:ereferences),
	  		(preserve	n4->n16:ereferences),
