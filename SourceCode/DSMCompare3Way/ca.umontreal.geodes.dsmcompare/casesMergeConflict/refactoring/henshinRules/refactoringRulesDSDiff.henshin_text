//--------------- Rule #16
//===== EQUAL
rule moveAndRenameClassAcrossPackage_equal(VAR n2new_name_Left:EString,VAR n2name:EString,VAR n2new_name_Right:EString)
{
	graph
	{
				 preserve			node n0:EPackage			      		
				 preserve						node n2:DiffEClass{
					preserve diff_kind_Left = "\"MODIFY\""
					preserve diff_kind_Right = "\"MODIFY\""
					preserve new_name_Left =  n2new_name_Left
					preserve name =  n2name
					preserve new_name_Right =  n2new_name_Right
					preserve filter = false 
				}			      		
				 preserve						node n3:DiffEPackage_eclassifiers{
					preserve diff_kind_Left = "\"DELETE\""
					preserve diff_kind_Right = "\"DELETE\""
					preserve filter = false 
					set filter = true 
				}			      		
				 preserve			node n4:EPackage			      		
				 preserve						node n5:DiffEPackage_eclassifiers{
					preserve diff_kind_Left = "\"ADD\""
					preserve diff_kind_Right = "\"ADD\""
					preserve filter = false 
				}			      		
				 create				node n6:SemanticDiff{
					create name = "\"Move And Rename Class Across Package\""
					create author		=  "\"EQUAL\""
				}
				 forbid			node n7:SemanticDiff{
					forbid name = "\"Move And Rename Class Across Package\""
				}					
	edges[
	  		(preserve	n0->n2:eclassifiers),
	  		(preserve	n0->n3:diffeclassifiers),
	  		(preserve	n3->n2:eType),
	  		(preserve	n4->n5:diffeclassifiers),
	  		(preserve	n5->n2:eType),
	  		(create		n6->n5:SemanticObject_DiffEPackage_eclassifiers),
	  		(create		n6->n3:SemanticObject_DiffEPackage_eclassifiers),
	  		(create		n6->n2:SemanticObject_EClass),
	  		(create		n6->n0:SemanticObject_EPackage),
	  		(create		n6->n4:SemanticObject_EPackage),
	  		(forbid		n7->n5:SemanticObject_DiffEPackage_eclassifiers),
	  		(forbid		n7->n3:SemanticObject_DiffEPackage_eclassifiers),
	  		(forbid		n7->n2:SemanticObject_EClass),
	  		(forbid		n7->n0:SemanticObject_EPackage),
	  		(forbid		n7->n4:SemanticObject_EPackage)
	      		 ]
	}
	conditions [((n2new_name_Left  != "null" ) AND (n2new_name_Left  != "\"\"" ) AND (n2name  != "null" ) AND (n2name  != "\"\"" ) AND (n2name != n2new_name_Left)) AND ((n2new_name_Right  != "null" ) AND (n2new_name_Right  != "\"\"" ) AND (n2name  != "null" ) AND (n2name  != "\"\"" ) AND (n2name != n2new_name_Right))] 
}

