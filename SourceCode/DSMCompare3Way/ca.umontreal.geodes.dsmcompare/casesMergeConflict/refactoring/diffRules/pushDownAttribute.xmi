<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="pushDownAttribute">
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name="super"
      ID_Pattern="1">
    <eattributes
        xsi:type="refactoring2WayRuleMM:Pattern_EAttribute"
        name="attr"
        ID_Pattern="2"/>
    <diffeattributes
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
        diff_kind="DELETE"
        eType="attr"
        ID_Pattern="3"/>
  </rulePattern_EClass>
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name="sub"
      esupertypes="super"
      ID_Pattern="4">
    <diffeattributes
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
        diff_kind="ADD"
        eType="attr"
        ID_Pattern="5"
        filter="true"/>
  </rulePattern_EClass>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Push-down Attribute"
      SemanticObject_DiffEClass_eattributes="//@rulePattern_EClass.1/@diffeattributes.0 //@rulePattern_EClass.0/@diffeattributes.0"
      SemanticObject_EAttribute="attr"
      SemanticObject_EClass="super sub"
      ID_Pattern="6"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Push-down Attribute"
      SemanticObject_DiffEClass_eattributes="//@rulePattern_EClass.1/@diffeattributes.0 //@rulePattern_EClass.0/@diffeattributes.0"
      SemanticObject_EAttribute="attr"
      SemanticObject_EClass="super sub"
      ID_Pattern="66"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
