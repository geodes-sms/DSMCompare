<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM" name="ruleDSMDiff">
  <pattern xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_EClass" name="super" ID_Pattern="1">
      <differeferences xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_ereferences" diff_kind="ADD" eType="ref" ID_Pattern="4"/>
    </eclassifiers>
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_EClass" name="sub" esupertypes="super" ID_Pattern="2">
      <ereferences xsi:type="refactoring2WayRuleMM:Pattern_EReference" name="ref" ID_Pattern="6"/>
      <differeferences xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_ereferences" diff_kind="DELETE" eType="ref" ID_Pattern="8" filter="true"/>
    </eclassifiers>
    <domainspecificdiffs xsi:type="refactoring2WayRuleMM:Pattern_DomainSpecificDiff" name="ruleDSMDiff" DomainSpecificDiff_EClass="super sub" DomainSpecificDiff_EPackage="//@pattern" DomainSpecificDiff_EReference="ref" DomainSpecificDiff_DiffEClass_ereferences="//@pattern/@eclassifiers.0/@differeferences.0" ID_Pattern="3"/>
  </pattern>
</refactoring2WayRuleMM:Rule>
