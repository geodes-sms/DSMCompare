<?xml version="1.0" encoding="UTF-8"?>
<refactoringDiffMM:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:refactoringDiffMM="www.geodes.UdeM.edu/refactoringDiffMM" name="rfc">
  <eclassifiers name="root"/>
  <eclassifiers xsi:type="refactoringDiffMM:DiffEClass" name="cls3" esupertypes="root" diff_kind_Left="ADD">
    <diffeattributes diff_kind_Left="ADD" eType="attr1"/>
    <diffeattributes diff_kind_Left="ADD" eType="attr2"/>
    <diffesupertypes diff_kind_Left="ADD" eType="root"/>
  </eclassifiers>
  <eclassifiers xsi:type="refactoringDiffMM:DiffEClass" name="cls1" diff_kind_Left="DELETE">
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="attr1" diff_kind_Left="DELETE"/>
    <diffeattributes diff_kind_Left="DELETE" eType="attr1"/>
    <diffesupertypes diff_kind_Left="DELETE" eType="root"/>
  </eclassifiers>
  <eclassifiers xsi:type="refactoringDiffMM:DiffEClass" name="cls2" diff_kind_Left="DELETE">
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="attr2" diff_kind_Left="DELETE"/>
    <diffeattributes diff_kind_Left="DELETE" eType="attr2"/>
    <diffesupertypes diff_kind_Left="DELETE" eType="root"/>
  </eclassifiers>
</refactoringDiffMM:EPackage>
