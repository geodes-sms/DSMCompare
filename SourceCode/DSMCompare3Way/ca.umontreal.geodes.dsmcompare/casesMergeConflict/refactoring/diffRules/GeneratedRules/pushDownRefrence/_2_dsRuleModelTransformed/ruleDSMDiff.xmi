<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM" name="ruleDSMDiff">
  <pattern xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_EClass" name="super" ID_Pattern="1"/>
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_EClass" name="sub" esupertypes="super" ID_Pattern="2">
      <differeferences xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_ereferences" diff_kind="ADD" ID_Pattern="5"/>
    </eclassifiers>
    <domainspecificdiffs xsi:type="refactoring2WayRuleMM:Pattern_DomainSpecificDiff" name="ruleDSMDiff" DomainSpecificDiff_EClass="super sub super" DomainSpecificDiff_EPackage="//@pattern" DomainSpecificDiff_EReference="ref ref" DomainSpecificDiff_DiffEClass_ereferences="//@pattern/@eclassifiers.1/@differeferences.0" ID_Pattern="3"/>
  </pattern>
</refactoring2WayRuleMM:Rule>
