<?xml version="1.0" encoding="UTF-8"?>
<refactoring:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring="www.geodes.UdeM.edu/refactoring"
    xsi:schemaLocation="www.geodes.UdeM.edu/refactoring ../metaModels/refactoring.ecore"
    name="rfc">
  <eclassifiers
      name="cls1"
      esupertypes="root"/>
  <eclassifiers
      name="cls2"
      esupertypes="root"/>
  <eclassifiers
      name="root">
    <ereferences
        name="refC1"
        etype="cls1"/>
    <ereferences
        name="refC2"
        etype="cls2"/>
  </eclassifiers>
  <eclassifiers
      name="superRoot">
    <ereferences
        name="refSC1"
        etype="cls1"/>
    <ereferences
        name="refSC2"
        etype="cls2"/>
  </eclassifiers>
</refactoring:EPackage>
