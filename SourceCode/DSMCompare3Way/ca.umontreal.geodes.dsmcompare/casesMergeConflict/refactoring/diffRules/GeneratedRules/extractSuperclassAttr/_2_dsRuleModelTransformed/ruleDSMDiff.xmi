<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM" name="ruleDSMDiff">
  <pattern xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_EClass" name="cls1" esupertypes="clsP" ID_Pattern="1">
      <eattributes xsi:type="refactoring2WayRuleMM:Pattern_EAttribute" name="attr1" ID_Pattern="4"/>
      <diffeattributes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes" diff_kind="DELETE" ID_Pattern="6"/>
      <diffesupertypes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_esupertypes" diff_kind="ADD" ID_Pattern="7"/>
    </eclassifiers>
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass" name="clsP" diff_kind="ADD" ID_Pattern="2">
      <diffeattributes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes" diff_kind="ADD" ID_Pattern="8"/>
      <diffeattributes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes" diff_kind="ADD" ID_Pattern="9"/>
    </eclassifiers>
    <domainspecificdiffs xsi:type="refactoring2WayRuleMM:Pattern_DomainSpecificDiff" name="ruleDSMDiff" DomainSpecificDiff_EAttribute="attr1" DomainSpecificDiff_EClass="cls1 clsP clsP" DomainSpecificDiff_EPackage="//@pattern" DomainSpecificDiff_DiffEClass_eattributes="//@pattern/@eclassifiers.0/@diffeattributes.0 //@pattern/@eclassifiers.1/@diffeattributes.0 //@pattern/@eclassifiers.1/@diffeattributes.1" DomainSpecificDiff_DiffEClass_esupertypes="//@pattern/@eclassifiers.0/@diffesupertypes.0" ID_Pattern="3"/>
  </pattern>
</refactoring2WayRuleMM:Rule>
