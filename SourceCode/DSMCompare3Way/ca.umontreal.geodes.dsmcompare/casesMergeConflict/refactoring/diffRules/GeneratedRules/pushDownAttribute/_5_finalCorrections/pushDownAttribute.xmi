<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="pushDownAttribute">
  <pattern xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="super"
        ID_Pattern="1">
      <eattributes
          xsi:type="refactoring2WayRuleMM:Pattern_EAttribute"
          name="attr"
          ID_Pattern="4"/>
      <diffeattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
          diff_kind="DELETE"
          eType="attr"
          ID_Pattern="7"
          filter="true"/>
    </eclassifiers>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="sub"
        esupertypes="super"
        ID_Pattern="2">
      <diffeattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
          diff_kind="ADD"
          eType="attr"
          ID_Pattern="9"/>
    </eclassifiers>
    <domainspecificdiffs
        xsi:type="refactoring2WayRuleMM:Pattern_DomainSpecificDiff"
        name="pushDownAttribute"
        DomainSpecificDiff_EAttribute="attr"
        DomainSpecificDiff_EClass="super sub"
        DomainSpecificDiff_EPackage="//@pattern"
        DomainSpecificDiff_DiffEClass_eattributes="//@pattern/@eclassifiers.1/@diffeattributes.0"
        ID_Pattern="3"/>
  </pattern>
</refactoring2WayRuleMM:Rule>
