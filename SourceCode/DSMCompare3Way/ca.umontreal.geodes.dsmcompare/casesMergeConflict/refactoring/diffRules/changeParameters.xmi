<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="changeParameters">
  <constraints>Item(1,&quot;new_eparameters&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(1,&quot;new_eparameters&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;eparameters&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(1,&quot;eparameters&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;eparameters&quot;) != Item(1,&quot;new_eparameters&quot;) </constraints>
  <rulePattern_DiffEOperation
      xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
      diff_kind="MODIFY"
      ID_Pattern="1"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Change Parameters"
      SemanticObject_DiffEOperation="//@rulePattern_DiffEOperation.0"
      ID_Pattern="2"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Change Parameters"
      SemanticObject_DiffEOperation="//@rulePattern_DiffEOperation.0"
      ID_Pattern="3"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
