<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="moveAttribute">
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name="cls1"
      ID_Pattern="1">
    <eattributes
        xsi:type="refactoring2WayRuleMM:Pattern_EAttribute"
        name="attr1"
        ID_Pattern="2"/>
    <diffeattributes
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
        diff_kind="DELETE"
        eType="attr1"
        ID_Pattern="3"/>
  </rulePattern_EClass>
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name="cls2"
      ID_Pattern="4">
    <diffeattributes
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
        diff_kind="ADD"
        eType="attr1"
        ID_Pattern="5"
        filter="true"/>
  </rulePattern_EClass>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Move Attribute"
      SemanticObject_DiffEClass_eattributes="//@rulePattern_EClass.1/@diffeattributes.0 //@rulePattern_EClass.0/@diffeattributes.0"
      SemanticObject_EAttribute="attr1"
      SemanticObject_EClass="cls1 cls2"
      ID_Pattern="6"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Move Attribute"
      SemanticObject_DiffEClass_eattributes="//@rulePattern_EClass.1/@diffeattributes.0 //@rulePattern_EClass.0/@diffeattributes.0"
      SemanticObject_EAttribute="attr1"
      SemanticObject_EClass="cls1 cls2"
      ID_Pattern="7"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
