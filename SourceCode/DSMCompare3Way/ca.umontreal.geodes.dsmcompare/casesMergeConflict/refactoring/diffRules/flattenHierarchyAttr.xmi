<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="flattenHierarchyAttr">
  <rulePattern_DiffEClass
      xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
      name="super"
      diff_kind="DELETE"
      ID_Pattern="4">
    <eattributes
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEAttribute"
        name="attr"
        diff_kind="DELETE"
        ID_Pattern="5"/>
    <diffeattributes
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
        diff_kind="DELETE"
        eType="attr"
        ID_Pattern="6"
        filter="true"/>
  </rulePattern_DiffEClass>
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name="sub"
      ID_Pattern="1">
    <diffeattributes
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
        diff_kind="ADD"
        eType="attr"
        ID_Pattern="2"/>
    <diffesupertypes
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_esupertypes"
        diff_kind="DELETE"
        eType="super"
        ID_Pattern="3"
        filter="true"/>
  </rulePattern_EClass>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Flatten Hierarchy Attribute"
      SemanticObject_DiffEClass_eattributes="//@rulePattern_EClass.0/@diffeattributes.0 //@rulePattern_DiffEClass.0/@diffeattributes.0"
      SemanticObject_DiffEClass_esupertypes="//@rulePattern_EClass.0/@diffesupertypes.0"
      SemanticObject_EAttribute="attr"
      SemanticObject_EClass="sub super"
      ID_Pattern="7"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Flatten Hierarchy Attribute"
      SemanticObject_DiffEClass_eattributes="//@rulePattern_EClass.0/@diffeattributes.0 //@rulePattern_DiffEClass.0/@diffeattributes.0"
      SemanticObject_DiffEClass_esupertypes="//@rulePattern_EClass.0/@diffesupertypes.0"
      SemanticObject_EAttribute="attr"
      SemanticObject_EClass="sub super"
      ID_Pattern="8"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
