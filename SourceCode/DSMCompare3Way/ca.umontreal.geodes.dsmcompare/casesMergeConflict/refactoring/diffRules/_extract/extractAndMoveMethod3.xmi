<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="extractAndMoveMethod3">
  <constraints>Item(1,&quot;name&quot;) != Item(3,&quot;name&quot;) </constraints>
  <constraints>Item(4,&quot;name&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(4,&quot;name&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;new_methodBody&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;new_methodBody&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;new_methodBody&quot;) contains Item(3,&quot;name&quot;) </constraints>
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      ID_Pattern="1">
    <eoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
        name="original"
        diff_kind="MODIFY"
        ID_Pattern="2"/>
  </rulePattern_EClass>
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      ID_Pattern="3">
    <eoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
        name="extracted"
        diff_kind="ADD"
        ID_Pattern="4"/>
  </rulePattern_EClass>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Extract And Move Method"
      SemanticObject_EClass="//@rulePattern_EClass.0 //@rulePattern_EClass.1"
      SemanticObject_EOperation="extracted original"
      ID_Pattern="5"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Extract And Move Method"
      SemanticObject_EClass="//@rulePattern_EClass.0 //@rulePattern_EClass.1"
      SemanticObject_EOperation="extracted original"
      ID_Pattern="6"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
