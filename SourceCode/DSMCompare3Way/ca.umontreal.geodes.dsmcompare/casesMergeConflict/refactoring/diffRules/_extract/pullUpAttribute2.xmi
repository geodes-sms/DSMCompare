<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="pullUpAttribute2">
  <constraints>Item(2,&quot;name&quot;) == Item(4,&quot;name&quot;)</constraints>
  <rulePattern_EPackage
      xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="super"
        ID_Pattern="1">
      <eattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEAttribute"
          diff_kind="ADD"
          ID_Pattern="2"/>
    </eclassifiers>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="sub"
        esupertypes="super"
        ID_Pattern="3">
      <eattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEAttribute"
          diff_kind="DELETE"
          ID_Pattern="4"
          filter="true"/>
    </eclassifiers>
  </rulePattern_EPackage>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Pull-up Attribute"
      SemanticObject_EAttribute="//@rulePattern_EPackage.0/@eclassifiers.0/@eattributes.0 //@rulePattern_EPackage.0/@eclassifiers.1/@eattributes.0"
      SemanticObject_EClass="super sub"
      SemanticObject_EPackage="//@rulePattern_EPackage.0"
      ID_Pattern="5"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Pull-up Attribute"
      SemanticObject_EAttribute="//@rulePattern_EPackage.0/@eclassifiers.0/@eattributes.0 //@rulePattern_EPackage.0/@eclassifiers.1/@eattributes.0"
      SemanticObject_EClass="super sub"
      SemanticObject_EPackage="//@rulePattern_EPackage.0"
      ID_Pattern="55"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
