<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="extractMethod2">
  <constraints>Item(3,&quot;methodBody&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;methodBody&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(3,&quot;methodBody&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;methodBody&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;methodBody&quot;) != Item(3,&quot;methodBody&quot;) </constraints>
  <constraints>Item(2,&quot;methodBody&quot;) contains Item(3,&quot;methodBody&quot;) </constraints>
  <rulePattern_EPackage
      xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        ID_Pattern="1">
      <eoperations
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
          name="original"
          diff_kind="MODIFY"
          ID_Pattern="2"/>
    </eclassifiers>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        ID_Pattern="30">
      <eoperations
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
          name="extracted"
          diff_kind="ADD"
          ID_Pattern="3"/>
    </eclassifiers>
  </rulePattern_EPackage>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Extract Method"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0 //@rulePattern_EPackage.0/@eclassifiers.1"
      SemanticObject_EOperation="extracted original"
      SemanticObject_EPackage="//@rulePattern_EPackage.0"
      ID_Pattern="4"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Extract Method"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0 //@rulePattern_EPackage.0/@eclassifiers.1"
      SemanticObject_EOperation="extracted original"
      SemanticObject_EPackage="//@rulePattern_EPackage.0"
      ID_Pattern="5"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
