<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="substituteAlgorithm">
  <constraints>Item(2,&quot;new_methodBody&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;new_methodBody&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;methodBody&quot;) != Item(2,&quot;new_methodBody&quot;)</constraints>
  <rulePattern_EPackage
      xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        ID_Pattern="1">
      <eoperations
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
          diff_kind="MODIFY"
          ID_Pattern="2"/>
    </eclassifiers>
  </rulePattern_EPackage>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Substitute Algorithm"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0"
      SemanticObject_EOperation="//@rulePattern_EPackage.0/@eclassifiers.0/@eoperations.0"
      SemanticObject_EPackage="//@rulePattern_EPackage.0"
      ID_Pattern="3"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Substitute Algorithm"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0"
      SemanticObject_EOperation="//@rulePattern_EPackage.0/@eclassifiers.0/@eoperations.0"
      SemanticObject_EPackage="//@rulePattern_EPackage.0"
      ID_Pattern="4"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
