<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="extractMethod6">
  <constraints>Item(1,&quot;methodBody&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(1,&quot;methodBody&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;methodBody&quot;) containsMethodInvocation Item(2,&quot;name&quot;) </constraints>
  <rulePattern_DiffEOperation
      xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
      name="original"
      diff_kind="ADD"
      ID_Pattern="1"/>
  <rulePattern_DiffEOperation
      xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
      name="extracted"
      diff_kind="ADD"
      ID_Pattern="2"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Extract Method"
      SemanticObject_EOperation="extracted original"
      ID_Pattern="3"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Extract Method"
      SemanticObject_EOperation="extracted original"
      ID_Pattern="4"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
