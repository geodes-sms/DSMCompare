<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="renameMethod2">
  <constraints>Item(1,&quot;name&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(1,&quot;name&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;name&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;name&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;eparameters&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(1,&quot;eparameters&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;eparameters&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;eparameters&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;methodBody&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(1,&quot;methodBody&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;methodBody&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;methodBody&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;name&quot;) != Item(2,&quot;name&quot;)</constraints>
  <constraints>Item(1,&quot;eparameters&quot;) == Item(2,&quot;eparameters&quot;)</constraints>
  <constraints>Item(1,&quot;methodBody&quot;) == Item(2,&quot;methodBody&quot;)</constraints>
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass">
    <eoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
        diff_kind="DELETE"
        ID_Pattern="1"/>
    <eoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
        diff_kind="ADD"
        ID_Pattern="2"/>
  </rulePattern_EClass>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Rename Method 2"
      SemanticObject_EOperation="//@rulePattern_EClass.0/@eoperations.0 //@rulePattern_EClass.0/@eoperations.1"
      ID_Pattern="3"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Rename Method 2"
      SemanticObject_EOperation="//@rulePattern_EClass.0/@eoperations.0 //@rulePattern_EClass.0/@eoperations.1"
      ID_Pattern="4"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
