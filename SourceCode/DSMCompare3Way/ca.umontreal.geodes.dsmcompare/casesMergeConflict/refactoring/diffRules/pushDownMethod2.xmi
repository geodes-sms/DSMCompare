<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="pushDownMethod2">
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name="super"
      ID_Pattern="1">
    <eoperations
        xsi:type="refactoring2WayRuleMM:Pattern_EOperation"
        ID_Pattern="2"/>
    <diffeoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eoperations"
        diff_kind="DELETE"
        eType="//@rulePattern_EClass.0/@eoperations.0"
        ID_Pattern="3"/>
  </rulePattern_EClass>
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name="sub"
      ID_Pattern="4">
    <diffeoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eoperations"
        diff_kind="ADD"
        eType="//@rulePattern_EClass.0/@eoperations.0"
        ID_Pattern="5"
        filter="true"/>
    <diffesupertypes
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_esupertypes"
        diff_kind="ADD"
        eType="super"/>
  </rulePattern_EClass>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Push-down Method"
      SemanticObject_DiffEClass_eoperations="//@rulePattern_EClass.1/@diffeoperations.0 //@rulePattern_EClass.0/@diffeoperations.0"
      SemanticObject_EClass="super sub"
      SemanticObject_EOperation="//@rulePattern_EClass.0/@eoperations.0"
      ID_Pattern="6"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Push-down Method"
      SemanticObject_DiffEClass_eoperations="//@rulePattern_EClass.1/@diffeoperations.0 //@rulePattern_EClass.0/@diffeoperations.0"
      SemanticObject_EClass="super sub"
      SemanticObject_EOperation="//@rulePattern_EClass.0/@eoperations.0"
      ID_Pattern="66"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
