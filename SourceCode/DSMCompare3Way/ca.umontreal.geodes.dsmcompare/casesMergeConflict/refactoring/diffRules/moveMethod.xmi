<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="moveMethod">
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name="cls1"
      ID_Pattern="1">
    <eoperations
        xsi:type="refactoring2WayRuleMM:Pattern_EOperation"
        name="method1"
        ID_Pattern="4"/>
    <diffeoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eoperations"
        diff_kind="DELETE"
        eType="method1"
        ID_Pattern="5"/>
  </rulePattern_EClass>
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name="cls2"
      ID_Pattern="2">
    <diffeoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eoperations"
        diff_kind="ADD"
        eType="method1"
        ID_Pattern="6"
        filter="true"/>
  </rulePattern_EClass>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Move Method"
      SemanticObject_DiffEClass_eoperations="//@rulePattern_EClass.1/@diffeoperations.0 //@rulePattern_EClass.0/@diffeoperations.0"
      SemanticObject_EClass="cls1 cls2"
      SemanticObject_EOperation="method1"
      ID_Pattern="3"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Move Method"
      SemanticObject_DiffEClass_eoperations="//@rulePattern_EClass.1/@diffeoperations.0 //@rulePattern_EClass.0/@diffeoperations.0"
      SemanticObject_EClass="cls1 cls2"
      SemanticObject_EOperation="method1"
      ID_Pattern="33"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
