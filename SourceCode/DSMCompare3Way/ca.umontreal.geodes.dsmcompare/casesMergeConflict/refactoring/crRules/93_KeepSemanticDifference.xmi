<?xml version="1.0" encoding="UTF-8"?>
<refactoringCRRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoringCRRuleMM="www.geodes.UdeM.edu/refactoringCRRuleMM"
    xsi:schemaLocation="www.geodes.UdeM.edu/refactoringCRRuleMM ../metaModels/refactoringCRRuleMM.ecore"
    name="KeepSemanticDifferenceTextBasedRules"
    priority="2">
  <constraints>Item(1,&quot;name&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(1,&quot;name&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;name&quot;) containsAnyOfValues &quot;Inline Method,Change Parameters&quot;</constraints>
  <rulePattern_Pattern_SemanticObject
      xsi:type="refactoringCRRuleMM:Pattern_SemanticConflict"
      ID_Pattern="1"
      conflict_kind="CONTRADICTING"
      conflict_Granularity="Semantic_Fine"/>
  <rulePattern_Pattern_SemanticObject
      xsi:type="refactoringCRRuleMM:Pattern_ConflictResolution"
      ID_Pattern="2"
      name="Keep semantic difference"
      ResolutionStrategy="Keep_Semantic_Difference"
      semanticconflicts="1"/>
  <rulePattern_Pattern_SemanticObject
      xsi:type="refactoringCRRuleMM:Pattern_ConflictResolution"
      ID_Pattern="3"
      isForbidden="true"
      name="Keep semantic difference"
      ResolutionStrategy="Keep_Semantic_Difference"
      semanticconflicts="1"/>
</refactoringCRRuleMM:Rule>
