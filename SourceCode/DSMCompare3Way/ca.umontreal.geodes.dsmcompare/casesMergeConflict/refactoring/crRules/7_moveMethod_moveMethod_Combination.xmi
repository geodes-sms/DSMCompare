    name="moveMethod_moveMethod_Combination"
    priority="1">
  <constraints>Item(2,&quot;eparameters&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;eparameters&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(7,&quot;eparameters&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(7,&quot;eparameters&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;methodBody&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;methodBody&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(7,&quot;methodBody&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(7,&quot;methodBody&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;eparameters&quot;) == Item(7,&quot;eparameters&quot;)</constraints>
  <constraints>Item(2,&quot;methodBody&quot;) == Item(7,&quot;methodBody&quot;)</constraints>
  <rulePattern_Pattern_SemanticObject
      xsi:type="refactoringCRRuleMM:Pattern_SemanticDiff"
