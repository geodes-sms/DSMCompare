<?xml version="1.0" encoding="UTF-8"?>
<refactoringDiffMM:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:refactoringDiffMM="www.geodes.UdeM.edu/refactoringDiffMM" name="p">
  <eclassifiers name="sub" esupertypes="super">
    <eoperations xsi:type="refactoringDiffMM:DiffEOperation" name="m" eparameters="i:int" methodBody="a b" diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="CONTRADICTING"/>
    <eoperations xsi:type="refactoringDiffMM:DiffEOperation" name="m_renamed" eparameters="i:int" methodBody="a b" diff_kind_Right="ADD"/>
    <diffeoperations diff_kind_Left="DELETE" diff_Group="DG-Move-2" eType="m"/>
  </eclassifiers>
  <eclassifiers name="super">
    <diffnested_classes diff_kind_Right="ADD" diff_Group="DG-Move-1" eType="sub"/>
  </eclassifiers>
