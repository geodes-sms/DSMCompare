<?xml version="1.0" encoding="UTF-8"?>
<refactoringDiffMM:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:refactoringDiffMM="www.geodes.UdeM.edu/refactoringDiffMM" name="pkg">
  <eclassifiers name="c1"/>
  <eclassifiers name="c2"/>
  <eclassifiers name="c3"/>
  <test name="t1" multi="c3 c2 c1">
    <diffmulti diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" diff_Group="DG-1" eType="c2"/>
    <diffmulti diff_kind_Left="DELETE" isMerged="true" diff_Group="DG-1" eType="c3"/>
  </test>
  <test name="t2"/>
  <test name="t3"/>
</refactoringDiffMM:EPackage>
