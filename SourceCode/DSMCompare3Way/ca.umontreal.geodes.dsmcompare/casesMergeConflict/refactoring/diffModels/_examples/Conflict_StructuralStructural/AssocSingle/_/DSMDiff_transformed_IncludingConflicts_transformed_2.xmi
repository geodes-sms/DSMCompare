<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:refactoringDiffMM="www.geodes.UdeM.edu/refactoringDiffMM">
  <refactoringDiffMM:EPackage name="pkg">
    <eclassifiers name="c1"/>
    <eclassifiers name="c2"/>
    <eclassifiers name="c3"/>
    <test name="t1" single="c1" multi="c3 c2 c1">
      <diffsingle diff_kind_Left="MODIFY" changeStatus="CONTRADICTING" diff_Group="DG-3" eType="c2"/>
      <diffsingle diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" diff_Group="DG-3" eType="c1"/>
      <diffsingle diff_kind_Right="MODIFY" changeStatus="CONTRADICTING" diff_Group="DG-3" eType="c3"/>
      <diffmulti diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" isMerged="true" diff_Group="DG-2" eType="c2"/>
      <diffmulti diff_kind_Left="DELETE" isMerged="true" diff_Group="DG-2" eType="c3"/>
    </test>
    <test name="t2" single="c1">
      <diffsingle diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" diff_Group="DG-1" eType="c1"/>
      <diffsingle diff_kind_Right="MODIFY" changeStatus="CONTRADICTING" diff_Group="DG-1" eType="c3"/>
    </test>
    <test name="t3">
      <diffsingle diff_kind_Left="ADD" changeStatus="CONTRADICTING" diff_Group="DG-4" eType="c2"/>
      <diffsingle diff_kind_Right="ADD" changeStatus="CONTRADICTING" diff_Group="DG-4" eType="c3"/>
    </test>
  </refactoringDiffMM:EPackage>
  <refactoringDiffMM:ConflictResolution name="Fine-Grained Conflict - DifftestAssociations_single" SemanticObject_DifftestAssociations_single="/0/@test.2/@diffsingle.0 /0/@test.2/@diffsingle.1"/>
  <refactoringDiffMM:ConflictResolution name="Fine-Grained Conflict - DifftestAssociations_single" SemanticObject_DifftestAssociations_single="/0/@test.0/@diffsingle.0 /0/@test.0/@diffsingle.2 /0/@test.0/@diffsingle.1"/>
  <refactoringDiffMM:ConflictResolution name="Fine-Grained Conflict - DifftestAssociations_multi" SemanticObject_DifftestAssociations_multi="/0/@test.0/@diffmulti.0" ResolutionType="Resolved" ResolutionStrategy="Keep_Left"/>
  <refactoringDiffMM:ConflictResolution name="Fine-Grained Conflict - DifftestAssociations_single" SemanticObject_DifftestAssociations_single="/0/@test.1/@diffsingle.1 /0/@test.1/@diffsingle.0"/>
</xmi:XMI>
