<?xml version="1.0" encoding="UTF-8"?>
<refactoringDiffMM:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:refactoringDiffMM="www.geodes.UdeM.edu/refactoringDiffMM" name="rfc">
  <eclassifiers name="cls1">
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="deleteLeft" etype="int" diff_kind_Left="DELETE" isMerged="true"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="modifyDelete" etype="int" diff_kind_Left="MODIFY" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" new_etype_Left="intLeft"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="deleteModify" etype="int" diff_kind_Left="DELETE" diff_kind_Right="MODIFY" changeStatus="CONTRADICTING" new_etype_Right="intRight"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="deleteBoth" etype="int" diff_kind_Left="DELETE" diff_kind_Right="DELETE" isMerged="true" changeStatus="EQUIVALENT"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="deleteRight" etype="int" diff_kind_Right="DELETE" isMerged="true"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="addBoth" diff_kind_Left="ADD" diff_kind_Right="ADD" isMerged="true" changeStatus="EQUIVALENT"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="addRight" diff_kind_Right="ADD" isMerged="true"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="addLeft" diff_kind_Left="ADD" isMerged="true"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="modifyBoth" etype="int" diff_kind_Left="MODIFY" diff_kind_Right="MODIFY" changeStatus="CONTRADICTING" new_etype_Left="intLeft" new_etype_Right="intRight" etypeChangeStatus="CONTRADICTING"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="modifyLeft" etype="int" diff_kind_Left="MODIFY" isMerged="true" new_etype_Left="intLeft"/>
    <eattributes xsi:type="refactoringDiffMM:DiffEAttribute" name="modifyRight" etype="int" diff_kind_Right="MODIFY" isMerged="true" new_etype_Right="intRight"/>
    <eoperations xsi:type="refactoringDiffMM:DiffEOperation" name="opModifyBoth" eparameters="parCA" etype="typeCA" methodBody="bodyCA" diff_kind_Left="MODIFY" diff_kind_Right="MODIFY" changeStatus="CONTRADICTING" new_eparameters_Left="parLeft" new_eparameters_Right="parCA" new_etype_Left="typeCA" new_methodBody_Left="bodyLeft" new_methodBody_Right="bodyRight" methodBodyChangeStatus="CONTRADICTING"/>
    <nested_classes xsi:type="refactoringDiffMM:DiffEClass" name="nc" diff_kind_Left="ADD" diff_kind_Right="ADD" isMerged="true" changeStatus="EQUIVALENT">
      <eoperations xsi:type="refactoringDiffMM:DiffEOperation" name="opNC" diff_kind_Left="ADD" isMerged="true"/>
      <diffinterfaces diff_kind_Left="ADD" isMerged="true" eType="If"/>
    </nested_classes>
    <diffesupertypes diff_kind_Left="ADD" diff_kind_Right="ADD" changeStatus="EQUIVALENT" isMerged="true" eType="cls2"/>
    <diffinterfaces diff_kind_Left="ADD" isMerged="true" eType="if1"/>
  </eclassifiers>
  <eclassifiers name="cls2" interfaces="if1">
    <diffesupertypes diff_kind_Right="ADD" isMerged="true" eType="cls2"/>
    <diffinterfaces diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="EQUIVALENT" isMerged="true" eType="if1"/>
  </eclassifiers>
  <eclassifiers name="cls3" esupertypes="cls1" interfaces="if1">
    <diffesupertypes diff_kind_Left="DELETE" isMerged="true" eType="cls1"/>
    <diffinterfaces diff_kind_Right="DELETE" isMerged="true" eType="if1"/>
  </eclassifiers>
  <interfaces name="if1" extends="e" packageName="p" esupertypes="if2">
    <diffesupertypes diff_kind_Left="DELETE" isMerged="true" eType="if2"/>
    <diffesupertypes diff_kind_Left="ADD" isMerged="true" eType="if1"/>
  </interfaces>
  <interfaces name="if2" esupertypes="if1">
    <diffesupertypes diff_kind_Right="ADD" isMerged="true" eType="if3"/>
    <diffesupertypes diff_kind_Right="DELETE" isMerged="true" eType="if1"/>
  </interfaces>
  <interfaces name="if3" esupertypes="if2 if1">
    <diffesupertypes diff_kind_Left="ADD" isMerged="true" eType="If"/>
    <diffesupertypes diff_kind_Left="ADD" isMerged="true" eType="if3"/>
    <diffesupertypes diff_kind_Right="DELETE" isMerged="true" eType="if2"/>
    <diffesupertypes diff_kind_Right="DELETE" isMerged="true" eType="if1"/>
  </interfaces>
  <interfaces xsi:type="refactoringDiffMM:DiffInterface" name="If" diff_kind_Left="ADD" isMerged="true"/>
  <test name="t1" single="cls1" multi="cls1">
    <diffsingle diff_kind_Left="MODIFY" changeStatus="CONTRADICTING" eType="cls2"/>
    <diffsingle diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" eType="cls1"/>
    <diffmulti diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="EQUIVALENT" isMerged="true" eType="cls1"/>
    <diffmulti diff_kind_Left="ADD" isMerged="true" eType="cls2"/>
  </test>
  <test name="t2" single="cls2">
    <diffsingle diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" eType="cls2"/>
    <diffsingle diff_kind_Right="MODIFY" changeStatus="CONTRADICTING" eType="cls3"/>
    <diffmulti diff_kind_Right="ADD" isMerged="true" eType="cls3"/>
  </test>
  <test name="t3" single="cls1" multi="cls1">
    <diffsingle diff_kind_Left="MODIFY" changeStatus="CONTRADICTING" eType="cls3"/>
    <diffsingle diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" eType="cls1"/>
    <diffsingle diff_kind_Right="MODIFY" changeStatus="CONTRADICTING" eType="cls2"/>
    <diffmulti diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="EQUIVALENT" isMerged="true" eType="cls1"/>
    <diffmulti diff_kind_Left="ADD" isMerged="true" eType="cls3"/>
    <diffmulti diff_kind_Right="ADD" isMerged="true" eType="cls2"/>
  </test>
</refactoringDiffMM:EPackage>
