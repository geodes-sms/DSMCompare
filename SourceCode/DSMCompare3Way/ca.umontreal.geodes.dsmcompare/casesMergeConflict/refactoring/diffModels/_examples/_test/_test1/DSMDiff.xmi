<?xml version="1.0" encoding="UTF-8"?>
<refactoringDiffMM:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:refactoringDiffMM="www.geodes.UdeM.edu/refactoringDiffMM" name="rfc">
  <eclassifiers name="cls1"/>
  <eclassifiers name="cls2"/>
  <eclassifiers name="cls3"/>
  <test name="t3" multi="cls1">
    <diffmulti diff_kind_Left="ADD" isMerged="true" eType="cls2"/>
    <diffmulti diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="EQUIVALENT" isMerged="true" eType="cls1"/>
    <diffmulti diff_kind_Right="ADD" isMerged="true" eType="cls3"/>
  </test>
</refactoringDiffMM:EPackage>
