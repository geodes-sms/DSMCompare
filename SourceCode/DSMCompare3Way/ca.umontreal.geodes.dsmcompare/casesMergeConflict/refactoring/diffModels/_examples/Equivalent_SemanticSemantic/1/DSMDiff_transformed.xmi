  <domainspecificdiffs name="mergeMetaClassAttr" DomainSpecificDiff_EAttribute="attr2 attr1" DomainSpecificDiff_EClass="root cls3 cls2 cls1" DomainSpecificDiff_EPackage="rfc" DomainSpecificDiff_DiffEClass_eattributes="//@eclassifiers.1/@diffeattributes.1 //@eclassifiers.1/@diffeattributes.0" DomainSpecificDiff_DiffEClass_esupertypes="//@eclassifiers.1/@diffesupertypes.0"/>
