<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoringDiffMM="www.geodes.UdeM.edu/refactoringDiffMM"
    xsi:schemaLocation="www.geodes.UdeM.edu/refactoringDiffMM ../metaModels/refactoringDiffMM.ecore">
  <refactoringDiffMM:EPackage
      name="pkg">
    <eclassifiers
        name="a">
      <diffeoperations
          diff_kind_Left="ADD"
          changeStatus="MERGE_DELETE"
          eType="op1"/>
    </eclassifiers>
    <eclassifiers
        name="b"
        esupertypes="a">
      <eoperations
          name="op1"/>
      <diffeoperations
          diff_kind_Left="DELETE"
          filter="true"
          eType="op1"/>
      <diffesupertypes
          changeStatus="MERGE_ADD"
          eType="generated"/>
      <diffesupertypes
          changeStatus="MERGE_DELETE"
          eType="a"/>
    </eclassifiers>
    <eclassifiers
        name="c">
      <diffesupertypes
          diff_kind_Right="ADD"
          isMerged="true"
          diff_Group="DG-1"
          eType="a"/>
    </eclassifiers>
    <eclassifiers
        xsi:type="refactoringDiffMM:DiffEClass"
        name="generated"
        changeStatus="MERGE_ADD">
      <diffeoperations
          changeStatus="MERGE_ADD"
          eType="op1"/>
      <diffesupertypes
          changeStatus="MERGE_ADD"
          eType="a"/>
    </eclassifiers>
  </refactoringDiffMM:EPackage>
  <refactoringDiffMM:SemanticDiff
      name="Pull-up Method"
      SemanticObject_DiffEClass_eoperations="/0/@eclassifiers.0/@diffeoperations.0 /0/@eclassifiers.1/@diffeoperations.0"
      SemanticObject_EClass="a b"
      SemanticObject_EOperation="op1"
      SemanticObject_EPackage="pkg"
      author="LEFT"/>
  <refactoringDiffMM:SemanticDiff
      name="Extract Superclass"
      SemanticObject_DiffEClass_esupertypes="/0/@eclassifiers.2/@diffesupertypes.0"
      SemanticObject_EClass="c"
      SemanticObject_EPackage="pkg"
      author="RIGHT"/>
  <refactoringDiffMM:SemanticConflict
      name="Pull-up Method - Add Inheritance"
      SemanticObject_DiffEClass="generated"
      SemanticObject_EClass="c a b"
      conflict_kind="CONTRADICTING"
      conflict_Granularity="Semantic_Fine"
      semanticdiffs="/1"/>
  <refactoringDiffMM:ConflictResolution
      name="Pull-up Method - Add Inheritance"
      ResolutionType="Resolved"
      ResolutionStrategy="Apply_A_User_Defined_Resolution_Pattern"
      semanticconflicts="/3"/>
  <refactoringDiffMM:ConflictResolution
      name="Keep semantic difference"
      ResolutionStrategy="Keep_Semantic_Difference"
      semanticconflicts="/3"/>
</xmi:XMI>
