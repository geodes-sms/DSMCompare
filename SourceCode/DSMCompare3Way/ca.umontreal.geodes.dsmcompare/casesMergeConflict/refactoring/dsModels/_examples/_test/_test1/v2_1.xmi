<?xml version="1.0" encoding="UTF-8"?>
<refactoring:EPackage
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring="www.geodes.UdeM.edu/refactoring"
    xsi:schemaLocation="www.geodes.UdeM.edu/refactoring ../metaModels/refactoring.ecore"
    name="rfc">
  <eclassifiers
      name="cls1"
      esupertypes="cls2">
    <eattributes
        name="deleteLeft"
        etype="int"/>
    <eattributes
        name="modifyLeft"
        etype="int"/>
    <eattributes
        name="modifyRight"
        etype="intRight"/>
    <eattributes
        name="modifyBoth"
        etype="intRight"/>
    <eattributes
        name="deleteModify"
        etype="intRight"/>
    <eattributes
        name="addBoth"/>
    <eattributes
        name="addRight"/>
    <eoperations
        name="opModifyBoth"
        etype="typeCA"
        methodBody="bodyRight"/>
    <nested_classes
        name="nc"/>
  </eclassifiers>
  <eclassifiers
      name="cls2"
      esupertypes="cls2"/>
  <eclassifiers
      name="cls3"
      esupertypes="cls1"/>
  <interfaces
      name="if1"
      extends="e"
      packageName="p"
      esupertypes="if2"/>
  <interfaces
      name="if2"
      esupertypes="if3"/>
  <interfaces
      name="if3"/>
  <test name="t1"/>
  <test name="t2"
      single="cls3"
      multi="cls3"/>
  <test name="t3"
      single="cls2"
      multi="cls2"/>
</refactoring:EPackage>
