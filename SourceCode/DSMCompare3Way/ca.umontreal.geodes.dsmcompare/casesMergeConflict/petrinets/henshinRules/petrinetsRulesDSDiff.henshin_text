//>>>>>>>>>>>>>>>>>>>> UNITS

	unit unitSequntialStar(){
		unitRemoveImplicitPlace_equalStar()
		unitRemoveImplicitPlace_leftStar()
		unitRemoveImplicitPlace_rightStar()
		unitRemoveEfcStructures_equalStar()
		unitRemoveEfcStructures_leftStar()
		unitRemoveEfcStructures_rightStar()
		unitRemoveTPCrossStructures_equalStar()
		unitRemoveTPCrossStructures_leftStar()
		unitRemoveTPCrossStructures_rightStar()
	}
	unit unitRemoveImplicitPlace_equalStar(){
		while{
			RemoveImplicitPlace_equal()
		}
	}
	unit unitRemoveImplicitPlace_leftStar(){
		while{
			RemoveImplicitPlace_left()
		}
	}
	unit unitRemoveImplicitPlace_rightStar(){
		while{
			RemoveImplicitPlace_right()
		}
	}
