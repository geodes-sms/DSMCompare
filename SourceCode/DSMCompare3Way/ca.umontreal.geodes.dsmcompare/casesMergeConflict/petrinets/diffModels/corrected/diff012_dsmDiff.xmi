<?xml version="1.0" encoding="UTF-8"?>
<petrinetsDiffMM:PetriNet
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:petrinetsDiffMM="www.geodes.UdeM.edu/petrinetsDiffMM"
    name="pn">
  <places id="1"
      name="Pending"
      tokens="2"
      transitions="7"/>
  <places id="4"
      name="OnlinePayReceived"
      transitions="10"/>
  <places id="5"
      name="CODPayReceived"
      transitions="11"/>
  <places id="6"
      name="Completed"/>
  <places xsi:type="petrinetsDiffMM:DiffPlace"
      id="2"
      name="OnlineChoice"
      diff_kind_Left="MODIFY"
      new_name_Left="PayChoice">
    <difftransitions
        diff_kind_Right="ADD"
        diff_Group="DG-6"
        eType="12"/>
    <difftransitions
        diff_kind_Right="DELETE"
        diff_Group="DG-6"
        eType="8"/>
    <difftransitions
        diff_kind_Right="DELETE"
        diff_Group="DG-6"
        eType="9"/>
  </places>
  <places xsi:type="petrinetsDiffMM:DiffPlace"
      id="13"
      name="PayChoice"
      diff_kind_Right="ADD">
    <difftransitions
        diff_kind_Right="ADD"
        diff_Group="DG-5"
        eType="8"/>
    <difftransitions
        diff_kind_Right="ADD"
        diff_Group="DG-5"
        eType="9"/>
  </places>
  <places xsi:type="petrinetsDiffMM:DiffPlace"
      id="3"
      name="CODChoice"
      diff_kind_Left="DELETE"
      changeStatus="CONTRADICTING">
    <difftransitions
        diff_kind_Left="DELETE"
        diff_kind_Right="DELETE"
        changeStatus="EQUIVALENT"
        diff_Group="DG-3"
        eType="8"/>
    <difftransitions
        diff_kind_Left="DELETE"
        diff_kind_Right="DELETE"
        changeStatus="EQUIVALENT"
        diff_Group="DG-3"
        eType="9"/>
    <difftransitions
        diff_kind_Right="ADD"
        changeStatus="CONTRADICTING"
        diff_Group="DG-3"
        eType="12"/>
  </places>
  <transitions
      id="7"
      name="receive"
      places="2">
    <diffplaces
        diff_kind_Left="DELETE"
        diff_Group="DG-2"
        eType="3"/>
  </transitions>
  <transitions
      id="8"
      name="payOnline"
      places="4"/>
  <transitions
      id="9"
      name="payCOD"
      places="5"/>
  <transitions
      id="10"
      name="checkCredit"
      places="6"/>
  <transitions
      id="11"
      name="checkCash"
      places="6"/>
  <transitions
      xsi:type="petrinetsDiffMM:DiffTransition"
      id="12"
      name="choosePay"
      diff_kind_Right="ADD">
    <diffplaces
        diff_kind_Right="ADD"
        diff_Group="DG-1"
        eType="13"/>
  </transitions>
</petrinetsDiffMM:PetriNet>
