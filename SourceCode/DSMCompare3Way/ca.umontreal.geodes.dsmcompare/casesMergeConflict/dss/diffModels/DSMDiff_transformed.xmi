          <diffsubFactors diff_kind_Left="DELETE" eType="/0/@model/@rootFactor/@subFactors.0/@subFactors.7"/>
        </subFactors>
        <subFactors xsi:type="dssmmDiffMM:DiffCompositeFactor" FactorID="195121" Name="Financials" Descr=" The Financials module provides features and functions that allow accountants and financial managers to ensure financial transactions are tracked and properly recorded, and that this information is available via reports and other data retrieval tools. Traditionally, this module includes the general ledger, accounts payable, fixed assets, cost accounting, cash management, accounts receivable, and financial reporting submodules" GW="0.125" LW="0.125" Hierarchy="1" MasterFactorID="195121" diff_kind_Left="MODIFY" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" new_LW_Left="0.140625"/>
        <subFactors xsi:type="dssmmDiffMM:DiffCompositeFactor" FactorID="196138" Name="Human Resources" Descr="Human Resources encompasses all the applications necessary for handling personnel-related tasks for corporate managers and individual employees. Modules will include Personnel Management, Benefit Management, Payroll Management, Employee Self Service, Data Warehousing, Health and Safety, Workforce Management, Training, and Product Technology" GW="0.125" LW="0.125" Hierarchy="2" MasterFactorID="196138" diff_kind_Right="DELETE">
