              <subFactors xsi:type="dssmmDiffMM:DiffLeafFactor" FactorID="196526" Name="Users can assign routing workflows by product or part in different ways, such as flow and pull, subcontract, etc." Descr="The ability to assign a product's workflow by the product itself or by a component of the product and then prioritizing its pull based on demand (orders)." GW="3.4E-5" LW="0.016949" Hierarchy="3.2.1.1" MasterFactorID="196526" diff_kind_Left="MODIFY" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" new_Hierarchy_Left="2.2.1.1"/>
