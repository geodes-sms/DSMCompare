          <diffsubFactors diff_kind_Left="DELETE" eType="/0/@model/@rootFactor/@subFactors.0/@subFactors.2"/>
          <diffsubFactors diff_kind_Left="ADD" eType="/0/@model/@rootFactor/@subFactors.0/@subFactors.23"/>
          <diffsubFactors diff_kind_Left="DELETE" eType="/0/@model/@rootFactor/@subFactors.0/@subFactors.23"/>
