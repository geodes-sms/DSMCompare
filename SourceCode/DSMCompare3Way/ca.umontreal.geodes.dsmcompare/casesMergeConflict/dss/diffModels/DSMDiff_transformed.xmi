        <subFactors xsi:type="dssmmDiffMM:DiffCompositeFactor" FactorID="198187" Name="Sales Management" Descr="Sales Management encompasses a group of applications that automates the data entry process of customer orders and keeps track of the status of orders. It involves order entry, order tracing and status reporting, pricing, invoicing, etc. It also provides a basic functionality for lead tracking, customer information, quote processing, pricing &amp; rebates, etc." GW="0.125" LW="0.125" Hierarchy="7" MasterFactorID="198187" diff_kind_Right="DELETE">
