            <subFactors xsi:type="dssmmDiffMM:DiffCompositeFactor" FactorID="195248" Name="Journal Entry and Reporting" Descr="The accounting department is typically responsible for recording all transactions in the company in the journal (GL). All of the criteria that fall Journal Entry and Reporting relate to various ways to record journal transactions. For example payroll is an AP item. As paychecks are cut the AP items need to be reconciled with the cash outflow. A software feature might be the automatic reconciliation of payroll deductions when paychecks are issued (as opposed to having an accountant have to key the transactions by hand)." GW="0.001263" LW="0.090909" Hierarchy="1.1.5" MasterFactorID="195248" diff_kind_Left="MODIFY" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" new_Hierarchy_Left="1.5.5"/>
