            <subFactors xsi:type="dssmmDiffMM:DiffCompositeFactor" FactorID="196044" Name="Online Requirements" Descr=" " GW="0.006944" LW="0.5" Hierarchy="1.8.1" MasterFactorID="196044" diff_kind_Left="MODIFY" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" new_Hierarchy_Left="1.6.1"/>
          </subFactors>
          <subFactors xsi:type="dssmmDiffMM:DiffCompositeFactor" FactorID="196043" Name="Financial Reporting" Descr="Financial reporting enables robust analysis of company performance through delivered reports. These reports will allow individual business units to view their financial information, while parent companies can roll up all business subsidiaries and view the consolidated information. Additionally, solutions should provide user generated reporting tools that are easy to use and provide sufficient depth of and access to the financial data to permit comprehensive analysis." GW="0.013889" LW="0.111111" Hierarchy="1.8" MasterFactorID="196043" diff_kind_Left="MODIFY" diff_kind_Right="DELETE" changeStatus="CONTRADICTING" new_LW_Left="0.123077"/>
          <subFactors xsi:type="dssmmDiffMM:DiffCompositeFactor" FactorID="195122" Name="General Ledger" Descr="General ledger keeps centralized charts of accounts and corporate financial balances. It supports all aspects of the business accounting process. In this module, financial accounting transactions are posted, processed, summarized, and reported. It maintains a complete audit trail of transactions and enables individual business units to view their financial information, while parent companies can roll up all business subsidiaries and view the consolidated information." GW="0.017308" LW="0.123077" Hierarchy="1.5" MasterFactorID="195122" diff_kind_Left="DELETE">
            <scores xsi:type="dssmmDiffMM:DiffScore" Descr="0.0" Comment="" score_option="/0/@options.2" diff_kind_Right="DELETE">
              <diffscore_option diff_kind_Right="ADD" eType="/0/@options.2"/>
