          <subFactors xsi:type="dssmmDiffMM:DiffCompositeFactor" FactorID="195931" Name="Accounts Receivable" Descr="Accounts receivable tracks payments due to a company from its customers. It contains tools to control and expedite the receipt of money from the entry of a sales order to posting payments received. The software should support the following functionality: AR company policies and procedures; customers/voucher master data; bill processing and aging analysis; credit management; cash/payment application, receipt processing; journal voucher processing; AR ledger posting; multicurrency accounting and conversions; AR transactions and controls; and AR reporting." GW="0.013889" LW="0.111111" Hierarchy="1.7" MasterFactorID="195931" diff_kind_Left="DELETE" diff_kind_Right="DELETE" changeStatus="EQUIVALENT"/>
