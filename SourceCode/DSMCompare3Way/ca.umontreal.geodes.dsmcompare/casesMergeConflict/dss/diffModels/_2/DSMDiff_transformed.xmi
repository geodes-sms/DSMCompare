<?xml version="1.0" encoding="ASCII"?>
<xmi:XMI xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:dssmmDiffMM="http://www.zadahmad.org/dsvcs/dssmmDiffMM" xsi:schemaLocation="http://www.zadahmad.org/dsvcs/dssmmDiffMM ../metaModels/DSSMMDiffMM.ecore">
  <dssmmDiffMM:DecisionSupport Name="ds">
    <model ModelID="999" Name="m1">
      <rootFactor xsi:type="dssmmDiffMM:CompositeFactor" FactorID="1" Name="">
        <subFactors xsi:type="dssmmDiffMM:CompositeFactor" FactorID="11">
          <subFactors xsi:type="dssmmDiffMM:CompositeFactor" FactorID="111">
            <subFactors xsi:type="dssmmDiffMM:LeafFactor" FactorID="1111" Name="1111"/>
            <subFactors xsi:type="dssmmDiffMM:LeafFactor" FactorID="1112" Name="1112"/>
          </subFactors>
          <diffsubFactors diff_kind_Right="ADD" eType="/0/@model/@rootFactor/@subFactors.0/@subFactors.0/@subFactors.0"/>
        </subFactors>
        <subFactors xsi:type="dssmmDiffMM:CompositeFactor" FactorID="12">
          <subFactors xsi:type="dssmmDiffMM:CompositeFactor" FactorID="121">
            <subFactors xsi:type="dssmmDiffMM:CompositeFactor" FactorID="1211">
              <diffsubFactors diff_kind_Right="ADD" eType="/0/@model/@rootFactor/@subFactors.0/@subFactors.0/@subFactors.1"/>
            </subFactors>
            <diffsubFactors diff_kind_Right="ADD" eType="/0/@model/@rootFactor/@subFactors.1/@subFactors.1"/>
          </subFactors>
          <subFactors xsi:type="dssmmDiffMM:LeafFactor" FactorID="1212" Name="1212"/>
        </subFactors>
      </rootFactor>
    </model>
  </dssmmDiffMM:DecisionSupport>
  <dssmmDiffMM:SemanticDiff name="Pull-up hierarchy" SemanticObject_DiffCompositeFactor_subFactors="/0/@model/@rootFactor/@subFactors.0/@diffsubFactors.0" SemanticObject_Factor="/0/@model/@rootFactor/@subFactors.0 /0/@model/@rootFactor/@subFactors.0/@subFactors.0 /0/@model/@rootFactor/@subFactors.0/@subFactors.0/@subFactors.0"/>
  <dssmmDiffMM:SemanticDiff name="Push-down hierarchy" SemanticObject_DiffCompositeFactor_subFactors="/0/@model/@rootFactor/@subFactors.1/@subFactors.0/@diffsubFactors.0" SemanticObject_Factor="/0/@model/@rootFactor/@subFactors.1 /0/@model/@rootFactor/@subFactors.1/@subFactors.0 /0/@model/@rootFactor/@subFactors.1/@subFactors.1"/>
  <dssmmDiffMM:SemanticDiff name="Move factor"/>
</xmi:XMI>
