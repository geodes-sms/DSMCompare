<?xml version="1.0" encoding="UTF-8"?>
<dssmm2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:dssmm2WayRuleMM="http://www.zadahmad.org/dsvcs/dssmm2WayRuleMM"
    xsi:schemaLocation="http://www.zadahmad.org/dsvcs/dssmm2WayRuleMM ../metaModels/DSSMM2WayRuleMM.ecore#/1"
    name="splitChildrenCF">
  <constraints>Item(2,&quot;FactorID&quot;) == Item(4,&quot;FactorID&quot;) </constraints>
  <rulePattern_Factor
      xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
      Name=""
      ID_Pattern="10">
    <diffsubFactors
        xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
        diff_kind="ADD"
        eType="//@rulePattern_Factor.1/@subFactors.0"
        ID_Pattern="11"/>
  </rulePattern_Factor>
  <rulePattern_Factor
      xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor"
      Name=""
      diff_kind="DELETE"
      ID_Pattern="20">
    <subFactors
        xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
        Name="21"
        ID_Pattern="21"/>
    <subFactors
        xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
        Name="22"
        ID_Pattern="22"/>
    <diffsubFactors
        xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
        diff_kind="DELETE"
        eType="//@rulePattern_Factor.1/@subFactors.0"
        ID_Pattern="23"
        filter="true"/>
    <diffsubFactors
        xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
        diff_kind="DELETE"
        eType="//@rulePattern_Factor.1/@subFactors.1"
        ID_Pattern="24"
        filter="true"/>
  </rulePattern_Factor>
  <rulePattern_Factor
      xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
      Name=""
      ID_Pattern="30">
    <diffsubFactors
        xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
        diff_kind="ADD"
        eType="//@rulePattern_Factor.1/@subFactors.1"
        ID_Pattern="31"/>
  </rulePattern_Factor>
  <rulePattern_Factor
      xsi:type="dssmm2WayRuleMM:Pattern_DiffLeafFactor"
      Name="4"
      diff_kind="ADD"
      ID_Pattern="40"/>
  <rulePattern_SemanticObject
      xsi:type="dssmm2WayRuleMM:Pattern_SemanticDiff"
      name="Split children"
      SemanticObject_DiffCompositeFactor_subFactors="//@rulePattern_Factor.0/@diffsubFactors.0 //@rulePattern_Factor.2/@diffsubFactors.0"
      SemanticObject_Factor="//@rulePattern_Factor.0 //@rulePattern_Factor.2 //@rulePattern_Factor.1 //@rulePattern_Factor.3"
      ID_Pattern="50"/>
</dssmm2WayRuleMM:Rule>
