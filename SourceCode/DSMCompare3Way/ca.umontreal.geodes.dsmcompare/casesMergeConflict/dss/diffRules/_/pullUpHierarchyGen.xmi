<?xml version="1.0" encoding="ASCII"?>
<dssmm2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:dssmm2WayRuleMM="http://www.zadahmad.org/dsvcs/dssmm2WayRuleMM"
    name="pullUpHierarchyGen">
  <pattern xsi:type="dssmm2WayRuleMM:Pattern_DecisionSupport">
    <model xsi:type="dssmm2WayRuleMM:Pattern_Model"
        ModelID="999"
        Name="m1"
        ID_Pattern="1">
      <rootFactor
          xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
          FactorID="1"
          Name=""
          ID_Pattern="3">
        <subFactors
            xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
            FactorID="11"
            ID_Pattern="4">
          <subFactors
              xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
              FactorID="111"
              ID_Pattern="5">
            <subFactors
                xsi:type="dssmm2WayRuleMM:Pattern_LeafFactor"
                FactorID="1111"
                ID_Pattern="7"/>
            <diffsubFactors
                xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
                diff_kind="DELETE"
                eType="//@pattern/@model/@rootFactor/@subFactors.0/@subFactors.0/@subFactors.0"
                ID_Pattern="8"
                filter="true"/>
          </subFactors>
          <diffsubFactors
              xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
              diff_kind="ADD"
              eType="//@pattern/@model/@rootFactor/@subFactors.0/@subFactors.0/@subFactors.0"
              ID_Pattern="6"/>
        </subFactors>
      </rootFactor>
    </model>
    <domainspecificdiffs
        xsi:type="dssmm2WayRuleMM:Pattern_DomainSpecificDiff"
        name="Pull-up Hierarchy"
        DomainSpecificDiff_DecisionSupport="//@pattern"
        DomainSpecificDiff_Model="//@pattern/@model"
        DomainSpecificDiff_Factor="//@pattern/@model/@rootFactor //@pattern/@model/@rootFactor/@subFactors.0 //@pattern/@model/@rootFactor/@subFactors.0/@subFactors.0 //@pattern/@model/@rootFactor/@subFactors.0/@subFactors.0/@subFactors.0"
        DomainSpecificDiff_DiffCompositeFactor_subFactors="//@pattern/@model/@rootFactor/@subFactors.0/@diffsubFactors.0"
        ID_Pattern="2"/>
  </pattern>
</dssmm2WayRuleMM:Rule>
