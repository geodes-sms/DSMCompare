<?xml version="1.0" encoding="UTF-8"?>
<dssmm2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:dssmm2WayRuleMM="http://www.zadahmad.org/dsvcs/dssmm2WayRuleMM"
    xsi:schemaLocation="http://www.zadahmad.org/dsvcs/dssmm2WayRuleMM ../metaModels/DSSMM2WayRuleMM.ecore#/1"
    name="moveFactor">
  <constraints>Item(5,&quot;FactorID&quot;) == Item(6,&quot;FactorID&quot;)</constraints>
  <pattern xsi:type="dssmm2WayRuleMM:Pattern_DecisionSupport">
    <model xsi:type="dssmm2WayRuleMM:Pattern_Model"
        ID_Pattern="1">
      <rootFactor
          xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
          Name="root"
          ID_Pattern="2">
        <subFactors
            xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
            Name="C1"
            ID_Pattern="3">
          <subFactors
              xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
              Name="C2"
              ID_Pattern="4">
            <subFactors
                xsi:type="dssmm2WayRuleMM:Pattern_DiffLeafFactor"
                Name="LDeleted"
                diff_kind="ADD"
                ID_Pattern="5"/>
          </subFactors>
          <subFactors
              xsi:type="dssmm2WayRuleMM:Pattern_DiffLeafFactor"
              Name="LAdded"
              diff_kind="DELETE"
              ID_Pattern="6"
              filter="true"/>
        </subFactors>
      </rootFactor>
    </model>
    <domainspecificdiffs
        xsi:type="dssmm2WayRuleMM:Pattern_DomainSpecificDiff"
        name="Move Factor"
        ID_Pattern="7"/>
  </pattern>
</dssmm2WayRuleMM:Rule>
