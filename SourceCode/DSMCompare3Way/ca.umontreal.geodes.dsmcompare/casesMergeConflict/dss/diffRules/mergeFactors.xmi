<?xml version="1.0" encoding="UTF-8"?>
<dssmm2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:dssmm2WayRuleMM="http://www.zadahmad.org/dsvcs/dssmm2WayRuleMM"
    xsi:schemaLocation="http://www.zadahmad.org/dsvcs/dssmm2WayRuleMM ../metaModels/DSSMM2WayRuleMM.ecore#/1"
    name="mergeFactors">
  <rulePattern_Factor
      xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
      Name="From"
      ID_Pattern="10">
    <subFactors
        xsi:type="dssmm2WayRuleMM:Pattern_LeafFactor"
        Name="11"
        ID_Pattern="11"/>
    <diffsubFactors
        xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
        diff_kind="DELETE"
        eType="//@rulePattern_Factor.0/@subFactors.0"
        ID_Pattern="12"
        filter="true"/>
  </rulePattern_Factor>
  <rulePattern_Factor
      xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor"
      Name="To"
      diff_kind="ADD"
      ID_Pattern="20">
    <diffsubFactors
        xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
        diff_kind="ADD"
        eType="//@rulePattern_Factor.0/@subFactors.0"
        ID_Pattern="21"/>
    <diffsubFactors
        xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
        diff_kind="ADD"
        eType="//@rulePattern_Factor.2/@subFactors.0"
        ID_Pattern="22"/>
  </rulePattern_Factor>
  <rulePattern_Factor
      xsi:type="dssmm2WayRuleMM:Pattern_CompositeFactor"
      Name="From"
      ID_Pattern="30">
    <subFactors
        xsi:type="dssmm2WayRuleMM:Pattern_LeafFactor"
        Name="31"
        ID_Pattern="31"/>
    <diffsubFactors
        xsi:type="dssmm2WayRuleMM:Pattern_DiffCompositeFactor_subFactors"
        diff_kind="DELETE"
        eType="//@rulePattern_Factor.2/@subFactors.0"
        ID_Pattern="32"
        filter="true"/>
  </rulePattern_Factor>
  <rulePattern_SemanticObject
      xsi:type="dssmm2WayRuleMM:Pattern_SemanticDiff"
      name="Merge factors"
      SemanticObject_DiffCompositeFactor_subFactors="//@rulePattern_Factor.1/@diffsubFactors.0 //@rulePattern_Factor.1/@diffsubFactors.1"
      SemanticObject_Factor="//@rulePattern_Factor.0 //@rulePattern_Factor.2 //@rulePattern_Factor.0/@subFactors.0 //@rulePattern_Factor.2/@subFactors.0 //@rulePattern_Factor.1"
      ID_Pattern="40"/>
</dssmm2WayRuleMM:Rule>
