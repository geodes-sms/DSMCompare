              <scores Descr="Modification" Comment="" score_option="//@options.5"/>
            </subFactors>
            <subFactors xsi:type="dssmm:LeafFactor" FactorID="196857" Name="MSDS formats can be changed to formats determined by the user or as mandated by OSHA, NIOSH, WHMIS, the European Chemicals Bureau, or CHIP" Descr="The Occupational Safety and Health Administration (OSHA) is a US federal body responsible for the ensuring companies provide a healthy and safe work environment. The National Institute for Occupational Safety and Health (NIOSH) is another US institute, which is a part of the Centers for Disease Control and Prevention (CDC). Workplace Hazardous Materials Information System (WHMIS) is Canadian legislation governing the same areas. The Chemicals Hazard and Information Packaging for Supply Regulations (CHIP) is the British regulatory body. All of these organizations have specific requirements for material safety data sheets (MSDSs)." GW="7.6E-5" LW="0.038462" Hierarchy="2.2.8.19" MasterFactorID="196857">
              <scores Descr="Third Party Support" Comment="" score_option="//@options.0"/>
