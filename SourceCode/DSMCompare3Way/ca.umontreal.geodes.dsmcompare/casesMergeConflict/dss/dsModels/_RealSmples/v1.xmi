            <subFactors xsi:type="dssmm:LeafFactor" FactorID="196856" Name="MSDS meets ANSI standard format" Descr="The American National Standards Institute (ANSI) is a US organization that promotes standards based on consensus. It is a private, not-for-profit organization. It has a sixteen part format for material safety data sheet (MSDS) which covers a number of areas including chemical identity and characteristics, manufacturer, hazardous ingredients, fire and explosion hazard data, etc." GW="7.6E-5" LW="0.038462" Hierarchy="2.2.8.18" MasterFactorID="196856">
              <scores Descr="Third Party Support" Comment="" score_option="//@options.0"/>
