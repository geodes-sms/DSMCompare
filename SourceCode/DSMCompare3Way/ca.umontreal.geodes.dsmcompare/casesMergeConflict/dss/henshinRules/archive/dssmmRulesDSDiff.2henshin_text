	unit unitSequntialStar(){
		unitpullUpHierarchyStar()
		unitpullUpHierarchy2Star()
	}
	unit unitpullUpHierarchyStar(){
		while{
			pullUpHierarchy()
		}
	}
	unit unitpullUpHierarchy2Star(){
		while{
			pullUpHierarchy2()
