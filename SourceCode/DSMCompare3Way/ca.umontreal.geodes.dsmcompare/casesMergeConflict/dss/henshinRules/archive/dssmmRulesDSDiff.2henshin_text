ePackageImport  dssmmDiffMM

		rule pullUpHierarchy(VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString,VAR n6diff_kind_Left:EString,VAR n6diff_kind_Right:EString,VAR n5FactorID:EInt,VAR n6FactorID:EInt,VAR n6Hierarchy:EString,VAR n5Hierarchy:EString)
		{
			graph
			{
				 preserve			node n0:DecisionSupport			      		
				 preserve			node n1:Model			      		
				 preserve			node n2:CompositeFactor			      		
				 preserve			node n3:CompositeFactor			      		
				 preserve			node n4:CompositeFactor			      		
				 preserve			node n5:DiffLeafFactor{
					preserve diff_kind_Left = n5diff_kind_Left
					preserve diff_kind_Right = n5diff_kind_Right
					preserve FactorID =  n5FactorID
					preserve Hierarchy =  n5Hierarchy
				}			      		
				 delete				node n6:DiffLeafFactor{
					delete diff_kind_Left = n6diff_kind_Left
					delete diff_kind_Right = n6diff_kind_Right
					delete FactorID =  n6FactorID
					delete Hierarchy =  n6Hierarchy
				}
				 create				node n7:DomainSpecificDiff{
					create name = "\"Pull-up Hierarchy\""
				}
			edges[
			  		(preserve	n0->n1:model),
			  		(create		n0->n7:domainspecificdiffs),
			  		(preserve	n1->n2:rootFactor),
			  		(preserve	n2->n3:subFactors),
			  		(preserve	n3->n4:subFactors),
			  		(delete		n3->n6:subFactors),
			  		(preserve	n4->n5:subFactors)
	      		 ]
			}
			conditions [((n5FactorID == n6FactorID) AND ("n6Hierarchy.contains(n5Hierarchy)" == 'true') AND (n5diff_kind_Left == "\"DELETE\"") AND (n6diff_kind_Left == "\"ADD\"")) OR ((n5FactorID == n6FactorID) AND ("n6Hierarchy.contains(n5Hierarchy)" == 'true') AND (n5diff_kind_Right == "\"DELETE\"") AND (n6diff_kind_Right == "\"ADD\""))] 
		}
		
		rule pullUpHierarchy2(VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString,VAR n6diff_kind_Left:EString,VAR n6diff_kind_Right:EString,VAR n5FactorID:EInt,VAR n6FactorID:EInt,VAR n6Hierarchy:EString,VAR n5Hierarchy:EString)
		{
			graph
			{
				 preserve			node n0:DecisionSupport				      		
				 preserve			node n3:CompositeFactor			      		
				 preserve			node n4:CompositeFactor			      		
				 preserve			node n5:DiffLeafFactor{
					preserve diff_kind_Left = n5diff_kind_Left
					preserve diff_kind_Right = n5diff_kind_Right
					preserve FactorID =  n5FactorID
					preserve Hierarchy =  n5Hierarchy
				}			      		
				 delete				node n6:DiffLeafFactor{
					delete diff_kind_Left = n6diff_kind_Left
					delete diff_kind_Right = n6diff_kind_Right
					delete FactorID =  n6FactorID
					delete Hierarchy =  n6Hierarchy
				}
				 create				node n7:DomainSpecificDiff{
					create name = "\"Pull-up Hierarchy 2\""
				}
			edges[
			  		(create		n0->n7:domainspecificdiffs),
			  		(preserve	n3->n4:subFactors),
			  		(delete		n3->n6:subFactors),
			  		(preserve	n4->n5:subFactors)
	      		 ]
			}
			conditions [((n5FactorID == n6FactorID) AND ("n6Hierarchy.contains(n5Hierarchy)" == 'true') AND (n5diff_kind_Left == "\"DELETE\"") AND (n6diff_kind_Left == "\"ADD\"")) OR ((n5FactorID == n6FactorID) AND ("n6Hierarchy.contains(n5Hierarchy)" == 'true') AND (n5diff_kind_Right == "\"DELETE\"") AND (n6diff_kind_Right == "\"ADD\""))] 
		}
