                  <region file="/0/@model.2/@inventoryElement.9" language="java"/>
                </source>
                <comment text="// quick hack"/>
                <comment text="// when used at entry fields (!this.lastNameOnlyAndSeparationBySpace), this is a single unit field"/>
                <comment text="// when used at the search form (this.lastNameOnlyAndSeparationBySpace), this is NOT a single unit field"/>
                <comment text="// reason: search keywords are separated by space. "/>
                <comment text="//    This is OK for last names without prefix. &quot;Lastname&quot; works perfectly."/>
                <comment text="//    querying for &quot;van der Lastname&quot; can be interpreted as"/>
                <comment text="//      a) &quot;van&quot; &quot;der&quot; &quot;Lastname&quot;"/>
                <comment text="//      b) &quot;van der Lastname&quot; (autocompletion lastname)"/>
