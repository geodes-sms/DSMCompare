                <region file="/0/@model.2/@inventoryElement.10" language="java"/>
              </source>
              <comment text="// Ask here if the user really wants to close, if the base"/>
              <comment text="// has not been saved since last save."/>
              <comment text="// The user wants to save."/>
              <comment text="//basePanel().runCommand(&quot;save&quot;);"/>
              <comment text="// The action was either cancelled or unsuccessful."/>
              <comment text="// Break!"/>
              <comment text="// Something prevented the file"/>
              <comment text="// from being saved. Break!!!"/>
              <comment text="// Let the search interface store changes to prefs."/>
              <comment text="// Let the search interface store changes to prefs."/>
              <comment text="// But which one? Let's use the one that is visible."/>
              <comment text="// There is a database still being saved, so we need to wait."/>
              <comment text="// This method won't return until cancelled or the save operation is done."/>
