          <codeElement xsi:type="code:MethodUnit" name="JabRefPreferences" type="/0/@model.0/@codeElement.0/@codeElement.7/@codeElement.295/@codeElement.0" kind="constructor" export="private">
            <attribute tag="export" value="private"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.8" language="java"/>
            </source>
            <comment text="// The constructor is made private to enforce this as a singleton class:"/>
            <codeElement xsi:type="code:Signature" name="JabRefPreferences"/>
            <codeElement xsi:type="action:BlockUnit">
              <source language="java">
                <region file="/0/@model.2/@inventoryElement.8" language="java"/>
              </source>
              <comment text="// load user preferences "/>
              <comment text="//defaults.put(&quot;pdfviewer&quot;, &quot;/Applications/Preview.app&quot;);"/>
              <comment text="//defaults.put(&quot;psviewer&quot;, &quot;/Applications/Preview.app&quot;);"/>
              <comment text="//defaults.put(&quot;htmlviewer&quot;, &quot;/Applications/Safari.app&quot;);"/>
              <comment text="//defaults.put(&quot;pdfviewer&quot;, &quot;cmd.exe /c start /b&quot;);"/>
              <comment text="//defaults.put(&quot;psviewer&quot;, &quot;cmd.exe /c start /b&quot;);"/>
              <comment text="//defaults.put(&quot;htmlviewer&quot;, &quot;cmd.exe /c start /b&quot;);"/>
              <comment text="//defaults.put(&quot;pdfviewer&quot;, &quot;evince&quot;);"/>
              <comment text="//defaults.put(&quot;psviewer&quot;, &quot;gv&quot;);"/>
              <comment text="//defaults.put(&quot;htmlviewer&quot;, &quot;firefox&quot;);"/>
              <comment text="// linux"/>
              <comment text="// &quot;Show names unchanged&quot;"/>
              <comment text="// &quot;Show 'Firstname Lastname'&quot;"/>
              <comment text="// &quot;Show 'Lastname, Firstname'&quot;"/>
              <comment text="// &quot;Natbib style&quot;"/>
              <comment text="// &quot;Abbreviate names&quot;"/>
              <comment text="// &quot;Show last names only&quot;"/>
              <comment text="// Sorting preferences"/>
              <comment text="// &quot;Autocomplete names in 'Firstname Lastname' format only&quot;"/>
              <comment text="// &quot;Autocomplete names in 'Lastname, Firstname' format only&quot;"/>
              <comment text="// &quot;Autocomplete names in 'Firstname Lastname' format only&quot;"/>
              <comment text="// &quot;Autocomplete names in 'Lastname, Firstname' format only&quot;"/>
              <comment text="// &quot;Autocomplete names in 'Firstname Lastname' format only&quot;"/>
              <comment text="// &quot;Autocomplete names in 'Lastname, Firstname' format only&quot;"/>
              <comment text="// The general fields stuff is made obsolete by the CUSTOM_TAB_... entries."/>
              <comment text="// Main table color settings:"/>
              <comment text="// Include the booktitle field for @inproceedings, @proceedings, etc."/>
              <comment text="// Include the booktitle field for @inproceedings, @proceedings, etc."/>
              <comment text="// TODO: Currently not possible to edit this setting:"/>
              <comment text="//&quot;title;journal;booktitle;review;abstract&quot;);"/>
              <comment text="// behavior of JabRef before 2.10: both: false"/>
              <comment text="//behavior of JabRef before LWang_AdjustableFieldOrder 1"/>
              <comment text="//0 sorted order (2.10 default), 1 unsorted order (2.9.2 default), 2 user defined"/>
              <comment text="// obsoleted by the app-specific ones"/>
              <comment text="// Curly brackets ({}) are the default delimiters, not quotes (&quot;) as these cause trouble when they appear within the field value:"/>
