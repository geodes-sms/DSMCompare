                </source>
              </parameterUnit>
              <parameterUnit type="/0/@model.1/@codeElement.289" kind="throws">
                <source language="java">
                  <region language="java"/>
                </source>
              </parameterUnit>
            </codeElement>
          </codeElement>
          <codeElement xsi:type="code:TemplateUnit" name="list">
            <codeElement xsi:type="code:TemplateParameter" name="T"/>
            <codeElement xsi:type="code:MethodUnit" name="list" type="/0/@model.0/@codeElement.0/@codeElement.4/@codeElement.7/@codeElement.1/@codeElement.0">
              <attribute tag="export" value="public"/>
              <source language="java">
                <region file="/0/@model.2/@inventoryElement.4" language="java"/>
              </source>
              <comment text="/**&#xA;&#x9; * Retrieves a list of all files in the remote repository, filtered by&#xA;&#x9; * the type of the desired file, i.e. by a sub-class of {@link RemoteFile}.&#xA;&#x9; * &#xA;&#x9; * @param remoteFileClass Filter class: &lt;tt>RemoteFile&lt;/tt> or a sub-type thereof  &#xA;&#x9; * @return Returns a list of remote files. In the map, the key is the file name,&#xA;&#x9; *         the value the entire {@link RemoteFile} object.&#xA;&#x9; * @throws StorageException If the connection fails due to no Internet connection,&#xA;&#x9; *         authentication errors, etc&#xA;&#x9; */"/>
              <codeElement xsi:type="code:Signature" name="list">
                <parameterUnit type="/0/@model.1/@codeElement.1" kind="return">
                  <source language="java">
