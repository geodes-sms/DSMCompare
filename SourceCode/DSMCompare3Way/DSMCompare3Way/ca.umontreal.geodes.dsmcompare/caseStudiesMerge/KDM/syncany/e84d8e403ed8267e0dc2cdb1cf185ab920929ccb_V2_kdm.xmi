          </codeElement>
          <codeElement xsi:type="code:MethodUnit" name="hasWriteAccess" type="/0/@model.0/@codeElement.0/@codeElement.4/@codeElement.9/@codeElement.0">
            <attribute tag="export" value="public"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.4" language="java"/>
            </source>
            <comment text="/**&#xA;&#x9; * Tests whether the repository path/folder is &lt;b>writable&lt;/b> by the application. This method is&#xA;&#x9; * called by the {@link #test()} method (only during repository initialization (or initial&#xA;&#x9; * connection).&#xA;&#x9; * &#xA;&#x9; * @return Returns &lt;tt>true&lt;/tt> if the repository can be written to, &lt;tt>false&lt;/tt> otherwise&#xA;&#x9; */"/>
