          <codeElement xsi:type="code:StorableUnit" name="localRootDir" type="/0/@model.1/@codeElement.0/@codeElement.0/@codeElement.0">
            <attribute tag="export" value="private"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.5" language="java"/>
