          <codeElement xsi:type="code:ClassUnit" name="TxLogMessageReader" isAbstract="false">
            <attribute tag="export" value="private"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.1" language="java"/>
            </source>
            <comment text="//    private void readRelations(TransactionLogHeader.Entry txentry,"/>
            <comment text="//                               StandardTitanTx tx, StandardChangeState changes) {"/>
            <comment text="//        for (TransactionLogHeader.Modification modification : txentry.getContentAsModifications(serializer)) {"/>
            <comment text="//            Change state = modification.state;"/>
            <comment text="//            assert state.isProper();"/>
            <comment text="//            long outVertexId = modification.outVertexId;"/>
            <comment text="//            Entry relEntry = modification.relationEntry;"/>
            <comment text="//            InternalVertex outVertex = tx.getInternalVertex(outVertexId);"/>
            <comment text="//            //Special relation parsing, compare to {@link RelationConstructor}"/>
            <comment text="//            RelationCache relCache = tx.getEdgeSerializer().readRelation(relEntry, false, tx);"/>
            <comment text="//            assert relCache.direction == Direction.OUT;"/>
            <comment text="//            InternalRelationType type = (InternalRelationType)tx.getExistingRelationType(relCache.typeId);"/>
            <comment text="//            assert type.getBaseType()==null;"/>
            <comment text="//            InternalRelation rel;"/>
            <comment text="//            if (type.isPropertyKey()) {"/>
            <comment text="//                if (state==Change.REMOVED) {"/>
            <comment text="//                    rel = new StandardProperty(relCache.relationId,(PropertyKey)type,outVertex,relCache.getValue(), ElementLifeCycle.Removed);"/>
            <comment text="//                } else {"/>
            <comment text="//                    rel = new CacheProperty(relCache.relationId,(PropertyKey)type,outVertex,relCache.getValue(),relEntry);"/>
            <comment text="//                }"/>
            <comment text="//            } else {"/>
            <comment text="//                assert type.isEdgeLabel();"/>
            <comment text="//                InternalVertex otherVertex = tx.getInternalVertex(relCache.getOtherVertexId());"/>
            <comment text="//                if (state==Change.REMOVED) {"/>
            <comment text="//                    rel = new StandardEdge(relCache.relationId, (EdgeLabel) type, outVertex, otherVertex,ElementLifeCycle.Removed);"/>
            <comment text="//                } else {"/>
            <comment text="//                    rel = new CacheEdge(relCache.relationId, (EdgeLabel) type, outVertex, otherVertex,relEntry);"/>
            <comment text="//                }"/>
            <comment text="//            }"/>
            <comment text="//            if (state==Change.REMOVED &amp;&amp; relCache.hasProperties()) { //copy over properties"/>
            <comment text="//                for (LongObjectCursor&lt;Object> entry : relCache) {"/>
            <comment text="//                    rel.setPropertyDirect(tx.getExistingRelationType(entry.key),entry.value);"/>
            <comment text="//                }"/>
            <comment text="//            }"/>
            <comment text="//"/>
            <comment text="//            //Special case for vertex addition/removal"/>
            <comment text="//            if (rel.getType().equals(BaseKey.VertexExists) &amp;&amp; !(outVertex instanceof TitanSchemaElement)) {"/>
            <comment text="//                if (state==Change.REMOVED) { //Mark as removed"/>
            <comment text="//                    ((StandardVertex)outVertex).updateLifeCycle(ElementLifeCycle.Event.REMOVED);"/>
            <comment text="//                }"/>
            <comment text="//                changes.addVertex(outVertex,state);"/>
            <comment text="//            } else if (!rel.isHidden()) {"/>
            <comment text="//                changes.addRelation(rel,state);"/>
            <comment text="//            }"/>
