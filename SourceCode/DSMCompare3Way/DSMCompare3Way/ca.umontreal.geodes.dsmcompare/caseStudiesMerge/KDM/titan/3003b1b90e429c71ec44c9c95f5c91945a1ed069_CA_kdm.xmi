          <codeElement xsi:type="code:StorableUnit" name="MAX_OPERATIONS_PER_CONNECTION" type="/0/@model.1/@codeElement.8" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="/**&#xA;     * Maximum number of operations allowed per connection before the connection is closed.&#xA;     * &lt;p/>&#xA;     */"/>
