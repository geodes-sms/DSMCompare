            </source>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.164" from="/0/@model.0/@codeElement.0/@codeElement.1/@codeElement.135"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="TOPOLOGY_DEBUG" type="/0/@model.1/@codeElement.0/@codeElement.1/@codeElement.8" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.1" language="java"/>
            </source>
            <comment text="/**&#xA;     * When set to true, Storm will log every message that's emitted.&#xA;     */"/>
            <codeRelation xsi:type="code:HasValue" to="/0/@model.1/@codeElement.165" from="/0/@model.0/@codeElement.0/@codeElement.1/@codeElement.136"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="TOPOLOGY_DEBUG_SCHEMA" type="/0/@model.1/@codeElement.0/@codeElement.1/@codeElement.10" kind="static">
            <attribute tag="export" value="public final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.1" language="java"/>
            </source>
