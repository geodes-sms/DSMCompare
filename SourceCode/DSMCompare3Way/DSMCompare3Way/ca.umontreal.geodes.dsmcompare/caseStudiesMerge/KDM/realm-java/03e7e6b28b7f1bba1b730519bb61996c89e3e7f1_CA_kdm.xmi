                    <region file="/0/@model.2/@inventoryElement.1" language="java"/>
                  </source>
                  <comment text="// The fastest way of doing `count()` is going through `TableQuery.count()`. Unfortunately"/>
                  <comment text="// doing this does not correctly apply all side effects of queries (like subscriptions). Also"/>
                  <comment text="// some queries constructs, like doing distinct is not easily supported this way."/>
                  <comment text="// In order to get the best of both worlds we thus need to create a Java RealmResults object"/>
                  <comment text="// and then directly access the `Results` class from Object Store."/>
