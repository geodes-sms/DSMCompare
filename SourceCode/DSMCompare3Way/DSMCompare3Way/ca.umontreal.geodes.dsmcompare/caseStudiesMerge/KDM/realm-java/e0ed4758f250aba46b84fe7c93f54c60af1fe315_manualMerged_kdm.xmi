                <source language="java">
                  <region file="/0/@model.2/@inventoryElement.2" language="java"/>
                </source>
                <comment text="// Checks the PK column key before removing a column. We don't know if we're hitting a PK col,"/>
                <comment text="// but it should be noted that once a column is removed, there is no way we can find whether"/>
                <comment text="// a PK exists or not."/>
                <codeElement xsi:type="code:StorableUnit" name="columnName" type="/0/@model.1/@codeElement.0/@codeElement.2/@codeElement.3" kind="local">
