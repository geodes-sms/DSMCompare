            <comment text="//    public void shakeCheck(LivingEntity target) {"/>
            <comment text="//        if (pluginRef.getRandomChanceTools().checkRandomChanceExecutionSuccess(new RandomChanceSkillStatic(getShakeChance(), getPlayer(), SubSkillType.FISHING_SHAKE))) {"/>
            <comment text="//            List&lt;ShakeTreasure> possibleDrops = fishingBehaviour.findPossibleDrops(target);"/>
            <comment text="//"/>
            <comment text="//            if (possibleDrops == null || possibleDrops.isEmpty()) {"/>
            <comment text="//                return;"/>
            <comment text="//            }"/>
            <comment text="//"/>
            <comment text="//            ItemStack drop = fishingBehaviour.chooseDrop(possibleDrops);"/>
            <comment text="//"/>
            <comment text="//            // It's possible that chooseDrop returns null if the sum of probability in possibleDrops is inferior than 100"/>
            <comment text="//            if (drop == null) {"/>
            <comment text="//                return;"/>
            <comment text="//            }"/>
            <comment text="//"/>
            <comment text="//            // Extra processing depending on the mob and drop type"/>
            <comment text="//            switch (target.getType()) {"/>
            <comment text="//                case PLAYER:"/>
            <comment text="//                    Player targetPlayer = (Player) target;"/>
            <comment text="//"/>
            <comment text="//                    switch (drop.getType()) {"/>
            <comment text="//                        case PLAYER_HEAD:"/>
            <comment text="//                            drop.setDurability((short) 3);"/>
            <comment text="//                            SkullMeta skullMeta = (SkullMeta) drop.getItemMeta();"/>
            <comment text="//                            skullMeta.setOwningPlayer(targetPlayer);"/>
            <comment text="//                            drop.setItemMeta(skullMeta);"/>
            <comment text="//                            break;"/>
            <comment text="//"/>
            <comment text="//                        case BEDROCK:"/>
            <comment text="//                            if (FishingTreasureConfig.getInstance().getInventoryStealEnabled()) {"/>
            <comment text="//                                PlayerInventory inventory = targetPlayer.getInventory();"/>
            <comment text="//                                int length = inventory.getContents().length;"/>
            <comment text="//                                int slot = Misc.getRandom().nextInt(length);"/>
            <comment text="//                                drop = inventory.getItem(slot);"/>
            <comment text="//"/>
            <comment text="//                                if (drop == null) {"/>
            <comment text="//                                    break;"/>
            <comment text="//                                }"/>
            <comment text="//"/>
            <comment text="//                                if (FishingTreasureConfig.getInstance().getInventoryStealStacks()) {"/>
            <comment text="//                                    inventory.setItem(slot, null);"/>
            <comment text="//                                } else {"/>
            <comment text="//                                    inventory.setItem(slot, (drop.getAmount() > 1) ? new ItemStack(drop.getType(), drop.getAmount() - 1) : null);"/>
            <comment text="//                                    drop.setAmount(1);"/>
            <comment text="//                                }"/>
            <comment text="//"/>
            <comment text="//                                targetPlayer.updateInventory();"/>
            <comment text="//                            }"/>
            <comment text="//                            break;"/>
            <comment text="//"/>
            <comment text="//                        default:"/>
            <comment text="//                            break;"/>
            <comment text="//                    }"/>
            <comment text="//                    break;"/>
            <comment text="//"/>
            <comment text="//                case SHEEP:"/>
            <comment text="//                    Sheep sheep = (Sheep) target;"/>
            <comment text="//"/>
            <comment text="//                    if (drop.getType().name().endsWith(&quot;WOOL&quot;)) {"/>
            <comment text="//                        if (sheep.isSheared()) {"/>
            <comment text="//                            return;"/>
