            <comment text="//        List&lt;Enchantment> validEnchantments = getPossibleEnchantments(treasureDrop);"/>
            <comment text="//        List&lt;EnchantmentTreasure> possibleEnchants = new ArrayList&lt;>();"/>
            <comment text="//"/>
