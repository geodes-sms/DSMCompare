                <region file="/0/@model.2/@inventoryElement.4" language="java"/>
              </source>
              <codeElement xsi:type="action:ActionElement" name="variable declaration" kind="variable declaration">
                <source language="java">
                  <region file="/0/@model.2/@inventoryElement.4" language="java"/>
                </source>
                <codeElement xsi:type="code:StorableUnit" name="futureCenterBlocks" type="/0/@model.1/@codeElement.4" kind="local">
                  <attribute tag="export" value="none"/>
                  <source language="java">
                    <region file="/0/@model.2/@inventoryElement.4" language="java"/>
                  </source>
                  <codeRelation xsi:type="code:HasValue" to="/0/@model.0/@codeElement.0/@codeElement.3/@codeElement.8/@codeElement.1/@codeElement.0/@codeElement.1" from="/0/@model.0/@codeElement.0/@codeElement.3/@codeElement.8/@codeElement.1/@codeElement.0/@codeElement.0"/>
                </codeElement>
                <codeElement xsi:type="action:ActionElement" name="class instance creation" kind="class instance creation">
