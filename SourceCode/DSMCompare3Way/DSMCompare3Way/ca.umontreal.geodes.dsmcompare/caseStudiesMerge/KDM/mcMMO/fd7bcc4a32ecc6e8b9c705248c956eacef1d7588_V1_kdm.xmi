            <comment text="/**&#xA;     * Process the Treasure Hunter ability for Fishing&#xA;     *&#xA;     * @return The {@link FishingTreasure} found, or null if no treasure was found.&#xA;     */"/>
            <comment text="//    private FishingTreasure getFishingTreasure() {"/>
            <comment text="//        double diceRoll = Misc.getRandom().nextDouble() * 100;"/>
            <comment text="//        int luck;"/>
            <comment text="//"/>
            <comment text="//        if (getPlayer().getInventory().getItemInMainHand().getType() == Material.FISHING_ROD) {"/>
            <comment text="//            luck = getPlayer().getInventory().getItemInMainHand().getEnchantmentLevel(Enchantment.LUCK);"/>
            <comment text="//        } else {"/>
            <comment text="//            // We know something was caught, so if the rod wasn't in the main hand it must be in the offhand"/>
            <comment text="//            luck = getPlayer().getInventory().getItemInOffHand().getEnchantmentLevel(Enchantment.LUCK);"/>
            <comment text="//        }"/>
            <comment text="//"/>
            <comment text="//        // Rather than subtracting luck (and causing a minimum 3% chance for every drop), scale by luck."/>
            <comment text="//        diceRoll *= (1.0 - luck * pluginRef.getConfigManager().getConfigFishing().getLureLuckModifier() / 100);"/>
            <comment text="//"/>
            <comment text="//        FishingTreasure treasure = null;"/>
            <comment text="//"/>
            <comment text="//        for (Rarity rarity : Rarity.values()) {"/>
            <comment text="//            double dropRate = FishingTreasureConfig.getInstance().getItemDropRate(getLootTier(), rarity);"/>
            <comment text="//"/>
            <comment text="//            if (diceRoll &lt;= dropRate) {"/>
            <comment text="//                /*if (rarity == Rarity.TRAP) {"/>
            <comment text="//                    handleTraps();"/>
            <comment text="//                    break;"/>
            <comment text="//                }*/"/>
            <comment text="//"/>
            <comment text="//                List&lt;FishingTreasure> fishingTreasures = FishingTreasureConfig.getInstance().fishingRewards.get(rarity);"/>
            <comment text="//"/>
            <comment text="//                if (fishingTreasures.isEmpty()) {"/>
            <comment text="//                    return null;"/>
            <comment text="//                }"/>
            <comment text="//"/>
            <comment text="//                treasure = fishingTreasures.get(Misc.getRandom().nextInt(fishingTreasures.size()));"/>
            <comment text="//                break;"/>
            <comment text="//            }"/>
            <comment text="//"/>
            <comment text="//            diceRoll -= dropRate;"/>
            <comment text="//        }"/>
            <comment text="//"/>
            <comment text="//        if (treasure == null) {"/>
            <comment text="//            return null;"/>
            <comment text="//        }"/>
            <comment text="//"/>
            <comment text="//        ItemStack treasureDrop = treasure.getDrop().clone();"/>
            <comment text="//        short maxDurability = treasureDrop.getType().getMaxDurability();"/>
            <comment text="//"/>
            <comment text="//        if (maxDurability > 0) {"/>
            <comment text="//            treasureDrop.setDurability((short) (Misc.getRandom().nextInt(maxDurability)));"/>
            <comment text="//        }"/>
            <comment text="//"/>
            <comment text="//        if (treasureDrop.getAmount() > 1) {"/>
            <comment text="//            treasureDrop.setAmount(Misc.getRandom().nextInt(treasureDrop.getAmount()) + 1);"/>
            <comment text="//        }"/>
            <comment text="//"/>
            <comment text="//        treasure.setDrop(treasureDrop);"/>
            <comment text="//"/>
            <comment text="//        return treasure;"/>
            <comment text="//    }"/>
            <comment text="/**&#xA;     * Process the Magic Hunter ability&#xA;     *&#xA;     * @param treasureDrop The {@link ItemStack} to enchant&#xA;     * @return true if the item has been enchanted&#xA;     */"/>
            <comment text="//    private Map&lt;Enchantment, Integer> handleMagicHunter(ItemStack treasureDrop) {"/>
            <comment text="//        Map&lt;Enchantment, Integer> enchants = new HashMap&lt;>();"/>
            <comment text="//        List&lt;EnchantmentTreasure> fishingEnchantments = null;"/>
            <comment text="//"/>
            <comment text="//        double diceRoll = Misc.getRandom().nextDouble() * 100;"/>
