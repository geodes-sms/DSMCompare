              <comment text="//        //IFrame storage"/>
              <comment text="////        int noDamageTicks = target.getNoDamageTicks();"/>
              <comment text="//"/>
              <comment text="////        String debug = &quot;BLEED DMG RESULT: INC DMG:&quot;+damage+&quot;, HP-Before:&quot;+target.getHealth()+&quot;, HP-After:&quot;;"/>
              <comment text="//"/>
              <comment text="////        double incDmg = getFakeDamageFinalResult(attacker, target, DamageCause.ENTITY_ATTACK, damage);"/>
              <comment text="//"/>
              <comment text="////        double newHealth = Math.max(0, target.getHealth() - incDmg);"/>
              <comment text="//"/>
              <comment text="//        //Don't kill things with a stone or wooden weapon"/>
              <comment text="////        if(toolTier &lt; 3 &amp;&amp; newHealth == 0)"/>
              <comment text="////            return;"/>
              <comment text="//"/>
              <comment text="//        target.setMetadata(mcMMO.CUSTOM_DAMAGE_METAKEY, mcMMO.metadataValue);"/>
              <comment text="//"/>
