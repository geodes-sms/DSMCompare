              <comment text="//        {"/>
              <comment text="//            target.damage(99999, attacker);"/>
              <comment text="//        }"/>
              <comment text="//        else"/>
              <comment text="//        {"/>
              <comment text="////            Vector beforeRuptureVec = new Vector(target.getVelocity().getX(), target.getVelocity().getY(), target.getVelocity().getZ()); ;"/>
              <comment text="//            target.damage(damage, attacker);"/>
              <comment text="////            debug+=target.getHealth();"/>
              <comment text="//            Bukkit.broadcastMessage(debug);"/>
              <comment text="////            target.setNoDamageTicks(noDamageTicks); //Do not add additional IFrames"/>
              <comment text="////            target.setVelocity(beforeRuptureVec);"/>
              <comment text="//        }"/>
