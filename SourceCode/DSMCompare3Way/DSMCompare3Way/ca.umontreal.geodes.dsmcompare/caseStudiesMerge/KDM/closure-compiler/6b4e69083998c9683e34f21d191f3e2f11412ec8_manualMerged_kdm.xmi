          <codeElement xsi:type="code:StorableUnit" name="selfPlusTransitiveDeps" type="/0/@model.1/@codeElement.2">
            <attribute tag="export" value="private final"/>
            <source language="java">
              <region file="/0/@model.2/@inventoryElement.0" language="java"/>
            </source>
            <comment text="/**&#xD;&#xA;   * selfPlusTransitiveDeps[i] = indices of all modules that modules[i] depends on, including&#xD;&#xA;   * itself.&#xD;&#xA;   */"/>
          </codeElement>
          <codeElement xsi:type="code:StorableUnit" name="subtreeSize" type="/0/@model.1/@codeElement.3">
