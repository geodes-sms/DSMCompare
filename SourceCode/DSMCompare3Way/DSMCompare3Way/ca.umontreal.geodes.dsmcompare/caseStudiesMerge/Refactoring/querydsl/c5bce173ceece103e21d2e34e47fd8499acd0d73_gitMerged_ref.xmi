    <eoperations name="SQLTemplates()" eparameters="quoteStr:, escape:, useQuotes:" methodBody="" __idKDM="SQLTemplates______"/>
    <eoperations name="SQLTemplates()" eparameters="reservedKeywords:, quoteStr:, escape:, useQuotes:" methodBody="expression statement; ASSIGN; field access; expression statement; ASSIGN; quoteStr; field access; quoteStr; this; expression statement; ASSIGN; reservedKeywords; field access; reservedWords; this; super constructor invocation; " __idKDM="SQLTemplates______"/>
    <nested_classes name="Builder">
      <eattributes name="printSchema"/>
      <eattributes name="quote"/>
      <eattributes name="newLineToSingleSpace"/>
      <eattributes name="escape"/>
      <eoperations name="printSchema()" etype="Builder" methodBody="return; this; expression statement; ASSIGN; printSchema; boolean literal; " __idKDM="printSchema______"/>
      <eoperations name="quote()" etype="Builder" methodBody="return; this; expression statement; ASSIGN; quote; boolean literal; " __idKDM="quote______"/>
      <eoperations name="newLineToSingleSpace()" etype="Builder" methodBody="return; this; expression statement; ASSIGN; newLineToSingleSpace; boolean literal; " __idKDM="newLineToSingleSpace______"/>
      <eoperations name="escape()" eparameters="ch:" etype="Builder" methodBody="return; this; expression statement; ASSIGN; escape; " __idKDM="escape______"/>
      <eoperations name="build()" eparameters="escape:, quote:" etype="SQLTemplates" methodBody="" __idKDM="build______"/>
      <eoperations name="build()" etype="SQLTemplates" methodBody="return; expression statement; method invocation; if; expression statement; method invocation; variable declaration; templates; " __idKDM="build______"/>
    </nested_classes>
  </eclassifiers>
</refactoring:EPackage>
