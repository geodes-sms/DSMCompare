<?xml version="1.0" encoding="ASCII"?>
<refactoring:EPackage xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:refactoring="www.geodes.UdeM.edu/refactoring" name="pkg">
  <eclassifiers name="SQLTemplates">
    <eattributes name="SQL_RESERVED_WORDS"/>
