    <eStructuralFeatures xsi:type="ecore:EAttribute" name="new_lives" upperBound="2"
        eType="ecore:EDataType http://www.eclipse.org/emf/2002/Ecore#//EInt"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="livesChangeStatus" unique="false"
        lowerBound="1" eType="#//ConflictKind" defaultValueLiteral="NIL"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="diff_kind" upperBound="2"
        eType="#//DiffKind" defaultValueLiteral="NIL"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="changeStatus" eType="#//ConflictKind"
        defaultValueLiteral="NIL"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DiffGame_entities"/>
  <eClassifiers xsi:type="ecore:EClass" name="DiffPositionableEntity_on">
    <eStructuralFeatures xsi:type="ecore:EReference" name="target" lowerBound="1"
