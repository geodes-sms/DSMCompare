    <eStructuralFeatures xsi:type="ecore:EAttribute" name="valueConflictKind" unique="false"
        lowerBound="1" eType="#//ConflictKind" defaultValueLiteral="NIL"/>
    <eStructuralFeatures xsi:type="ecore:EReference" name="new_durations" upperBound="2"
