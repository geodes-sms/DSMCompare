    <eStructuralFeatures xsi:type="ecore:EAttribute" name="initialPositionChangeStatus"
        unique="false" lowerBound="1" eType="#//ConflictKind" defaultValueLiteral="NIL"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="diff_kind" upperBound="2"
        eType="#//DiffKind" defaultValueLiteral="NIL"/>
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="changeStatus" eType="#//ConflictKind"
        defaultValueLiteral="NIL"/>
  </eClassifiers>
  <eClassifiers xsi:type="ecore:EClass" name="DiffGame" eSuperTypes="#//Game">
    <eStructuralFeatures xsi:type="ecore:EAttribute" name="new_score" upperBound="2"
