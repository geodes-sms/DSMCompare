            icon="icons/full/obj16/PacmanDiffMMModelFile.gif">
         <description>%_UI_PacmanDiffMMModelWizard_description</description>
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <!-- @generated pacmanDiffMM -->
      <editor
            id="pacmanDiffMM.presentation.PacmanDiffMMEditorID"
            name="%_UI_PacmanDiffMMEditor_label"
            icon="icons/full/obj16/PacmanDiffMMModelFile.gif"
            extensions="pacmandiffmm"
            class="pacmanDiffMM.presentation.PacmanDiffMMEditor"
            contributorClass="pacmanDiffMM.presentation.PacmanDiffMMActionBarContributor">
      </editor>
   </extension>
   <extension point="org.eclipse.ui.newWizards">
      <!-- @generated refactoring -->
      <category
            id="org.eclipse.emf.ecore.Wizard.category.ID"
            name="%_UI_Wizard_category"/>
