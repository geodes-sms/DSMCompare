         <description>%_UI_RefactoringModelWizard_description</description>
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <!-- @generated refactoring -->
      <editor
            id="refactoring.presentation.RefactoringEditorID"
            name="%_UI_RefactoringEditor_label"
            icon="icons/full/obj16/RefactoringModelFile.gif"
            extensions="refactoring"
            class="refactoring.presentation.RefactoringEditor"
            contributorClass="refactoring.presentation.RefactoringActionBarContributor">
      </editor>
   </extension>
   <extension point="org.eclipse.ui.newWizards">
      <!-- @generated refactoringDiffMM -->
      <category
            id="org.eclipse.emf.ecore.Wizard.category.ID"
            name="%_UI_Wizard_category"/>
      <wizard
            id="refactoringDiffMM.presentation.RefactoringDiffMMModelWizardID"
