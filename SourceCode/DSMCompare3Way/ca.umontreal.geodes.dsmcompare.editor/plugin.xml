<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.0"?>

<!--
-->

<plugin>

   <extension point="org.eclipse.ui.newWizards">
      <!-- @generated pacman -->
      <category
            id="org.eclipse.emf.ecore.Wizard.category.ID"
            name="%_UI_Wizard_category"/>
      <wizard
            id="pacman.presentation.PacmanModelWizardID"
            name="%_UI_PacmanModelWizard_label"
            class="pacman.presentation.PacmanModelWizard"
            category="org.eclipse.emf.ecore.Wizard.category.ID"
            icon="icons/full/obj16/PacmanModelFile.gif">
         <description>%_UI_PacmanModelWizard_description</description>
         <selection class="org.eclipse.core.resources.IResource"/>
      </wizard>
   </extension>

   <extension point="org.eclipse.ui.editors">
      <!-- @generated pacman -->
      <editor
            id="pacman.presentation.PacmanEditorID"
            name="%_UI_PacmanEditor_label"
            icon="icons/full/obj16/PacmanModelFile.gif"
            extensions="pacman"
            class="pacman.presentation.PacmanEditor"
            contributorClass="pacman.presentation.PacmanActionBarContributor">
      </editor>
   </extension>

   <extension point="org.eclipse.ui.newWizards">
      <!-- @generated pacmanDiffMM -->
      <category
            id="org.eclipse.emf.ecore.Wizard.category.ID"
            name="%_UI_Wizard_category"/>
      <wizard
            id="pacmanDiffMM.presentation.PacmanDiffMMModelWizardID"
            name="%_UI_PacmanDiffMMModelWizard_label"
            class="pacmanDiffMM.presentation.PacmanDiffMMModelWizard"
