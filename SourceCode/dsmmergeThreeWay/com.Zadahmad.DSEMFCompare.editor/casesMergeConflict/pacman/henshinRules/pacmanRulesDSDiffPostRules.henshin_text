	unit unitSequntialStar(){
		unitPacmanEatFoodPostStar()
		unitPacmanDiePostStar()
		unitGhostMoveRightPostStar()
		unitGhostMoveLeftPostStar()
		unitGhostMoveUpPostStar()
		unitGhostMoveDownPostStar()
		unitGhostMovePostStar()
		unitPacmanMoveRightPostStar()
		unitPacmanMoveLeftPostStar()
		unitPacmanMoveUpPostStar()
		unitPacmanMoveDownPostStar()
		unitPacmanMovePostStar()
	}
	unit unitPacmanEatFoodPostStar(){
		while{
			PacmanEatFoodPost()
		}
	}
	unit unitPacmanDiePostStar(){
		while{
			PacmanDiePost()
		}
	}
	unit unitGhostMoveRightPostStar(){
		while{
			GhostMoveRightPost()
		}
	}
	unit unitGhostMoveLeftPostStar(){
