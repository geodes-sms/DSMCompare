ePackageImport  pacmanDiffMM

		rule PacmanEatFoodPost(VAR nPostchangeStatus:EString, VAR nPostdiff_kind_Left:EString, VAR nPostdiff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:DiffGame
				 preserve			node n3:DiffFood{
					preserve	changeStatus 	= 	nPostchangeStatus
					preserve	diff_kind_Left 	= 	nPostdiff_kind_Left
					preserve	diff_kind_Right	= 	nPostdiff_kind_Right
				}
				 preserve			node n4:DomainSpecificDiff{
					preserve	name = "\"Pacman Eat Food\""
					create		author		=  "(nPostchangeStatus.toString().replace('EQUIVALENT','EQUAL') + nPostdiff_kind_Right.toString().replaceAll('ADD|DELETE|MODIFY','RIGHT') +  nPostdiff_kind_Left.toString().replaceAll('ADD|DELETE|MODIFY','LEFT')).replaceAll('NON','').replaceAll('EQUALRIGHTLEFT|RIGHTLEFT','EQUAL');"
				}
			edges[
					(preserve	n0->n3:entities),
					(preserve		n0->n4:domainspecificdiffs),
					(preserve		n4->n0:DomainSpecificDiff_Game),
					(preserve		n4->n3:DomainSpecificDiff_PositionableEntity)
	      		 ]
			}
		}
//----------------------------------------------------------------------

		rule PacmanDiePost(VAR nPostchangeStatus:EString, VAR nPostdiff_kind_Left:EString, VAR nPostdiff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:Game
				 preserve			node n3:DiffPacman{
					preserve	changeStatus 	= 	nPostchangeStatus
					preserve	diff_kind_Left 	= 	nPostdiff_kind_Left
					preserve	diff_kind_Right	= 	nPostdiff_kind_Right
				}
				 preserve			node n31:DiffPositionableEntity_on
				 preserve			node n4:DomainSpecificDiff{
					preserve	name = "\"PacmanDie\""
					create		author		=  "(nPostchangeStatus.toString().replace('EQUIVALENT','EQUAL') + nPostdiff_kind_Right.toString().replaceAll('ADD|DELETE|MODIFY','RIGHT') +  nPostdiff_kind_Left.toString().replaceAll('ADD|DELETE|MODIFY','LEFT')).replaceAll('NON','').replaceAll('EQUALRIGHTLEFT|RIGHTLEFT','EQUAL');"
				}
			edges[
					(preserve	n0->n3:entities),
					(preserve		n0->n4:domainspecificdiffs),
					(preserve	n3->n31:diffon)
	      		 ]
			}
		}
//----------------------------------------------------------------------

