	unit unitSequntialStar(){
		unitsplitChildrenStar()
		unitsplitChildrenCFStar()
		unitmergeFactorsStar()
		unitmergeFactorsCFStar()
		unitpullUpHierarchyStar()
		unitpullUpHierarchyCFStar()
		unitpushDownHierarchyStar()
		unitpushDownHierarchyCFStar()
		unitmoveFactorStar()
		unitmoveFactorCFStar()
		unitrenameFactorStar()
		unitrenameFactorCFStar()
		unitscoreEnhancedStar()
		unitscoreDegradedStar()
	}
	unit unitsplitChildrenStar(){
		while{
			splitChildren()
		}
	}
	unit unitsplitChildrenCFStar(){
