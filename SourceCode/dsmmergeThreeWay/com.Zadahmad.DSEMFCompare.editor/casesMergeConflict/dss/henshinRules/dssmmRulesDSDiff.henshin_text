					preserve diff_kind_Left = n10diff_kind_Left
					preserve diff_kind_Right = n10diff_kind_Right
					preserve new_Name_Left =  n10new_Name_Left
					preserve Name =  n10Name
					preserve new_Name_Right =  n10new_Name_Right
				}			      		
				 create				node n20:SemanticDiff{
					create name = "\"Rename factor\""
				}
				 forbid			node n30:SemanticDiff{
					forbid name = "\"Rename factor\""
				}					
			edges[
			  		(create		n20->n10:SemanticObject_Factor),
			  		(forbid		n30->n10:SemanticObject_Factor)
	      		 ]
			}
			conditions [((n10new_Name_Left  != "null" ) AND (n10new_Name_Left  != "\"\"" ) AND (n10Name != n10new_Name_Left) AND (n10diff_kind_Left == "\"NON\"")) OR ((n10new_Name_Right  != "null" ) AND (n10new_Name_Right  != "\"\"" ) AND (n10Name != n10new_Name_Right) AND (n10diff_kind_Right == "\"NON\""))] 
		}
//----------------------------------------------------------------------

		rule renameFactorCF(VAR n10diff_kind_Left:EString,VAR n10diff_kind_Right:EString,VAR n10new_Name_Left:EString,VAR n10Name:EString,VAR n10new_Name_Right:EString)
		{
			graph
			{
				 preserve			node n10:DiffCompositeFactor{
					preserve diff_kind_Left = n10diff_kind_Left
					preserve diff_kind_Right = n10diff_kind_Right
					preserve new_Name_Left =  n10new_Name_Left
					preserve Name =  n10Name
					preserve new_Name_Right =  n10new_Name_Right
				}			      		
				 create				node n20:SemanticDiff{
					create name = "\"Rename factor\""
				}
				 forbid			node n30:SemanticDiff{
					forbid name = "\"Rename factor\""
				}					
			edges[
			  		(create		n20->n10:SemanticObject_Factor),
			  		(forbid		n30->n10:SemanticObject_Factor)
	      		 ]
			}
			conditions [((n10new_Name_Left  != "null" ) AND (n10new_Name_Left  != "\"\"" ) AND (n10Name != n10new_Name_Left) AND (n10diff_kind_Left == "\"MODIFY\"")) OR ((n10new_Name_Right  != "null" ) AND (n10new_Name_Right  != "\"\"" ) AND (n10Name != n10new_Name_Right) AND (n10diff_kind_Right == "\"MODIFY\""))] 
		}
//----------------------------------------------------------------------

		rule scoreEnhanced(VAR n10diff_kind_Left:EString,VAR n10diff_kind_Right:EString,VAR n10Descr:EString,VAR n10new_Descr_Left:EString,VAR n10new_Descr_Right:EString)
		{
			graph
			{
				 preserve			node n10:DiffScore{
					preserve diff_kind_Left = n10diff_kind_Left
					preserve diff_kind_Right = n10diff_kind_Right
					preserve Descr =  n10Descr
					preserve new_Descr_Left =  n10new_Descr_Left
					preserve new_Descr_Right =  n10new_Descr_Right
				}			      		
				 create				node n20:SemanticDiff{
					create name = "\"Score enhanced\""
				}
				 forbid			node n30:SemanticDiff{
					forbid name = "\"Score enhanced\""
				}					
			edges[
			  		(create		n20->n10:SemanticObject_Score),
			  		(forbid		n30->n10:SemanticObject_Score)
	      		 ]
			}
			conditions [((n10Descr < n10new_Descr_Left) AND (n10diff_kind_Left == "\"MODIFY\"")) OR ((n10Descr < n10new_Descr_Right) AND (n10diff_kind_Right == "\"MODIFY\""))] 
		}
//----------------------------------------------------------------------

		rule scoreDegraded(VAR n10diff_kind_Left:EString,VAR n10diff_kind_Right:EString,VAR n10Descr:EString,VAR n10new_Descr_Left:EString,VAR n10new_Descr_Right:EString)
		{
			graph
			{
				 preserve			node n10:DiffScore{
					preserve diff_kind_Left = n10diff_kind_Left
					preserve diff_kind_Right = n10diff_kind_Right
					preserve Descr =  n10Descr
					preserve new_Descr_Left =  n10new_Descr_Left
					preserve new_Descr_Right =  n10new_Descr_Right
				}			      		
				 create				node n20:SemanticDiff{
					create name = "\"Score degraded\""
				}
				 forbid			node n30:SemanticDiff{
					forbid name = "\"Score degraded\""
				}					
			edges[
			  		(create		n20->n10:SemanticObject_Score),
			  		(forbid		n30->n10:SemanticObject_Score)
	      		 ]
			}
			conditions [((n10Descr > n10new_Descr_Left) AND (n10diff_kind_Left == "\"MODIFY\"")) OR ((n10Descr > n10new_Descr_Right) AND (n10diff_kind_Right == "\"MODIFY\""))] 
		}
