				}			      		
				 preserve			node n22:DiffLeafFactor{
					preserve diff_kind_Left = n22diff_kind_Left
					preserve diff_kind_Right = n22diff_kind_Right
				}			      		
				 delete				node n23:DiffCompositeFactor_subFactors{
					delete diff_kind_Left = n23diff_kind_Left
					delete diff_kind_Right = n23diff_kind_Right
				}
				 delete				node n24:DiffCompositeFactor_subFactors{
					delete diff_kind_Left = n24diff_kind_Left
					delete diff_kind_Right = n24diff_kind_Right
				}
				 preserve			node n30:CompositeFactor			      		
				 preserve			node n31:DiffCompositeFactor_subFactors{
					preserve diff_kind_Left = n31diff_kind_Left
					preserve diff_kind_Right = n31diff_kind_Right
				}			      		
				 preserve			node n40:DiffLeafFactor{
					preserve diff_kind_Left = n40diff_kind_Left
					preserve diff_kind_Right = n40diff_kind_Right
				}			      		
				 create				node n50:SemanticDiff{
					create name = "\"Split children\""
				}
			edges[
			  		(preserve	n10->n11:diffsubFactors),
			  		(preserve	n11->n21:eType),
			  		(preserve	n20->n21:subFactors),
			  		(preserve	n20->n22:subFactors),
			  		(delete		n20->n23:diffsubFactors),
			  		(delete		n20->n24:diffsubFactors),
			  		(delete		n23->n21:eType),
			  		(delete		n24->n22:eType),
			  		(preserve	n30->n31:diffsubFactors),
			  		(preserve	n31->n22:eType),
			  		(create		n50->n11:SemanticObject_DiffCompositeFactor_subFactors),
			  		(create		n50->n31:SemanticObject_DiffCompositeFactor_subFactors),
			  		(create		n50->n10:SemanticObject_Factor),
			  		(create		n50->n30:SemanticObject_Factor),
			  		(create		n50->n20:SemanticObject_Factor),
			  		(create		n50->n40:SemanticObject_Factor),
			  		(create		n50->n21:SemanticObject_Factor),
			  		(create		n50->n22:SemanticObject_Factor)
	      		 ]
			}
			conditions [((n2FactorID == n4FactorID) AND (n11diff_kind_Left == "\"ADD\"") AND (n20diff_kind_Left == "\"DELETE\"") AND (n21diff_kind_Left == "\"DELETE\"") AND (n22diff_kind_Left == "\"DELETE\"") AND (n23diff_kind_Left == "\"DELETE\"") AND (n24diff_kind_Left == "\"DELETE\"") AND (n31diff_kind_Left == "\"ADD\"") AND (n40diff_kind_Left == "\"ADD\"")) OR ((n2FactorID == n4FactorID) AND (n11diff_kind_Right == "\"ADD\"") AND (n20diff_kind_Right == "\"DELETE\"") AND (n21diff_kind_Right == "\"DELETE\"") AND (n22diff_kind_Right == "\"DELETE\"") AND (n23diff_kind_Right == "\"DELETE\"") AND (n24diff_kind_Right == "\"DELETE\"") AND (n31diff_kind_Right == "\"ADD\"") AND (n40diff_kind_Right == "\"ADD\""))] 
