		rule splitChildren(VAR n11diff_kind_Left:EString,VAR n11diff_kind_Right:EString,VAR n20diff_kind_Left:EString,VAR n20diff_kind_Right:EString,VAR n21diff_kind_Left:EString,VAR n21diff_kind_Right:EString,VAR n22diff_kind_Left:EString,VAR n22diff_kind_Right:EString,VAR n23diff_kind_Left:EString,VAR n23diff_kind_Right:EString,VAR n24diff_kind_Left:EString,VAR n24diff_kind_Right:EString,VAR n31diff_kind_Left:EString,VAR n31diff_kind_Right:EString,VAR n40diff_kind_Left:EString,VAR n40diff_kind_Right:EString,VAR n2FactorID:EInt,VAR n4FactorID:EInt)
		{
			graph
			{
				 preserve			node n10:CompositeFactor			      		
				 preserve			node n11:DiffCompositeFactor_subFactors{
					preserve diff_kind_Left = n11diff_kind_Left
					preserve diff_kind_Right = n11diff_kind_Right
				}			      		
				 preserve			node n20:DiffCompositeFactor{
					preserve diff_kind_Left = n20diff_kind_Left
					preserve diff_kind_Right = n20diff_kind_Right
				}			      		
				 preserve			node n21:DiffLeafFactor{
