			  		(create		n3->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n11name == n12name) AND (n11diff_kind_Left == "\"ADD\"") AND (n12diff_kind_Left == "\"DELETE\"")) OR ((n11name == n12name) AND (n11diff_kind_Right == "\"ADD\"") AND (n12diff_kind_Right == "\"DELETE\""))] 
