ePackageImport  refactoringDiffMM

		rule pullUpMethod(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:DiffEClass_eoperations{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
				}			      		
				 preserve			node n3:EClass			      		
				 preserve			node n4:EOperation			      		
				 delete				node n5:DiffEClass_eoperations{
					delete diff_kind_Left = n5diff_kind_Left
					delete diff_kind_Right = n5diff_kind_Right
				}
				 create				node n6:SemanticDiff{
					create name = "\"pullUpMethod\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n3:eclassifiers),
			  		(preserve	n1->n2:diffeoperations),
			  		(preserve	n2->n4:eType),
			  		(preserve	n3->n4:eoperations),
			  		(preserve	n3->n1:esupertypes),
			  		(delete		n3->n5:diffeoperations),
			  		(delete		n5->n4:eType),
			  		(create		n6->n1:SemanticObject_EClass),
			  		(create		n6->n3:SemanticObject_EClass),
			  		(create		n6->n4:SemanticObject_EOperation),
			  		(create		n6->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"ADD\"") AND (n5diff_kind_Left == "\"DELETE\"")) OR ((n2diff_kind_Right == "\"ADD\"") AND (n5diff_kind_Right == "\"DELETE\""))] 
		}
