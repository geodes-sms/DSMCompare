		rule moveAndRenameClass(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n2new_name_Left:EString,VAR n2name:EString,VAR n2new_name_Right:EString)
		{
			graph
			{
				 preserve			node n1:EPackage			      		
				 preserve			node n2:DiffEClass{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
					preserve new_name_Left =  n2new_name_Left
					preserve name =  n2name
					preserve new_name_Right =  n2new_name_Right
				}			      		
				 forbid			node n4:SemanticDiff{
					forbid name = "\"Move And Rename Class\""
				}					
				 forbid			node n5:SemanticDiff{
					forbid name = "\"Move And Rename Class\""
				}					
			edges[
			  		(preserve	n1->n2:eclassifiers),
			  		(forbid		n4->n2:SemanticObject_EClass),
			  		(forbid		n4->n1:SemanticObject_EPackage),
			  		(forbid		n5->n2:SemanticObject_EClass),
			  		(forbid		n5->n1:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2new_name_Left  != "null" ) AND (n2new_name_Left  != "\"\"" ) AND (n2name != n2new_name_Left) AND (n2diff_kind_Left == "\"MODIFY\"")) OR ((n2new_name_Right  != "null" ) AND (n2new_name_Right  != "\"\"" ) AND (n2name != n2new_name_Right) AND (n2diff_kind_Right == "\"MODIFY\""))] 
		}
//----------------------------------------------------------------------

		rule moveAndRenameClassAcrossPackage(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n3diff_kind_Left:EString,VAR n3diff_kind_Right:EString,VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString,VAR n2new_name_Left:EString,VAR n2name:EString,VAR n2new_name_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n2:DiffEClass{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
					preserve new_name_Left =  n2new_name_Left
					preserve name =  n2name
					preserve new_name_Right =  n2new_name_Right
				}			      		
				 delete				node n3:DiffEPackage_eclassifiers{
					delete diff_kind_Left = n3diff_kind_Left
					delete diff_kind_Right = n3diff_kind_Right
				}
				 preserve			node n4:EPackage			      		
				 preserve			node n5:DiffEPackage_eclassifiers{
					preserve diff_kind_Left = n5diff_kind_Left
					preserve diff_kind_Right = n5diff_kind_Right
				}			      		
				 create				node n6:SemanticDiff{
					create name = "\"move And Rename Class Across Package\""
				}
			edges[
			  		(preserve	n0->n2:eclassifiers),
			  		(delete		n0->n3:diffeclassifiers),
			  		(delete		n3->n2:eType),
			  		(preserve	n4->n5:diffeclassifiers),
			  		(preserve	n5->n2:eType),
			  		(create		n6->n5:SemanticObject_DiffEPackage_eclassifiers),
			  		(create		n6->n2:SemanticObject_EClass),
			  		(create		n6->n0:SemanticObject_EPackage),
			  		(create		n6->n4:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2new_name_Left  != "null" ) AND (n2new_name_Left  != "\"\"" ) AND (n2name != n2new_name_Left) AND (n2diff_kind_Left == "\"MODIFY\"") AND (n3diff_kind_Left == "\"DELETE\"") AND (n5diff_kind_Left == "\"ADD\"")) OR ((n2new_name_Right  != "null" ) AND (n2new_name_Right  != "\"\"" ) AND (n2name != n2new_name_Right) AND (n2diff_kind_Right == "\"MODIFY\"") AND (n3diff_kind_Right == "\"DELETE\"") AND (n5diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule moveClass(VAR n1diff_kind_Left:EString,VAR n1diff_kind_Right:EString,VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n1name:EString,VAR n2name:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 delete				node n1:DiffEClass{
					delete diff_kind_Left = n1diff_kind_Left
					delete diff_kind_Right = n1diff_kind_Right
					delete name =  n1name
				}
				 preserve			node n2:DiffEClass{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
					preserve name =  n2name
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"moveClass\""
				}
			edges[
			  		(delete		n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n1name == n2name) AND (n1diff_kind_Left == "\"DELETE\"") AND (n2diff_kind_Left == "\"ADD\"")) OR ((n1name == n2name) AND (n1diff_kind_Right == "\"DELETE\"") AND (n2diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule moveClass2(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n3diff_kind_Left:EString,VAR n3diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 delete				node n2:DiffEPackage_eclassifiers{
					delete diff_kind_Left = n2diff_kind_Left
					delete diff_kind_Right = n2diff_kind_Right
				}
				 preserve			node n3:DiffEPackage_eclassifiers{
					preserve diff_kind_Left = n3diff_kind_Left
					preserve diff_kind_Right = n3diff_kind_Right
				}			      		
				 create				node n4:SemanticDiff{
					create name = "\"moveClass\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(delete		n0->n2:diffeclassifiers),
			  		(preserve	n0->n3:diffeclassifiers),
			  		(delete		n2->n1:eType),
			  		(preserve	n3->n1:eType),
			  		(create		n4->n1:SemanticObject_EClass),
			  		(create		n4->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"DELETE\"") AND (n3diff_kind_Left == "\"ADD\"")) OR ((n2diff_kind_Right == "\"DELETE\"") AND (n3diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule moveClass3(VAR n1diff_kind_Left:EString,VAR n1diff_kind_Right:EString,VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n1name:EString,VAR n2name:EString,VAR n3name:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 delete				node n1:DiffEClass{
					delete diff_kind_Left = n1diff_kind_Left
					delete diff_kind_Right = n1diff_kind_Right
					delete name =  n1name
				}
				 preserve			node n2:DiffEClass{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
					preserve name =  n2name
				}			      		
				 preserve			node n3:EClass{
					preserve name =  n3name
				}			      		
				 create				node n4:SemanticDiff{
					create name = "\"moveClass\""
				}
			edges[
			  		(delete		n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n0->n3:eclassifiers),
			  		(create		n4->n2:SemanticObject_EClass),
			  		(create		n4->n3:SemanticObject_EClass),
			  		(create		n4->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n1name == n2name) AND ("n3name.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n1diff_kind_Left == "\"DELETE\"") AND (n2diff_kind_Left == "\"ADD\"")) OR ((n1name == n2name) AND ("n3name.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n1diff_kind_Right == "\"DELETE\"") AND (n2diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule moveClass4(VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString,VAR n2name:EString,VAR n1name:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass{
					preserve name =  n1name
				}			      		
				 preserve			node n2:EClass{
					preserve name =  n2name
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"moveClass\""
				}
				 delete				node n4:DiffEPackage_eclassifiers{
					delete diff_kind_Left = n4diff_kind_Left
					delete diff_kind_Right = n4diff_kind_Right
				}
				 preserve			node n5:DiffEPackage_eclassifiers{
					preserve diff_kind_Left = n5diff_kind_Left
					preserve diff_kind_Right = n5diff_kind_Right
				}			      		
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(delete		n0->n4:diffeclassifiers),
			  		(preserve	n0->n5:diffeclassifiers),
			  		(create		n3->n1:SemanticObject_EClass),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n0:SemanticObject_EPackage),
			  		(delete		n4->n1:eType),
			  		(preserve	n5->n1:eType)
	      		 ]
			}
			conditions [(("n2name.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n4diff_kind_Left == "\"DELETE\"") AND (n5diff_kind_Left == "\"ADD\"")) OR (("n2name.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n4diff_kind_Right == "\"DELETE\"") AND (n5diff_kind_Right == "\"ADD\""))] 
		}
