		rule extractMethod(VAR n1diff_kind_Left:EString,VAR n1diff_kind_Right:EString,VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n1new_methodBody_Left:EString,VAR n2name:EString,VAR n1new_methodBody_Right:EString)
		{
			graph
			{
				 preserve			node n1:DiffEOperation{
					preserve diff_kind_Left = n1diff_kind_Left
					preserve diff_kind_Right = n1diff_kind_Right
					preserve new_methodBody_Left =  n1new_methodBody_Left
					preserve new_methodBody_Right =  n1new_methodBody_Right
				}			      		
				 preserve			node n2:DiffEOperation{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
					preserve name =  n2name
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"extractMethod\""
				}
				 forbid			node n4:SemanticDiff{
					forbid name = "\"extractMethod\""
				}					
			edges[
			  		(create		n3->n2:SemanticObject_EOperation),
			  		(create		n3->n1:SemanticObject_EOperation),
			  		(forbid		n4->n2:SemanticObject_EOperation),
			  		(forbid		n4->n1:SemanticObject_EOperation)
	      		 ]
			}
			conditions [((n1new_methodBody_Left  != "null" ) AND (n1new_methodBody_Left  != "\"\"" ) AND ("n1new_methodBody_Left.contains('method invocation; ' + n2name.replace('()',';'))" == 'true') AND (n1diff_kind_Left == "\"MODIFY\"") AND (n2diff_kind_Left == "\"ADD\"")) OR ((n1new_methodBody_Right  != "null" ) AND (n1new_methodBody_Right  != "\"\"" ) AND ("n1new_methodBody_Right.contains('method invocation; ' + n2name.replace('()',';'))" == 'true') AND (n1diff_kind_Right == "\"MODIFY\"") AND (n2diff_kind_Right == "\"ADD\""))] 
		}
