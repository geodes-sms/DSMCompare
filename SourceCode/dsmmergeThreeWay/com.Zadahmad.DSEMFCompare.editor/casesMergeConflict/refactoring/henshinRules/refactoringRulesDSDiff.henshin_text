				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"extractMethod\""
				}
				 forbid			node n4:SemanticDiff{
					forbid name = "\"extractMethod\""
				}					
			edges[
			  		(create		n3->n2:SemanticObject_EOperation),
			  		(create		n3->n1:SemanticObject_EOperation),
			  		(forbid		n4->n2:SemanticObject_EOperation),
			  		(forbid		n4->n1:SemanticObject_EOperation)
	      		 ]
			}
			conditions [((n1new_methodBody_Left  != "null" ) AND (n1new_methodBody_Left  != "\"\"" ) AND ("n1new_methodBody_Left.contains('method invocation; ' + n2name.replace('()',';'))" == 'true') AND (n1diff_kind_Left == "\"MODIFY\"") AND (n2diff_kind_Left == "\"MODIFY\"")) OR ((n1new_methodBody_Right  != "null" ) AND (n1new_methodBody_Right  != "\"\"" ) AND ("n1new_methodBody_Right.contains('method invocation; ' + n2name.replace('()',';'))" == 'true') AND (n1diff_kind_Right == "\"MODIFY\"") AND (n2diff_kind_Right == "\"MODIFY\""))] 
		}
