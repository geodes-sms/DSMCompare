		rule moveMethod(VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString,VAR n6diff_kind_Left:EString,VAR n6diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:EClass			      		
				 create				node n3:SemanticDiff{
					create name = "\"moveMethod\""
