		rule changePackage(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n2new_packageName_Left:EString,VAR n2packageName:EString,VAR n2new_packageName_Right:EString)
		{
			graph
			{
				 preserve			node n1:EPackage			      		
				 preserve			node n2:DiffEClass{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
					preserve new_packageName_Left =  n2new_packageName_Left
					preserve packageName =  n2packageName
					preserve new_packageName_Right =  n2new_packageName_Right
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"change Package\""
				}
				 forbid			node n4:SemanticDiff{
					forbid name = "\"change Package\""
				}					
			edges[
			  		(preserve	n1->n2:eclassifiers)
	      		 ]
			}
			conditions [((n2new_packageName_Left  != "null" ) AND (n2new_packageName_Left  != "\"\"" ) AND (n2packageName != n2new_packageName_Left) AND (n2diff_kind_Left == "\"MODIFY\"")) OR ((n2new_packageName_Right  != "null" ) AND (n2new_packageName_Right  != "\"\"" ) AND (n2packageName != n2new_packageName_Right) AND (n2diff_kind_Right == "\"MODIFY\""))] 
