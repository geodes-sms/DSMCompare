			  		(forbid		n5->n2:SemanticObject_EOperation),
			  		(forbid		n5->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n3methodBody  != "null" ) AND (n3methodBody  != "\"\"" ) AND (n2methodBody != n3methodBody) AND ("n2methodBody.trim().contains(n3methodBody.trim().replace('return;',''))" == 'true') AND (n2diff_kind_Left == "\"MODIFY\"") AND (n3diff_kind_Left == "\"ADD\"")) OR ((n3methodBody  != "null" ) AND (n3methodBody  != "\"\"" ) AND (n2methodBody != n3methodBody) AND ("n2methodBody.trim().contains(n3methodBody.trim().replace('return;',''))" == 'true') AND (n2diff_kind_Right == "\"MODIFY\"") AND (n3diff_kind_Right == "\"ADD\""))] 
