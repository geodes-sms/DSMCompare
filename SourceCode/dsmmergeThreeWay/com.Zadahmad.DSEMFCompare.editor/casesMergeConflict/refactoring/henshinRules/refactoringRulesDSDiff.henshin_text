		rule extractSuperclass3(VAR n1diff_kind_Left:EString,VAR n1diff_kind_Right:EString,VAR n2name:EString,VAR n1new_extends_Left:EString,VAR n1new_extends_Right:EString)
		{
			graph
			{
				 preserve			node n1:DiffEClass{
					preserve diff_kind_Left = n1diff_kind_Left
					preserve diff_kind_Right = n1diff_kind_Right
					preserve new_extends_Left =  n1new_extends_Left
					preserve new_extends_Right =  n1new_extends_Right
				}			      		
				 preserve			node n2:EClass{
					preserve name =  n2name
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"Extract Superclass\""
				}
				 forbid			node n4:SemanticDiff{
					forbid name = "\"Extract Superclass\""
				}					
			edges[
			  		(create		n3->n1:SemanticObject_EClass),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(forbid		n4->n1:SemanticObject_EClass),
			  		(forbid		n4->n2:SemanticObject_EClass)
	      		 ]
			}
			conditions [((n2name  != "\"\"" ) AND (n1new_extends_Left  != "null" ) AND (n2name  != "null" ) AND (n1new_extends_Left  != "\"\"" ) AND (n1new_extends_Left == n2name) AND (n1diff_kind_Left == "\"MODIFY\"")) OR ((n2name  != "\"\"" ) AND (n1new_extends_Right  != "null" ) AND (n2name  != "null" ) AND (n1new_extends_Right  != "\"\"" ) AND (n1new_extends_Right == n2name) AND (n1diff_kind_Right == "\"MODIFY\""))] 
		}
//----------------------------------------------------------------------

		rule extractSuperclassAttr(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n6diff_kind_Left:EString,VAR n6diff_kind_Right:EString,VAR n7diff_kind_Left:EString,VAR n7diff_kind_Right:EString,VAR n8diff_kind_Left:EString,VAR n8diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:DiffEClass{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"extractSuperclassAttr\""
				}
				 preserve			node n4:EAttribute			      		
				 delete				node n6:DiffEClass_eattributes{
					delete diff_kind_Left = n6diff_kind_Left
					delete diff_kind_Right = n6diff_kind_Right
				}
				 preserve			node n7:DiffEClass_esupertypes{
					preserve diff_kind_Left = n7diff_kind_Left
					preserve diff_kind_Right = n7diff_kind_Right
				}			      		
				 preserve			node n8:DiffEClass_eattributes{
					preserve diff_kind_Left = n8diff_kind_Left
					preserve diff_kind_Right = n8diff_kind_Right
				}			      		
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n1->n4:eattributes),
			  		(preserve	n1->n2:esupertypes),
			  		(delete		n1->n6:diffeattributes),
			  		(preserve	n1->n7:diffesupertypes),
			  		(preserve	n2->n8:diffeattributes),
			  		(create		n3->n8:SemanticObject_DiffEClass_eattributes),
			  		(create		n3->n7:SemanticObject_DiffEClass_esupertypes),
			  		(create		n3->n4:SemanticObject_EAttribute),
			  		(create		n3->n1:SemanticObject_EClass),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n0:SemanticObject_EPackage),
			  		(delete		n6->n4:eType),
			  		(preserve	n7->n2:eType),
			  		(preserve	n8->n4:eType)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"ADD\"") AND (n6diff_kind_Left == "\"DELETE\"") AND (n7diff_kind_Left == "\"ADD\"") AND (n8diff_kind_Left == "\"ADD\"")) OR ((n2diff_kind_Right == "\"ADD\"") AND (n6diff_kind_Right == "\"DELETE\"") AND (n7diff_kind_Right == "\"ADD\"") AND (n8diff_kind_Right == "\"ADD\""))] 
		}
