		rule moveClassAcrossPackage(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 delete				node n2:DiffEPackage_eclassifiers{
					delete diff_kind_Left = n2diff_kind_Left
					delete diff_kind_Right = n2diff_kind_Right
				}
				 preserve			node n3:EPackage			      		
				 preserve			node n4:DiffEPackage_eclassifiers{
					preserve diff_kind_Left = n4diff_kind_Left
					preserve diff_kind_Right = n4diff_kind_Right
				}			      		
				 create				node n5:SemanticDiff{
					create name = "\"move Class Across Package\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(delete		n0->n2:diffeclassifiers),
			  		(delete		n2->n1:eType),
			  		(preserve	n3->n4:diffeclassifiers),
			  		(preserve	n4->n1:eType),
			  		(create		n5->n4:SemanticObject_DiffEPackage_eclassifiers),
			  		(create		n5->n1:SemanticObject_EClass),
			  		(create		n5->n0:SemanticObject_EPackage),
			  		(create		n5->n3:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"DELETE\"") AND (n4diff_kind_Left == "\"ADD\"")) OR ((n2diff_kind_Right == "\"DELETE\"") AND (n4diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule extractAndMoveMethod2(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n1name:EString,VAR n3name:EString,VAR n4methodBody:EString,VAR n2methodBody:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass{
					preserve name =  n1name
				}			      		
				 preserve			node n2:DiffEOperation{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
					preserve methodBody =  n2methodBody
				}			      		
				 preserve			node n3:EClass{
					preserve name =  n3name
				}			      		
				 preserve			node n4:DiffEOperation{
					preserve diff_kind_Left = n4diff_kind_Left
					preserve diff_kind_Right = n4diff_kind_Right
					preserve methodBody =  n4methodBody
				}			      		
				 create				node n5:SemanticDiff{
					create name = "\"Extract And Move Method\""
				}
				 forbid			node n6:SemanticDiff{
					forbid name = "\"Extract And Move Method\""
				}					
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n3:eclassifiers),
			  		(preserve	n1->n2:eoperations),
			  		(preserve	n3->n4:eoperations),
			  		(create		n5->n1:SemanticObject_EClass),
			  		(create		n5->n3:SemanticObject_EClass),
			  		(create		n5->n4:SemanticObject_EOperation),
			  		(create		n5->n2:SemanticObject_EOperation),
			  		(forbid		n6->n1:SemanticObject_EClass),
			  		(forbid		n6->n3:SemanticObject_EClass),
			  		(forbid		n6->n4:SemanticObject_EOperation),
			  		(forbid		n6->n2:SemanticObject_EOperation)
	      		 ]
			}
			conditions [((n1name != n3name) AND (n4methodBody  != "null" ) AND (n4methodBody  != "\"\"" ) AND (n2methodBody != n4methodBody) AND ("n2methodBody.trim().contains(n4methodBody.trim().replace('return;',''))" == 'true') AND (n2diff_kind_Left == "\"MODIFY\"") AND (n4diff_kind_Left == "\"ADD\"")) OR ((n1name != n3name) AND (n4methodBody  != "null" ) AND (n4methodBody  != "\"\"" ) AND (n2methodBody != n4methodBody) AND ("n2methodBody.trim().contains(n4methodBody.trim().replace('return;',''))" == 'true') AND (n2diff_kind_Right == "\"MODIFY\"") AND (n4diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule extractAndMoveMethod3(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n1name:EString,VAR n3name:EString,VAR n4name:EString,VAR n2new_methodBody_Left:EString,VAR n2new_methodBody_Right:EString)
