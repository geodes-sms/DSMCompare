		rule extractMethod5(VAR n1diff_kind_Left:EString,VAR n1diff_kind_Right:EString,VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n1new_methodBody_Left:EString,VAR n2name:EString,VAR n1new_methodBody_Right:EString)
