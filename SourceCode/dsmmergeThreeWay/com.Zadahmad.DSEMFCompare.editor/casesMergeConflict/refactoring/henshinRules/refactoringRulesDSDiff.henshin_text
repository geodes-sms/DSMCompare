		rule pushDownMethod33(VAR n11diff_kind_Left:EString,VAR n11diff_kind_Right:EString,VAR n12diff_kind_Left:EString,VAR n12diff_kind_Right:EString,VAR n1name:EString,VAR n2extends:EString,VAR n11name:EString,VAR n12name:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass{
					preserve name =  n1name
				}			      		
				 preserve			node n2:EClass{
					preserve extends =  n2extends
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"pushDownMethod\""
				}
				 forbid			node n4:SemanticDiff{
					forbid name = "\"pushDownMethod\""
				}					
				 preserve			node n11:DiffEOperation{
					preserve diff_kind_Left = n11diff_kind_Left
					preserve diff_kind_Right = n11diff_kind_Right
					preserve name =  n11name
				}			      		
				 delete				node n12:DiffEOperation{
					delete diff_kind_Left = n12diff_kind_Left
					delete diff_kind_Right = n12diff_kind_Right
					delete name =  n12name
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(delete		n1->n12:eoperations),
			  		(preserve	n2->n11:eoperations),
			  		(create		n3->n1:SemanticObject_EClass),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n11:SemanticObject_EOperation),
			  		(create		n3->n0:SemanticObject_EPackage),
			  		(forbid		n4->n1:SemanticObject_EClass),
			  		(forbid		n4->n2:SemanticObject_EClass),
			  		(forbid		n4->n11:SemanticObject_EOperation),
			  		(forbid		n4->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n1name  != "null" ) AND (n1name  != "\"\"" ) AND (n2extends  != "null" ) AND (n2extends  != "\"\"" ) AND (n11name  != "null" ) AND (n11name  != "\"\"" ) AND (n12name  != "null" ) AND (n12name  != "\"\"" ) AND (n11name == n12name) AND ("n2extends.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n11diff_kind_Left == "\"ADD\"") AND (n12diff_kind_Left == "\"DELETE\"")) OR ((n1name  != "null" ) AND (n1name  != "\"\"" ) AND (n2extends  != "null" ) AND (n2extends  != "\"\"" ) AND (n11name  != "null" ) AND (n11name  != "\"\"" ) AND (n12name  != "null" ) AND (n12name  != "\"\"" ) AND (n11name == n12name) AND ("n2extends.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n11diff_kind_Right == "\"ADD\"") AND (n12diff_kind_Right == "\"DELETE\""))] 
		}
//----------------------------------------------------------------------

		rule pushDownMethod(VAR n3diff_kind_Left:EString,VAR n3diff_kind_Right:EString,VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:EOperation			      		
				 delete				node n3:DiffEClass_eoperations{
					delete diff_kind_Left = n3diff_kind_Left
					delete diff_kind_Right = n3diff_kind_Right
				}
				 preserve			node n4:EClass			      		
				 preserve			node n5:DiffEClass_eoperations{
					preserve diff_kind_Left = n5diff_kind_Left
					preserve diff_kind_Right = n5diff_kind_Right
				}			      		
				 create				node n6:SemanticDiff{
					create name = "\"push-Down Method\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n4:eclassifiers),
			  		(preserve	n1->n2:eoperations),
			  		(delete		n1->n3:diffeoperations),
			  		(delete		n3->n2:eType),
			  		(preserve	n4->n1:esupertypes),
			  		(preserve	n4->n5:diffeoperations),
			  		(preserve	n5->n2:eType),
			  		(create		n6->n1:SemanticObject_EClass),
			  		(create		n6->n4:SemanticObject_EClass),
			  		(create		n6->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n3diff_kind_Left == "\"DELETE\"") AND (n5diff_kind_Left == "\"ADD\"")) OR ((n3diff_kind_Right == "\"DELETE\"") AND (n5diff_kind_Right == "\"ADD\""))] 
		}
