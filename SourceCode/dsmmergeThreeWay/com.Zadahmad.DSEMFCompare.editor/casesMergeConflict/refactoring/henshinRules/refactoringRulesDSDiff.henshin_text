		rule renamePackage(VAR n1diff_kind_Left:EString,VAR n1diff_kind_Right:EString,VAR n1new_name_Left:EString,VAR n1name:EString,VAR n1new_name_Right:EString)
		{
			graph
			{
				 preserve			node n1:DiffEPackage{
					preserve diff_kind_Left = n1diff_kind_Left
					preserve diff_kind_Right = n1diff_kind_Right
					preserve new_name_Left =  n1new_name_Left
					preserve name =  n1name
					preserve new_name_Right =  n1new_name_Right
				}			      		
				 create				node n2:SemanticDiff{
					create name = "\"rename Package\""
				}
				 forbid			node n3:SemanticDiff{
					forbid name = "\"rename Package\""
				}					
			edges[
			  		(create		n2->n1:SemanticObject_EPackage),
			  		(forbid		n3->n1:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n1new_name_Left  != "null" ) AND (n1new_name_Left  != "\"\"" ) AND (n1name != n1new_name_Left) AND (n1diff_kind_Left == "\"MODIFY\"")) OR ((n1new_name_Right  != "null" ) AND (n1new_name_Right  != "\"\"" ) AND (n1name != n1new_name_Right) AND (n1diff_kind_Right == "\"MODIFY\""))] 
		}
