			  		(forbid		n6->n2:SemanticObject_EOperation),
			  		(forbid		n6->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n1name != n3name) AND (n4name  != "null" ) AND (n4name  != "\"\"" ) AND (n2new_methodBody_Left  != "null" ) AND (n2new_methodBody_Left  != "\"\"" ) AND ("n2new_methodBody_Left.trim().contains(n3name.trim().replace('return;',''))" == 'true') AND (n2diff_kind_Left == "\"MODIFY\"") AND (n4diff_kind_Left == "\"ADD\"")) OR ((n1name != n3name) AND (n4name  != "null" ) AND (n4name  != "\"\"" ) AND (n2new_methodBody_Right  != "null" ) AND (n2new_methodBody_Right  != "\"\"" ) AND ("n2new_methodBody_Right.trim().contains(n3name.trim().replace('return;',''))" == 'true') AND (n2diff_kind_Right == "\"MODIFY\"") AND (n4diff_kind_Right == "\"ADD\""))] 
		}
