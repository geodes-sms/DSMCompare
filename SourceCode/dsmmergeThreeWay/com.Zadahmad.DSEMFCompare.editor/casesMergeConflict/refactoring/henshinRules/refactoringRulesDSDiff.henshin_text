		rule extractSuperclass(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n7diff_kind_Left:EString,VAR n7diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:DiffEClass{
					preserve diff_kind_Left = n2diff_kind_Left
					preserve diff_kind_Right = n2diff_kind_Right
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"extractSuperclass\""
				}
				 delete				node n7:DiffEClass_esupertypes{
					delete diff_kind_Left = n7diff_kind_Left
					delete diff_kind_Right = n7diff_kind_Right
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n1->n2:esupertypes),
			  		(delete		n1->n7:diffesupertypes),
			  		(create		n3->n1:SemanticObject_EClass),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n0:SemanticObject_EPackage),
			  		(delete		n7->n2:eType)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"ADD\"") AND (n7diff_kind_Left == "\"ADD\"")) OR ((n2diff_kind_Right == "\"ADD\"") AND (n7diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule extractSuperclass2(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 delete				node n2:DiffEClass_esupertypes{
					delete diff_kind_Left = n2diff_kind_Left
					delete diff_kind_Right = n2diff_kind_Right
				}
				 preserve			node n3:EClass			      		
				 create				node n4:SemanticDiff{
					create name = "\"extractSuperclass\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n3:eclassifiers),
			  		(delete		n1->n2:diffesupertypes),
			  		(delete		n2->n3:eType),
			  		(create		n4->n1:SemanticObject_EClass),
			  		(create		n4->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"ADD\"")) OR ((n2diff_kind_Right == "\"ADD\""))] 
		}
