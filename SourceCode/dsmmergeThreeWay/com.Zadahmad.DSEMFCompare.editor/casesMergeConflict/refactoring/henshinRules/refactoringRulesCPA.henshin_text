				 preserve			node n1:EClass			      		
				 delete				node n2:DiffEAttribute{
					delete name =  n2name
				}
				 preserve			node n3:EClass			      		
				 preserve			node n4:DiffEAttribute{
					preserve name =  n4name
				}			      		
				 create				node n5:SemanticDiff{
					create name = "\"moveAttribute\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n3:eclassifiers),
			  		(delete		n1->n2:eattributes),
			  		(preserve	n3->n4:eattributes),
			  		(create		n5->n4:SemanticObject_EAttribute),
			  		(create		n5->n1:SemanticObject_EClass),
			  		(create		n5->n3:SemanticObject_EClass),
			  		(create		n5->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2name == n4name) AND (n2diff_kind_Left == "\"DELETE\"") AND (n4diff_kind_Left == "\"ADD\"")) OR ((n2name == n4name) AND (n2diff_kind_Right == "\"DELETE\"") AND (n4diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule renameClass(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n2new_name_Left:EString,VAR n2name:EString,VAR n2new_name_Right:EString)
		{
			graph
			{
				 preserve			node n1:EPackage			      		
				 preserve			node n2:DiffEClass{
					preserve new_name_Left =  n2new_name_Left
					preserve name =  n2name
					preserve new_name_Right =  n2new_name_Right
				}			      		
				 create				node n3:SemanticDiff{
					create name = "\"renameClass\""
				}
			edges[
			  		(preserve	n1->n2:eclassifiers),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n1:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2new_name_Left  != "null" ) AND (n2new_name_Left  != "\"\"" ) AND (n2name != n2new_name_Left) AND (n2diff_kind_Left == "\"MODIFY\"")) OR ((n2new_name_Right  != "null" ) AND (n2new_name_Right  != "\"\"" ) AND (n2name != n2new_name_Right) AND (n2diff_kind_Right == "\"MODIFY\""))] 
		}
//----------------------------------------------------------------------

		rule renameMethod(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n2new_name_Left:EString,VAR n2name:EString,VAR n2new_name_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:DiffEOperation{
