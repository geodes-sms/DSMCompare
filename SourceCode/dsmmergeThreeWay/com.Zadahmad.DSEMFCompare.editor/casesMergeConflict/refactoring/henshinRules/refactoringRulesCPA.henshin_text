			  		(preserve	n3->n4:eoperations),
			  		(create		n5->n1:SemanticObject_EClass),
			  		(create		n5->n3:SemanticObject_EClass),
			  		(create		n5->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2name == n4name) AND (n2eparameters == n4eparameters) AND (n2methodBody == n4methodBody) AND (n2diff_kind_Left == "\"DELETE\"") AND (n4diff_kind_Left == "\"ADD\"")) OR ((n2name == n4name) AND (n2eparameters == n4eparameters) AND (n2methodBody == n4methodBody) AND (n2diff_kind_Right == "\"DELETE\"") AND (n4diff_kind_Right == "\"ADD\""))] 
