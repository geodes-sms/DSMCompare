		}
//----------------------------------------------------------------------

		rule extractMethod4(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n3diff_kind_Left:EString,VAR n3diff_kind_Right:EString,VAR n3name:EString,VAR n2new_methodBody_Left:EString,VAR n2new_methodBody_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:DiffEOperation{
					preserve new_methodBody_Left =  n2new_methodBody_Left
					preserve new_methodBody_Right =  n2new_methodBody_Right
				}			      		
				 preserve			node n3:DiffEOperation{
					preserve name =  n3name
				}			      		
				 create				node n4:SemanticDiff{
					create name = "\"extractMethod\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n1->n2:eoperations),
			  		(preserve	n1->n3:eoperations),
			  		(create		n4->n1:SemanticObject_EClass),
			  		(create		n4->n2:SemanticObject_EOperation),
			  		(create		n4->n3:SemanticObject_EOperation),
			  		(create		n4->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n3name  != "null" ) AND (n2new_methodBody_Left  != "null" ) AND (n2new_methodBody_Left  != "\"\"" ) AND (n3name  != "\"\"" ) AND ("n2new_methodBody_Left.trim().contains(n3name.trim().replace('return;',''))" == 'true') AND (n2diff_kind_Left == "\"MODIFY\"") AND (n3diff_kind_Left == "\"ADD\"")) OR ((n3name  != "null" ) AND (n2new_methodBody_Right  != "null" ) AND (n2new_methodBody_Right  != "\"\"" ) AND (n3name  != "\"\"" ) AND ("n2new_methodBody_Right.trim().contains(n3name.trim().replace('return;',''))" == 'true') AND (n2diff_kind_Right == "\"MODIFY\"") AND (n3diff_kind_Right == "\"ADD\""))] 
		}
