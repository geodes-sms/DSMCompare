		rule moveAttribute2(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n2name:EString,VAR n4name:EString)
