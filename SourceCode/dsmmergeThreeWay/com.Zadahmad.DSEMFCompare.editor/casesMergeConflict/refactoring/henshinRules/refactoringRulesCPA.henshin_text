		rule pushDownMethod(VAR n3diff_kind_Left:EString,VAR n3diff_kind_Right:EString,VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:EOperation			      		
				 delete				node n3:DiffEClass_eoperations
				 preserve			node n4:EClass			      		
				 preserve			node n5:DiffEClass_eoperations			      		
				 create				node n6:SemanticDiff{
					create name = "\"push-Down Method\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n4:eclassifiers),
			  		(preserve	n1->n2:eoperations),
			  		(delete		n1->n3:diffeoperations),
			  		(delete		n3->n2:eType),
			  		(preserve	n4->n1:esupertypes),
			  		(preserve	n4->n5:diffeoperations),
			  		(preserve	n5->n2:eType),
			  		(create		n6->n1:SemanticObject_EClass),
			  		(create		n6->n4:SemanticObject_EClass),
			  		(create		n6->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n3diff_kind_Left == "\"DELETE\"") AND (n5diff_kind_Left == "\"ADD\"")) OR ((n3diff_kind_Right == "\"DELETE\"") AND (n5diff_kind_Right == "\"ADD\""))] 
		}
