		rule moveMethod2(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n2name:EString,VAR n4name:EString,VAR n2eparameters:EString,VAR n4eparameters:EString,VAR n2methodBody:EString,VAR n4methodBody:EString)
		{
			graph
