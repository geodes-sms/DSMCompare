		rule flattenHierarchyAttr(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString,VAR n6diff_kind_Left:EString,VAR n6diff_kind_Right:EString,VAR n7diff_kind_Left:EString,VAR n7diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:DiffEClass			      		
				 preserve			node n4:DiffEClass_eattributes			      		
				 delete				node n5:DiffEClass_esupertypes
				 preserve			node n6:DiffEAttribute			      		
				 delete				node n7:DiffEClass_eattributes
				 create				node n3:SemanticDiff{
					create name = "\"flattenHierarchyAttr\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n1->n4:diffeattributes),
			  		(delete		n1->n5:diffesupertypes),
			  		(preserve	n2->n6:eattributes),
			  		(delete		n2->n7:diffeattributes),
			  		(preserve	n4->n6:eType),
			  		(delete		n5->n2:eType),
			  		(delete		n7->n6:eType),
			  		(create		n3->n4:SemanticObject_DiffEClass_eattributes),
			  		(create		n3->n6:SemanticObject_EAttribute),
			  		(create		n3->n1:SemanticObject_EClass),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"DELETE\"") AND (n4diff_kind_Left == "\"ADD\"") AND (n5diff_kind_Left == "\"DELETE\"") AND (n6diff_kind_Left == "\"DELETE\"") AND (n7diff_kind_Left == "\"DELETE\"")) OR ((n2diff_kind_Right == "\"DELETE\"") AND (n4diff_kind_Right == "\"ADD\"") AND (n5diff_kind_Right == "\"DELETE\"") AND (n6diff_kind_Right == "\"DELETE\"") AND (n7diff_kind_Right == "\"DELETE\""))] 
		}
//----------------------------------------------------------------------

		rule mergeMetaClassAttr(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n3diff_kind_Left:EString,VAR n3diff_kind_Right:EString,VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n7diff_kind_Left:EString,VAR n7diff_kind_Right:EString,VAR n8diff_kind_Left:EString,VAR n8diff_kind_Right:EString,VAR n9diff_kind_Left:EString,VAR n9diff_kind_Right:EString,VAR n10diff_kind_Left:EString,VAR n10diff_kind_Right:EString,VAR n11diff_kind_Left:EString,VAR n11diff_kind_Right:EString,VAR n12diff_kind_Left:EString,VAR n12diff_kind_Right:EString,VAR n13diff_kind_Left:EString,VAR n13diff_kind_Right:EString,VAR n14diff_kind_Left:EString,VAR n14diff_kind_Right:EString,VAR n15diff_kind_Left:EString,VAR n15diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:DiffEClass			      		
				 preserve			node n3:DiffEClass			      		
				 preserve			node n4:DiffEClass			      		
				 preserve			node n7:DiffEClass_eattributes			      		
				 preserve			node n8:DiffEClass_eattributes			      		
				 preserve			node n9:DiffEClass_esupertypes			      		
				 preserve			node n10:DiffEAttribute			      		
				 delete				node n11:DiffEClass_eattributes
				 delete				node n12:DiffEClass_esupertypes
				 preserve			node n13:DiffEAttribute			      		
				 delete				node n14:DiffEClass_eattributes
				 delete				node n15:DiffEClass_esupertypes
				 create				node n5:SemanticDiff{
					create name = "\"mergeMetaClassAttr\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n0->n3:eclassifiers),
			  		(preserve	n0->n4:eclassifiers),
			  		(preserve	n2->n1:esupertypes),
			  		(preserve	n2->n7:diffeattributes),
			  		(preserve	n2->n8:diffeattributes),
			  		(preserve	n2->n9:diffesupertypes),
			  		(preserve	n3->n10:eattributes),
			  		(delete		n3->n11:diffeattributes),
			  		(delete		n3->n12:diffesupertypes),
			  		(preserve	n4->n13:eattributes),
			  		(delete		n4->n14:diffeattributes),
			  		(delete		n4->n15:diffesupertypes),
			  		(preserve	n7->n10:eType),
			  		(preserve	n8->n13:eType),
			  		(preserve	n9->n1:eType),
			  		(delete		n11->n10:eType),
			  		(delete		n12->n1:eType),
			  		(delete		n14->n13:eType),
			  		(delete		n15->n1:eType),
			  		(create		n5->n7:SemanticObject_DiffEClass_eattributes),
			  		(create		n5->n8:SemanticObject_DiffEClass_eattributes),
			  		(create		n5->n9:SemanticObject_DiffEClass_esupertypes),
			  		(create		n5->n10:SemanticObject_EAttribute),
			  		(create		n5->n13:SemanticObject_EAttribute),
			  		(create		n5->n1:SemanticObject_EClass),
			  		(create		n5->n2:SemanticObject_EClass),
			  		(create		n5->n3:SemanticObject_EClass),
			  		(create		n5->n4:SemanticObject_EClass),
			  		(create		n5->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"ADD\"") AND (n3diff_kind_Left == "\"DELETE\"") AND (n4diff_kind_Left == "\"DELETE\"") AND (n7diff_kind_Left == "\"ADD\"") AND (n8diff_kind_Left == "\"ADD\"") AND (n9diff_kind_Left == "\"ADD\"") AND (n10diff_kind_Left == "\"DELETE\"") AND (n11diff_kind_Left == "\"DELETE\"") AND (n12diff_kind_Left == "\"DELETE\"") AND (n13diff_kind_Left == "\"DELETE\"") AND (n14diff_kind_Left == "\"DELETE\"") AND (n15diff_kind_Left == "\"DELETE\"")) OR ((n2diff_kind_Right == "\"ADD\"") AND (n3diff_kind_Right == "\"DELETE\"") AND (n4diff_kind_Right == "\"DELETE\"") AND (n7diff_kind_Right == "\"ADD\"") AND (n8diff_kind_Right == "\"ADD\"") AND (n9diff_kind_Right == "\"ADD\"") AND (n10diff_kind_Right == "\"DELETE\"") AND (n11diff_kind_Right == "\"DELETE\"") AND (n12diff_kind_Right == "\"DELETE\"") AND (n13diff_kind_Right == "\"DELETE\"") AND (n14diff_kind_Right == "\"DELETE\"") AND (n15diff_kind_Right == "\"DELETE\""))] 
		}
//----------------------------------------------------------------------

		rule mergeRefrences(VAR n14diff_kind_Left:EString,VAR n14diff_kind_Right:EString,VAR n15diff_kind_Left:EString,VAR n15diff_kind_Right:EString,VAR n16diff_kind_Left:EString,VAR n16diff_kind_Right:EString,VAR n8etype:EString,VAR n15etype:EString,VAR n9etype:EString,VAR n16etype:EString,VAR n1name:EString,VAR n2name:EString,VAR n3name:EString,VAR n14etype:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass{
					preserve name =  n1name
				}			      		
				 preserve			node n2:EClass{
					preserve name =  n2name
				}			      		
				 preserve			node n3:EClass{
					preserve name =  n3name
				}			      		
				 preserve			node n4:EClass			      		
				 preserve			node n8:EReference{
					preserve etype =  n8etype
				}			      		
				 preserve			node n9:EReference{
					preserve etype =  n9etype
				}			      		
				 preserve			node n14:DiffEReference{
					preserve etype =  n14etype
				}			      		
				 delete				node n15:DiffEReference{
					delete etype =  n15etype
				}
				 delete				node n16:DiffEReference{
					delete etype =  n16etype
				}
				 create				node n5:SemanticDiff{
					create name = "\"mergeRefrences\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n0->n3:eclassifiers),
			  		(preserve	n0->n4:eclassifiers),
			  		(preserve	n1->n3:esupertypes),
			  		(preserve	n2->n3:esupertypes),
			  		(preserve	n3->n8:ereferences),
			  		(preserve	n3->n9:ereferences),
			  		(preserve	n4->n14:ereferences),
			  		(delete		n4->n15:ereferences),
			  		(delete		n4->n16:ereferences),
			  		(create		n5->n1:SemanticObject_EClass),
			  		(create		n5->n2:SemanticObject_EClass),
			  		(create		n5->n4:SemanticObject_EClass),
			  		(create		n5->n0:SemanticObject_EPackage),
			  		(create		n5->n8:SemanticObject_EReference),
			  		(create		n5->n9:SemanticObject_EReference),
			  		(create		n5->n14:SemanticObject_EReference)
	      		 ]
			}
			conditions [((n8etype == n15etype) AND (n9etype == n16etype) AND (n1name == n8etype) AND (n2name == n9etype) AND (n3name == n14etype) AND (n14diff_kind_Left == "\"ADD\"") AND (n15diff_kind_Left == "\"DELETE\"") AND (n16diff_kind_Left == "\"DELETE\"")) OR ((n8etype == n15etype) AND (n9etype == n16etype) AND (n1name == n8etype) AND (n2name == n9etype) AND (n3name == n14etype) AND (n14diff_kind_Right == "\"ADD\"") AND (n15diff_kind_Right == "\"DELETE\"") AND (n16diff_kind_Right == "\"DELETE\""))] 
		}
//----------------------------------------------------------------------

		rule pushDownRefrence(VAR n6diff_kind_Left:EString,VAR n6diff_kind_Right:EString,VAR n9diff_kind_Left:EString,VAR n9diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:EClass			      		
				 preserve			node n4:EReference			      		
				 delete				node n6:DiffEClass_ereferences
				 preserve			node n9:DiffEClass_ereferences			      		
				 create				node n3:SemanticDiff{
					create name = "\"pushDownRefrence\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n1->n4:ereferences),
			  		(delete		n1->n6:differeferences),
			  		(preserve	n2->n1:esupertypes),
			  		(preserve	n2->n9:differeferences),
			  		(delete		n6->n4:eType),
			  		(preserve	n9->n4:eType),
			  		(create		n3->n9:SemanticObject_DiffEClass_ereferences),
			  		(create		n3->n1:SemanticObject_EClass),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n0:SemanticObject_EPackage),
			  		(create		n3->n4:SemanticObject_EReference)
	      		 ]
			}
			conditions [((n6diff_kind_Left == "\"DELETE\"") AND (n9diff_kind_Left == "\"ADD\"")) OR ((n6diff_kind_Right == "\"DELETE\"") AND (n9diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule pullUpRefrence(VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n8diff_kind_Left:EString,VAR n8diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:EClass			      		
				 preserve			node n4:DiffEClass_ereferences			      		
				 preserve			node n6:EReference			      		
				 delete				node n8:DiffEClass_ereferences
				 create				node n3:SemanticDiff{
					create name = "\"pullUpRefrence\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n1->n4:differeferences),
			  		(preserve	n2->n6:ereferences),
			  		(preserve	n2->n1:esupertypes),
			  		(delete		n2->n8:differeferences),
			  		(preserve	n4->n6:eType),
			  		(delete		n8->n6:eType),
			  		(create		n3->n4:SemanticObject_DiffEClass_ereferences),
			  		(create		n3->n1:SemanticObject_EClass),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n0:SemanticObject_EPackage),
			  		(create		n3->n6:SemanticObject_EReference)
	      		 ]
			}
			conditions [((n4diff_kind_Left == "\"ADD\"") AND (n8diff_kind_Left == "\"DELETE\"")) OR ((n4diff_kind_Right == "\"ADD\"") AND (n8diff_kind_Right == "\"DELETE\""))] 
		}
