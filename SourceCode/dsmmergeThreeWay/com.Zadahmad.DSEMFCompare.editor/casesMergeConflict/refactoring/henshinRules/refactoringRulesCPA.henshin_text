		rule moveAndRenameClass(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n2new_packageName_Left:EString,VAR n2new_name_Left:EString,VAR n2name:EString,VAR n2packageName:EString,VAR n2new_packageName_Right:EString,VAR n2new_name_Right:EString)
		{
			graph
			{
				 preserve			node n1:EPackage			      		
				 preserve			node n2:DiffEClass{
					preserve new_packageName_Left =  n2new_packageName_Left
					preserve new_name_Left =  n2new_name_Left
					preserve name =  n2name
					preserve packageName =  n2packageName
					preserve new_packageName_Right =  n2new_packageName_Right
					preserve new_name_Right =  n2new_name_Right
				}			      		
				 forbid			node n4:SemanticDiff{
					forbid name = "\"Move And Rename Class\""
				}					
			edges[
			  		(preserve	n1->n2:eclassifiers),
			  		(forbid		n4->n2:SemanticObject_EClass),
			  		(forbid		n4->n1:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n2new_packageName_Left  != "null" ) AND (n2new_packageName_Left  != "\"\"" ) AND (n2new_name_Left  != "null" ) AND (n2new_name_Left  != "\"\"" ) AND (n2name != n2new_name_Left) AND (n2packageName != n2new_packageName_Left) AND (n2diff_kind_Left == "\"MODIFY\"")) OR ((n2new_packageName_Right  != "null" ) AND (n2new_packageName_Right  != "\"\"" ) AND (n2new_name_Right  != "null" ) AND (n2new_name_Right  != "\"\"" ) AND (n2name != n2new_name_Right) AND (n2packageName != n2new_packageName_Right) AND (n2diff_kind_Right == "\"MODIFY\""))] 
		}
//----------------------------------------------------------------------

		rule moveClass4(VAR n4diff_kind_Left:EString,VAR n4diff_kind_Right:EString,VAR n5diff_kind_Left:EString,VAR n5diff_kind_Right:EString,VAR n2name:EString,VAR n1name:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass{
					preserve name =  n1name
				}			      		
				 preserve			node n2:EClass{
					preserve name =  n2name
				}			      		
				 preserve			node n4:DiffEPackage_eclassifiers			      		
				 preserve			node n5:DiffEPackage_eclassifiers			      		
				 forbid			node n6:SemanticDiff{
					forbid name = "\"moveClass\""
				}					
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n0->n4:diffeclassifiers),
			  		(preserve	n0->n5:diffeclassifiers),
			  		(preserve	n4->n1:eType),
			  		(preserve	n5->n1:eType),
			  		(forbid		n6->n2:SemanticObject_EClass),
			  		(forbid		n6->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [(("n2name.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n4diff_kind_Left == "\"DELETE\"") AND (n5diff_kind_Left == "\"ADD\"")) OR (("n2name.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n4diff_kind_Right == "\"DELETE\"") AND (n5diff_kind_Right == "\"ADD\""))] 
		}
//----------------------------------------------------------------------

		rule moveClass3(VAR n1diff_kind_Left:EString,VAR n1diff_kind_Right:EString,VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n1name:EString,VAR n2name:EString,VAR n3name:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 delete				node n1:DiffEClass{
					delete name =  n1name
				}
				 preserve			node n2:DiffEClass{
					preserve name =  n2name
				}			      		
				 preserve			node n3:EClass{
					preserve name =  n3name
				}			      		
				 create				node n4:SemanticDiff{
					create name = "\"moveClass\""
				}
			edges[
			  		(delete		n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n0->n3:eclassifiers),
			  		(create		n4->n2:SemanticObject_EClass),
			  		(create		n4->n3:SemanticObject_EClass),
			  		(create		n4->n0:SemanticObject_EPackage)
	      		 ]
			}
			conditions [((n1name == n2name) AND ("n3name.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n1diff_kind_Left == "\"DELETE\"") AND (n2diff_kind_Left == "\"ADD\"")) OR ((n1name == n2name) AND ("n3name.trim().contains(n1name.trim().replace('return;',''))" == 'true') AND (n1diff_kind_Right == "\"DELETE\"") AND (n2diff_kind_Right == "\"ADD\""))] 
		}
