		rule extractSuperclassRef(VAR n2diff_kind_Left:EString,VAR n2diff_kind_Right:EString,VAR n6diff_kind_Left:EString,VAR n6diff_kind_Right:EString,VAR n7diff_kind_Left:EString,VAR n7diff_kind_Right:EString,VAR n8diff_kind_Left:EString,VAR n8diff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage			      		
				 preserve			node n1:EClass			      		
				 preserve			node n2:DiffEClass			      		
				 preserve			node n4:EReference			      		
				 delete				node n6:DiffEClass_ereferences
				 preserve			node n7:DiffEClass_esupertypes			      		
				 preserve			node n8:DiffEClass_ereferences			      		
				 create				node n3:SemanticDiff{
					create name = "\"extractSuperclassRef\""
				}
			edges[
			  		(preserve	n0->n1:eclassifiers),
			  		(preserve	n0->n2:eclassifiers),
			  		(preserve	n1->n4:ereferences),
			  		(preserve	n1->n2:esupertypes),
			  		(delete		n1->n6:differeferences),
			  		(preserve	n1->n7:diffesupertypes),
			  		(preserve	n2->n8:differeferences),
			  		(delete		n6->n4:eType),
			  		(preserve	n7->n2:eType),
			  		(preserve	n8->n4:eType),
			  		(create		n3->n8:SemanticObject_DiffEClass_ereferences),
			  		(create		n3->n7:SemanticObject_DiffEClass_esupertypes),
			  		(create		n3->n1:SemanticObject_EClass),
			  		(create		n3->n2:SemanticObject_EClass),
			  		(create		n3->n0:SemanticObject_EPackage),
			  		(create		n3->n4:SemanticObject_EReference)
	      		 ]
			}
			conditions [((n2diff_kind_Left == "\"ADD\"") AND (n6diff_kind_Left == "\"DELETE\"") AND (n7diff_kind_Left == "\"ADD\"") AND (n8diff_kind_Left == "\"ADD\"")) OR ((n2diff_kind_Right == "\"ADD\"") AND (n6diff_kind_Right == "\"DELETE\"") AND (n7diff_kind_Right == "\"ADD\"") AND (n8diff_kind_Right == "\"ADD\""))] 
		}
