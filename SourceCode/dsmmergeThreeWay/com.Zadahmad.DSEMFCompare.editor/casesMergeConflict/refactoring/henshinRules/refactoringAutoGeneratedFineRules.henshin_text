	 rule delete_Interface(){
		 graph{
			 preserve	node n0:EPackage
			 delete	node n1:DiffInterface
		 edges[
				 (delete	n0->n1:interfaces)
			 ]

		 }
	 }

	 rule changeInterface_extends(VAR n1extends:EString){
		 graph{
			 preserve	node n0:EPackage
			 preserve	node n1:DiffInterface
			 {
				preserve extends = "\"CONTRADICTING\""
			 }
		 edges[
				 (delete	n0->n1:interfaces)
			 ]

		 }
	 }

