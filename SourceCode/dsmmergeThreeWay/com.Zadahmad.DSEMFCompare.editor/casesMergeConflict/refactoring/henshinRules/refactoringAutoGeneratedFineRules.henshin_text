ePackageImport  refactoringDiffMM

	 rule delete_EPackage(){
		 graph{
			 delete	node n0:DiffEPackage

		 }
	 }

	 rule addEPackage_eclassifiers(){
		 graph{
			 preserve	node n0:EPackage
			 create	node n1:DiffEPackage_eclassifiers

		 }
	 }

	 rule deleteEPackage_eclassifiers(){
		 graph{
			 preserve	node n0:EPackage
			 delete	node n1:DiffEPackage_eclassifiers

		 }
	 }

