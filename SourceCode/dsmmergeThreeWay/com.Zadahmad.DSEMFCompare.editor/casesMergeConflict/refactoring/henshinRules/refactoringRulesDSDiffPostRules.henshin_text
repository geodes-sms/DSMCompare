				 preserve			node n0:EPackage
				 preserve			node n5:SemanticDiff{
					preserve	name = "\"mergeMetaClassAttr\""
					create		author		=  "(nPostchangeStatus.toString().replace('EQUIVALENT','EQUAL') + nPostdiff_kind_Right.toString().replaceAll('ADD|DELETE|MODIFY','RIGHT') +  nPostdiff_kind_Left.toString().replaceAll('ADD|DELETE|MODIFY','LEFT')).replaceAll('NON','').replaceAll('EQUALRIGHTLEFT|RIGHTLEFT','EQUAL');"
				}
			edges[
					(preserve		n5->n0:SemanticObject_EPackage)
	      		 ]
			}
		}
//----------------------------------------------------------------------

		rule mergeRefrencesPost(VAR nPostchangeStatus:EString, VAR nPostdiff_kind_Left:EString, VAR nPostdiff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage
				 preserve			node n5:SemanticDiff{
					preserve	name = "\"mergeRefrences\""
					create		author		=  "(nPostchangeStatus.toString().replace('EQUIVALENT','EQUAL') + nPostdiff_kind_Right.toString().replaceAll('ADD|DELETE|MODIFY','RIGHT') +  nPostdiff_kind_Left.toString().replaceAll('ADD|DELETE|MODIFY','LEFT')).replaceAll('NON','').replaceAll('EQUALRIGHTLEFT|RIGHTLEFT','EQUAL');"
				}
			edges[
					(preserve		n5->n0:SemanticObject_EPackage)
	      		 ]
			}
		}
//----------------------------------------------------------------------

		rule pushDownRefrencePost(VAR nPostchangeStatus:EString, VAR nPostdiff_kind_Left:EString, VAR nPostdiff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage
				 preserve			node n9:DiffEClass_ereferences{
					preserve	changeStatus 	= 	nPostchangeStatus
					preserve	diff_kind_Left 	= 	nPostdiff_kind_Left
					preserve	diff_kind_Right	= 	nPostdiff_kind_Right
				}
				 preserve			node n3:SemanticDiff{
					preserve	name = "\"pushDownRefrence\""
					create		author		=  "(nPostchangeStatus.toString().replace('EQUIVALENT','EQUAL') + nPostdiff_kind_Right.toString().replaceAll('ADD|DELETE|MODIFY','RIGHT') +  nPostdiff_kind_Left.toString().replaceAll('ADD|DELETE|MODIFY','LEFT')).replaceAll('NON','').replaceAll('EQUALRIGHTLEFT|RIGHTLEFT','EQUAL');"
				}
			edges[
					(preserve		n3->n9:SemanticObject_DiffEClass_ereferences),
					(preserve		n3->n0:SemanticObject_EPackage)
	      		 ]
			}
		}
//----------------------------------------------------------------------

		rule pullUpRefrencePost(VAR nPostchangeStatus:EString, VAR nPostdiff_kind_Left:EString, VAR nPostdiff_kind_Right:EString)
		{
			graph
			{
				 preserve			node n0:EPackage
				 preserve			node n3:SemanticDiff{
					preserve	name = "\"pullUpRefrence\""
					create		author		=  "(nPostchangeStatus.toString().replace('EQUIVALENT','EQUAL') + nPostdiff_kind_Right.toString().replaceAll('ADD|DELETE|MODIFY','RIGHT') +  nPostdiff_kind_Left.toString().replaceAll('ADD|DELETE|MODIFY','LEFT')).replaceAll('NON','').replaceAll('EQUALRIGHTLEFT|RIGHTLEFT','EQUAL');"
				}
			edges[
					(preserve		n3->n0:SemanticObject_EPackage)
	      		 ]
			}
		}
//----------------------------------------------------------------------

