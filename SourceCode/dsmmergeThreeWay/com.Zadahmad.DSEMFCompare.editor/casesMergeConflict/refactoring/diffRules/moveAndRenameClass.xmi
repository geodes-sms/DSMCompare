<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="moveAndRenameClass">
  <constraints>Item(2,&quot;new_name&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;new_name&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;name&quot;) != Item(2,&quot;new_name&quot;)</constraints>
  <rulePattern_EPackage
      xsi:type="refactoring2WayRuleMM:Pattern_EPackage"
      ID_Pattern="1">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
        diff_kind="MODIFY"
        ID_Pattern="2"/>
  </rulePattern_EPackage>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Move And Rename Class"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0"
      SemanticObject_EPackage="//@rulePattern_EPackage.0"
      ID_Pattern="4"
      isForbidden="true"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Move And Rename Class"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0"
      SemanticObject_EPackage="//@rulePattern_EPackage.0"
      ID_Pattern="5"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
