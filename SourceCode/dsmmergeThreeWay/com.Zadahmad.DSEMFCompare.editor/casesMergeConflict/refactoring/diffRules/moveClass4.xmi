<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="moveClass4">
  <constraints>Item(2,&quot;name&quot;) contains Item(1,&quot;name&quot;) </constraints>
  <rulePattern_EPackage
      xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        ID_Pattern="1"/>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        ID_Pattern="2"/>
    <diffeclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEPackage_eclassifiers"
        diff_kind="DELETE"
        eType="//@rulePattern_EPackage.0/@eclassifiers.0"
        ID_Pattern="4"
        filter="true"/>
    <diffeclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEPackage_eclassifiers"
        diff_kind="ADD"
        eType="//@rulePattern_EPackage.0/@eclassifiers.0"
        ID_Pattern="5"/>
  </rulePattern_EPackage>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="moveClass"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0 //@rulePattern_EPackage.0/@eclassifiers.1"
      SemanticObject_EPackage="//@rulePattern_EPackage.0"
      ID_Pattern="3"/>
</refactoring2WayRuleMM:Rule>
