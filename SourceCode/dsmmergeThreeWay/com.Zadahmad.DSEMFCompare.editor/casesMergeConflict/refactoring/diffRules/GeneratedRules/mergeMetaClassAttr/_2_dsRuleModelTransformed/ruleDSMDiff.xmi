<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM" name="ruleDSMDiff">
  <pattern xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_EClass" name="root" ID_Pattern="1"/>
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass" name="cls3" esupertypes="root" diff_kind="ADD" ID_Pattern="2">
      <diffeattributes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes" diff_kind="ADD" ID_Pattern="7"/>
      <diffeattributes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes" diff_kind="ADD" ID_Pattern="8"/>
      <diffesupertypes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_esupertypes" diff_kind="ADD" ID_Pattern="9"/>
    </eclassifiers>
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass" name="cls1" diff_kind="DELETE" ID_Pattern="3">
      <eattributes xsi:type="refactoring2WayRuleMM:Pattern_DiffEAttribute" name="attr1" diff_kind="DELETE" ID_Pattern="10"/>
      <diffeattributes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes" diff_kind="DELETE" ID_Pattern="11"/>
      <diffesupertypes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_esupertypes" diff_kind="DELETE" ID_Pattern="12"/>
    </eclassifiers>
    <eclassifiers xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass" name="cls2" diff_kind="DELETE" ID_Pattern="4">
      <eattributes xsi:type="refactoring2WayRuleMM:Pattern_DiffEAttribute" name="attr2" diff_kind="DELETE" ID_Pattern="13"/>
      <diffeattributes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes" diff_kind="DELETE" ID_Pattern="14"/>
      <diffesupertypes xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_esupertypes" diff_kind="DELETE" ID_Pattern="15"/>
    </eclassifiers>
    <domainspecificdiffs xsi:type="refactoring2WayRuleMM:Pattern_DomainSpecificDiff" name="ruleDSMDiff" DomainSpecificDiff_EAttribute="attr1 attr2" DomainSpecificDiff_EClass="root cls3 cls1 cls2 root" DomainSpecificDiff_EPackage="//@pattern" DomainSpecificDiff_DiffEClass_eattributes="//@pattern/@eclassifiers.1/@diffeattributes.0 //@pattern/@eclassifiers.1/@diffeattributes.1 //@pattern/@eclassifiers.2/@diffeattributes.0 //@pattern/@eclassifiers.3/@diffeattributes.0" DomainSpecificDiff_DiffEClass_esupertypes="//@pattern/@eclassifiers.1/@diffesupertypes.0 //@pattern/@eclassifiers.2/@diffesupertypes.0 //@pattern/@eclassifiers.3/@diffesupertypes.0" ID_Pattern="5"/>
  </pattern>
</refactoring2WayRuleMM:Rule>
