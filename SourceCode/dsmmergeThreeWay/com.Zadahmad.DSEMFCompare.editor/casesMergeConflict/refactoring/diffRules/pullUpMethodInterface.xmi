<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="pullUpMethodInterface">
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      name=""
      ID_Pattern="1">
    <eoperations
        xsi:type="refactoring2WayRuleMM:Pattern_EOperation"
        ID_Pattern="2"/>
    <diffeoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eoperations"
        diff_kind="DELETE"
        eType="//@rulePattern_EClass.0/@eoperations.0"
        ID_Pattern="3"
        filter="true"/>
  </rulePattern_EClass>
  <rulePattern_Interface
      xsi:type="refactoring2WayRuleMM:Pattern_Interface"
      ID_Pattern="4">
    <diffeoperations
        xsi:type="refactoring2WayRuleMM:Pattern_DiffInterface_eoperations"
        diff_kind="ADD"
        eType="//@rulePattern_EClass.0/@eoperations.0"
        ID_Pattern="5"/>
  </rulePattern_Interface>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="pullUpMethod Interface"
      SemanticObject_EOperation="//@rulePattern_EClass.0/@eoperations.0"
      SemanticObject_Interface="//@rulePattern_Interface.0"
      ID_Pattern="6"/>
</refactoring2WayRuleMM:Rule>
