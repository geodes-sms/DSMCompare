<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="extractInterface">
  <constraints>Item(1,&quot;new_implements&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(1,&quot;new_implements&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;implements&quot;) != Item(1,&quot;new_implements&quot;)</constraints>
  <rulePattern_EPackage
      xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
        diff_kind="MODIFY"
        ID_Pattern="1"/>
  </rulePattern_EPackage>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="extractInterface"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0"
      ID_Pattern="2"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="extractInterface"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0"
      ID_Pattern="3"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
