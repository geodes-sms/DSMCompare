<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="extractSuperclass3">
  <constraints>Item(2,&quot;name&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;new_extends&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;name&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(1,&quot;new_extends&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(1,&quot;new_extends&quot;) == Item(2,&quot;name&quot;)</constraints>
  <rulePattern_DiffEClass
      xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
      diff_kind="MODIFY"
      ID_Pattern="1"/>
  <rulePattern_EClass
      xsi:type="refactoring2WayRuleMM:Pattern_EClass"
      ID_Pattern="2"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Extract Superclass"
      SemanticObject_EClass="//@rulePattern_DiffEClass.0 //@rulePattern_EClass.0"
      ID_Pattern="3"/>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="Extract Superclass"
      SemanticObject_EClass="//@rulePattern_DiffEClass.0 //@rulePattern_EClass.0"
      ID_Pattern="4"
      isForbidden="true"/>
</refactoring2WayRuleMM:Rule>
