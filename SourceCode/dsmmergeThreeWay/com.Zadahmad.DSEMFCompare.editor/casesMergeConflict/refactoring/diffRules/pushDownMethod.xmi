<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="pushDownMethod">
  <rulePattern_EPackage xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="super"
        ID_Pattern="1">
      <eoperations
          xsi:type="refactoring2WayRuleMM:Pattern_EOperation"
          ID_Pattern="2"/>
      <diffeoperations
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eoperations"
          diff_kind="DELETE"
          eType="//@rulePattern_EPackage.0/@eclassifiers.0/@eoperations.0"
          ID_Pattern="3"
          filter="true"/>
    </eclassifiers>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="sub"
        esupertypes="super"
        ID_Pattern="4">
      <diffeoperations
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eoperations"
          diff_kind="ADD"
          eType="//@rulePattern_EPackage.0/@eclassifiers.0/@eoperations.0"
          ID_Pattern="5"/>
    </eclassifiers>
  </rulePattern_EPackage>
    <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
        name="push-Down Method"
        SemanticObject_EClass="super sub"
        SemanticObject_EPackage="//@rulePattern_EPackage.0"
        ID_Pattern="6"/>
</refactoring2WayRuleMM:Rule>
