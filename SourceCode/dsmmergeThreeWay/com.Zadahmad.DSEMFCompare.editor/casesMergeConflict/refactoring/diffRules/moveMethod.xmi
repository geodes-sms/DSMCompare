<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="moveMethod">
  <rulePattern_EPackage xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="cls1"
        ID_Pattern="1">
      <eoperations
          xsi:type="refactoring2WayRuleMM:Pattern_EOperation"
          name="method1"
          ID_Pattern="4"/>
      <diffeoperations
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eoperations"
          diff_kind="DELETE"
          eType="method1"
          ID_Pattern="5"
          filter="true"/>
    </eclassifiers>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="cls2"
        ID_Pattern="2">
      <diffeoperations
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eoperations"
          diff_kind="ADD"
          eType="method1"
          ID_Pattern="6"/>
    </eclassifiers>
  </rulePattern_EPackage>
    <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
        name="moveMethod"
        SemanticObject_EClass="cls1 cls2"
        SemanticObject_EOperation="method1"
        SemanticObject_EPackage="//@rulePattern_EPackage.0"
        SemanticObject_DiffEClass_eoperations="//@rulePattern_EPackage.0/@eclassifiers.1/@diffeoperations.0"
        ID_Pattern="3"/>
</refactoring2WayRuleMM:Rule>
