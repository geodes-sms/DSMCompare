<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="pushDownMethod2">
  <constraints>Item(11,&quot;name&quot;) == Item(12,&quot;name&quot;)</constraints>
  <rulePattern_EPackage xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="super"
        ID_Pattern="1">
      <eoperations
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
          diff_kind="DELETE"
          ID_Pattern="12"
          filter="true"/>
    </eclassifiers>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="sub"
        esupertypes="super"
        ID_Pattern="2">
      <eoperations
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEOperation"
          diff_kind="ADD"
          ID_Pattern="11"/>
    </eclassifiers>
  </rulePattern_EPackage>
    <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
        name="push-Down Method"
        SemanticObject_EClass="super sub"
        SemanticObject_EOperation="//@rulePattern_EPackage.0/@eclassifiers.1/@eoperations.0"
        SemanticObject_EPackage="//@rulePattern_EPackage.0"
        ID_Pattern="3"/>
</refactoring2WayRuleMM:Rule>
