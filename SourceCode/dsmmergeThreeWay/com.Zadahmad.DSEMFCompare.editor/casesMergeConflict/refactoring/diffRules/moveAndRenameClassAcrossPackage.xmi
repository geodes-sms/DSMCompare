<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="moveAndRenameClassAcrossPackage">
  <constraints>Item(2,&quot;new_name&quot;) != &quot;null&quot;</constraints>
  <constraints>Item(2,&quot;new_name&quot;) != &quot;\&quot;\&quot;&quot;</constraints>
  <constraints>Item(2,&quot;name&quot;) != Item(2,&quot;new_name&quot;)</constraints>
  <rulePattern_EPackage
      xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
        diff_kind="MODIFY"
        ID_Pattern="2"/>
    <diffeclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEPackage_eclassifiers"
        diff_kind="DELETE"
        eType="//@rulePattern_EPackage.0/@eclassifiers.0"
        ID_Pattern="3"
        filter="true"/>
  </rulePattern_EPackage>
  <rulePattern_EPackage
      xsi:type="refactoring2WayRuleMM:Pattern_EPackage"
      ID_Pattern="4">
    <diffeclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEPackage_eclassifiers"
        diff_kind="ADD"
        eType="//@rulePattern_EPackage.0/@eclassifiers.0"
        ID_Pattern="5"/>
  </rulePattern_EPackage>
  <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
      name="move And Rename Class Across Package"
      SemanticObject_DiffEPackage_eclassifiers="//@rulePattern_EPackage.1/@diffeclassifiers.0"
      SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.0"
      SemanticObject_EPackage="//@rulePattern_EPackage.0 //@rulePattern_EPackage.1"
      ID_Pattern="6"/>
</refactoring2WayRuleMM:Rule>
