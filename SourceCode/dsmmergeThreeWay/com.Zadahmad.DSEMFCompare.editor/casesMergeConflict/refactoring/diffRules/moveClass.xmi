<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="moveClass">
  <constraints>Item(1,&quot;name&quot;) == Item(2,&quot;name&quot;)</constraints>
  <rulePattern_EPackage xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
        diff_kind="DELETE"
        ID_Pattern="1"
        filter="true"/>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
        diff_kind="ADD"
        ID_Pattern="2"/>
  </rulePattern_EPackage>
    <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
        name="moveClass"
        SemanticObject_EClass="//@rulePattern_EPackage.0/@eclassifiers.1"
        SemanticObject_EPackage="//@rulePattern_EPackage.0"
        ID_Pattern="3"/>
</refactoring2WayRuleMM:Rule>
