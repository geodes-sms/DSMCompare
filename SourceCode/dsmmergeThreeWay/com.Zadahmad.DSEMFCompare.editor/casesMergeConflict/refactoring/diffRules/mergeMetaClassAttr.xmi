<?xml version="1.0" encoding="ASCII"?>
<refactoring2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:refactoring2WayRuleMM="www.geodes.UdeM.edu/refactoring2WayRuleMM"
    name="mergeMetaClassAttr">
  <rulePattern_EPackage xsi:type="refactoring2WayRuleMM:Pattern_EPackage">
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_EClass"
        name="root"
        ID_Pattern="1"/>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
        name="cls3"
        esupertypes="root"
        diff_kind="ADD"
        ID_Pattern="2">
      <diffeattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
          diff_kind="ADD"
          eType="attr1"
          ID_Pattern="7"/>
      <diffeattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
          diff_kind="ADD"
          eType="attr2"
          ID_Pattern="8"/>
      <diffesupertypes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_esupertypes"
          diff_kind="ADD"
          eType="root"
          ID_Pattern="9"/>
    </eclassifiers>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
        name="cls1"
        diff_kind="DELETE"
        ID_Pattern="3">
      <eattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEAttribute"
          name="attr1"
          diff_kind="DELETE"
          ID_Pattern="10"/>
      <diffeattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
          diff_kind="DELETE"
          eType="attr1"
          ID_Pattern="11"
          filter="true"/>
      <diffesupertypes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_esupertypes"
          diff_kind="DELETE"
          eType="root"
          ID_Pattern="12"
          filter="true"/>
    </eclassifiers>
    <eclassifiers
        xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass"
        name="cls2"
        diff_kind="DELETE"
        ID_Pattern="4">
      <eattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEAttribute"
          name="attr2"
          diff_kind="DELETE"
          ID_Pattern="13"/>
      <diffeattributes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_eattributes"
          diff_kind="DELETE"
          eType="attr2"
          ID_Pattern="14"
          filter="true"/>
      <diffesupertypes
          xsi:type="refactoring2WayRuleMM:Pattern_DiffEClass_esupertypes"
          diff_kind="DELETE"
          eType="root"
          ID_Pattern="15"
          filter="true"/>
    </eclassifiers>
  </rulePattern_EPackage>
  
     <rulePattern_SemanticObject
      xsi:type="refactoring2WayRuleMM:Pattern_SemanticDiff"
        name="mergeMetaClassAttr"
        SemanticObject_EAttribute="attr1 attr2"
        SemanticObject_EClass="root cls3 cls1 cls2"
        SemanticObject_EPackage="//@rulePattern_EPackage.0"
        SemanticObject_DiffEClass_eattributes="//@rulePattern_EPackage.0/@eclassifiers.1/@diffeattributes.0 //@rulePattern_EPackage.0/@eclassifiers.1/@diffeattributes.1"
        SemanticObject_DiffEClass_esupertypes="//@rulePattern_EPackage.0/@eclassifiers.1/@diffesupertypes.0"
        ID_Pattern="5"/>
</refactoring2WayRuleMM:Rule>
