<?xml version="1.0" encoding="UTF-8"?>
<pacman2WayRuleMM:Rule
    xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:pacman2WayRuleMM="http://www.zadahmad.org/dsmcompare/pacman2WayRuleMM"
    xsi:schemaLocation="http://www.zadahmad.org/dsmcompare/pacman2WayRuleMM ../MM/pacman2WayRuleMM.ecore#/1"
    name="PacmanDie">
  <pattern xsi:type="pacman2WayRuleMM:Pattern_Game">
    <gridnodes
        xsi:type="pacman2WayRuleMM:Pattern_GridNode"
        id="O"
        ID_Pattern="1"/>
    <entities
        xsi:type="pacman2WayRuleMM:Pattern_Ghost"
        on="O"
        id="G"
        ID_Pattern="2"/>
    <entities
        xsi:type="pacman2WayRuleMM:Pattern_DiffPacman"
        id="P"
        diff_kind="DELETE"
        ID_Pattern="3">
      <diffon
          xsi:type="pacman2WayRuleMM:Pattern_DiffPositionableEntity_on"
          diff_kind="DELETE"
          eType="O"
          ID_Pattern="31"/>
    </entities>
    <domainspecificdiffs
        xsi:type="pacman2WayRuleMM:Pattern_DomainSpecificDiff"
        name="PacmanDie"
        DomainSpecificDiff_PositionableEntity="G"
        ID_Pattern="4"/>
  </pattern>
</pacman2WayRuleMM:Rule>
